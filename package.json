{
  "name": "@pyre/monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "type-check": "turbo run type-check",
    "dev:booking": "turbo run dev --filter=@pyre/booking-system",
    "dev:landing": "turbo run dev --filter=@pyre/landing-page",
    "dev:supabase": "turbo run start --filter=@pyre/supabase",
    "dev:dashboard": "turbo run dev --filter=@pyre/data-dashboard",
    "build:booking": "turbo run build --filter=@pyre/booking-system",
    "build:landing": "turbo run build --filter=@pyre/landing-page",
    "build:dashboard": "turbo run build --filter=@pyre/data-dashboard",
    "lint:booking": "turbo run lint --filter=@pyre/booking-system",
    "lint:landing": "turbo run lint --filter=@pyre/landing-page",
    "lint:dashboard": "turbo run lint --filter=@pyre/data-dashboard",
    "format:booking": "turbo run format --filter=@pyre/booking-system",
    "format:landing": "turbo run format --filter=@pyre/landing-page",
    "check:booking": "turbo run check --filter=@pyre/booking-system",
    "check:landing": "turbo run check --filter=@pyre/landing-page",
    "type-check:booking": "turbo run type-check --filter=@pyre/booking-system",
    "type-check:landing": "turbo run type-check --filter=@pyre/landing-page",
    "type-check:dashboard": "turbo run type-check --filter=@pyre/data-dashboard"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "resolutions": {
    "@vercel/routing-utils": "5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "license": "Apache-2.0"
}
