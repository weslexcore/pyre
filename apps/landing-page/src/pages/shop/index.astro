---
export const prerender = true;

import ProductCard from '@/components/shop/ProductCard.astro';
import MainLayout from '@/layouts/main.astro';
import shop from '@/lib/shop';
import ogImg from '@/assets/images/merch/pyre-og-sticker/DSCF4143.webp';

const title = `${shop.title} - Pyre`;
const description = shop.subtitle || 'Browse Pyre merchandise and essentials.';

const products = shop.products;
const categories = [...new Set(products.map((p) => p.category))].sort();
---

<MainLayout title={title} description={description} transparentNav={true} ogImage={ogImg.src} ogImageWidth={ogImg.width} ogImageHeight={ogImg.height}>
  <div class="min-h-screen bg-[var(--pyre-black)] pb-16 pt-24 md:pt-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="mb-12">
        <h1 class="font-primary-semibold text-[clamp(2rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-4 text-[var(--pyre-creme)]">
          {shop.title}
        </h1>
        {shop.subtitle && (
          <p class="font-sans text-xl leading-relaxed text-[var(--pyre-creme)]/70">
            {shop.subtitle}
          </p>
        )}
      </header>

      {/* Category filters */}
      {categories.length > 1 && (
        <nav aria-label="Filter by product type" class="mb-8 flex flex-wrap gap-2" data-shop-filters>
          <button
            type="button"
            data-filter="all"
            class="rounded-full border border-[var(--pyre-creme)]/20 bg-[var(--pyre-creme)] px-4 py-1.5 font-mono text-xs font-bold uppercase tracking-wide text-[var(--pyre-black)] transition-colors"
          >
            All
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              data-filter={cat}
              class="rounded-full border border-[var(--pyre-creme)]/20 px-4 py-1.5 font-mono text-xs font-bold uppercase tracking-wide text-[var(--pyre-creme)]/70 transition-colors hover:border-[var(--pyre-creme)]/40 hover:text-[var(--pyre-creme)]"
            >
              {cat}
            </button>
          ))}
        </nav>
      )}

      {products.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-shop-grid>
          {products.map((product) => (
            <div data-category={product.category} data-grid-item>
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      ) : (
        <div class="flex flex-col items-center justify-center py-24 text-center">
          <p class="font-mono text-sm uppercase tracking-wide text-[var(--pyre-creme)]/40">
            {shop.emptyMessage}
          </p>
        </div>
      )}
    </div>
  </div>
</MainLayout>

<script>
  const ACTIVE = 'bg-[var(--pyre-creme)] text-[var(--pyre-black)] border-[var(--pyre-creme)]';
  const INACTIVE = 'border-[var(--pyre-creme)]/20 text-[var(--pyre-creme)]/70';

  function initFilters() {
    const filterNav = document.querySelector<HTMLElement>('[data-shop-filters]');
    const grid = document.querySelector<HTMLElement>('[data-shop-grid]');
    if (!filterNav || !grid) return;

    const buttons = filterNav.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = grid.querySelectorAll<HTMLElement>('[data-category]');

    function setFilter(category: string) {
      buttons.forEach((btn) => {
        const isActive = btn.dataset.filter === category;
        ACTIVE.split(' ').forEach((c) => btn.classList.toggle(c, isActive));
        INACTIVE.split(' ').forEach((c) => btn.classList.toggle(c, !isActive));
      });

      items.forEach((item) => {
        const match = category === 'all' || item.dataset.category === category;
        item.style.display = match ? '' : 'none';
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => setFilter(btn.dataset.filter!));
    });
  }

  interface StockVariant {
    name: string;
    price?: number;
    soldOut: boolean;
  }

  interface StockEntry {
    price: number;
    purchaseUrl: string;
    soldOut: boolean;
    variants: StockVariant[];
  }

  type StockMap = Record<string, StockEntry>;

  function applySoldOutState(card: HTMLElement) {
    card.removeAttribute('href');
    card.setAttribute('aria-disabled', 'true');
    card.setAttribute(
      'aria-label',
      card.getAttribute('aria-label')?.replace(/^Buy /, '') + ' — sold out'
    );
    card.classList.remove(
      'hover:bg-[var(--pyre-creme)]/8',
      'focus-visible:outline-none',
      'focus-visible:ring-2',
      'focus-visible:ring-[var(--pyre-red)]',
      'focus-visible:ring-offset-2',
      'focus-visible:ring-offset-[var(--pyre-black)]'
    );
    card.classList.add('cursor-default');
    card.querySelectorAll<HTMLImageElement>('[data-product-img]').forEach((img) => {
      img.classList.add('opacity-50', 'grayscale');
    });

    const badge = card.querySelector<HTMLElement>('[data-product-badge]');
    if (badge) {
      badge.classList.remove('bg-[var(--pyre-red)]', 'text-[var(--pyre-creme)]');
      badge.classList.add('bg-[var(--pyre-creme)]/20', 'text-[var(--pyre-creme)]/50');
    }

    const cta = card.querySelector<HTMLElement>('[data-product-cta]');
    if (cta) {
      cta.innerHTML =
        '<span class="inline-block w-full rounded-full border border-[var(--pyre-creme)]/20 px-4 py-2.5 text-center font-mono text-xs font-bold uppercase tracking-wide text-[var(--pyre-creme)]/30">Sold Out</span>';
    }
  }

  function renderVariants(container: HTMLElement, variants: StockVariant[]) {
    container.innerHTML = variants
      .map((v) => {
        const classes = v.soldOut
          ? 'border-[var(--pyre-creme)]/10 text-[var(--pyre-creme)]/25 line-through'
          : 'border-[var(--pyre-creme)]/20 text-[var(--pyre-creme)]/70';
        return `<span class="rounded-full border px-2.5 py-0.5 font-mono text-[0.65rem] font-bold uppercase tracking-wide transition-colors ${classes}">${v.name}</span>`;
      })
      .join('');
  }

  function reorderGrid() {
    const grid = document.querySelector<HTMLElement>('[data-shop-grid]');
    if (!grid) return;

    const items = [...grid.querySelectorAll<HTMLElement>('[data-grid-item]')];
    items.sort((a, b) => {
      const aOut = a.querySelector('[aria-disabled="true"]') ? 1 : 0;
      const bOut = b.querySelector('[aria-disabled="true"]') ? 1 : 0;
      return aOut - bOut;
    });

    for (const item of items) grid.appendChild(item);
  }

  async function hydrateStock() {
    const base = import.meta.env.BASE_URL ?? '/';
    let data: StockMap;
    try {
      const res = await fetch(`${base}api/shop-stock`.replace(/\/\//g, '/'));
      if (!res.ok) return;
      data = await res.json();
    } catch {
      return;
    }

    const cards = document.querySelectorAll<HTMLElement>('[data-momence-id]');
    let anySoldOut = false;

    cards.forEach((card) => {
      const momenceId = card.dataset.momenceId;
      if (!momenceId || !data[momenceId]) return;

      const stock = data[momenceId];

      const priceEl = card.querySelector<HTMLElement>('[data-product-price]');
      if (priceEl) priceEl.textContent = `$${stock.price}`;

      if (stock.purchaseUrl) {
        card.setAttribute('href', stock.purchaseUrl);
      }

      if (stock.variants.length > 0) {
        const variantsEl = card.querySelector<HTMLElement>('[data-product-variants]');
        if (variantsEl) renderVariants(variantsEl, stock.variants);
      }

      if (stock.soldOut) {
        anySoldOut = true;
        applySoldOutState(card);
      }
    });

    if (anySoldOut) reorderGrid();
  }

  function init() {
    initFilters();
    hydrateStock();
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
