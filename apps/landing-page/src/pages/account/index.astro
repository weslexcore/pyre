---
import { AccountDashboard } from '@/components/account/AccountDashboard';
import TiledHeader from '@/components/TiledHeader.astro';
import MainLayout from '@/layouts/main.astro';
import { accountConfig } from '@/lib/account-config';

export const prerender = true;
---

<MainLayout
  title={accountConfig.page.title}
  description={accountConfig.page.description}
  transparentNav={true}
>
  <div class="min-h-screen bg-[var(--pyre-black)]">
    <TiledHeader />

    <div class="pb-16">
      <AccountDashboard client:load />
    </div>
  </div>
</MainLayout>
