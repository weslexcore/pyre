---
import MainLayout from '@/layouts/main.astro';
import { AccountDashboard } from '@/components/account/AccountDashboard';
import { accountConfig } from '@/lib/account-config';

// Get error from query params (set during OAuth callback failures)
const error = Astro.url.searchParams.get('error');
// Check if this is a fresh auth redirect (signals to skip session cache)
const freshAuth = Astro.url.searchParams.get('auth') === 'success';
---

<MainLayout
  title={accountConfig.page.title}
  description={accountConfig.page.description}
  transparentNav={true}
>
  <div class="pt-24 pb-16 min-h-screen bg-[var(--pyre-black)]">
    <AccountDashboard client:load error={error} freshAuth={freshAuth} />
  </div>
</MainLayout>
