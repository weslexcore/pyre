---
// Single event page — the shareable URL for one session on one day.
//
// This route exists because link previews are read by crawlers that never run
// JavaScript: /events is prerendered and its og:image is baked in at build time,
// so every shared session used to preview with the same generic card. Rendering
// the session server-side per request puts its own image, title and description
// in <head>, and gives the link somewhere to land that looks like the thing that
// was shared.
//
// Momence models every start time — and every purchasable length within a start
// — as its own session. An evening that sells 6pm (1/2/3hr), 7pm (1/2hr) and
// 8pm (1hr) therefore arrives as six rows that all belong on one page, so the
// page gathers the whole day and redirects the siblings to the earliest one.
//
// Momence's Events API only returns upcoming sessions, so any id it doesn't know
// — past, cancelled, unpublished, or mistyped — falls through to the "already
// happened" placeholder, which sends the visitor back to /events.

export const prerender = false;

import ogFallback from '@/assets/images/warm_sauna.webp';
import PractitionerByline from '@/components/events/PractitionerByline';
import RepeatingLogoBackground from '@/components/RepeatingLogoBackground.astro';
import GradientOverlay from '@/components/GradientOverlay.astro';
import MainLayout from '@/layouts/main.astro';
import { buildPooledBookingModel } from '@/lib/booking-model';
import { creditsForPriceUsd } from '@/lib/credits';
import { eventPath, parseEventId } from '@/lib/event-url';
import {
  excludeVolunteerEvents,
  fetchMomenceEvents,
  fetchMomenceTeachers,
  filterValidEvents,
  formatStartTime,
  indexTeachersById,
  sortEventsByDate,
  transformToEventItem,
} from '@/lib/momence';
import { hasBio, specialEventPractitioners } from '@/lib/practitioners';
import { durationRowLabel, spotsColor, spotsLabel } from '@/lib/spots';
import type { EventItem, PooledBookingOption } from '@/lib/types';

const REDIRECT_DELAY_MS = 4000;
const EVENTS_PATH = '/events';

// One bookable line: [Duration] [Credits] [slots left] [Book Now].
interface BookingRow {
  minutes: number;
  fallbackLabel?: string;
  credits: number | null;
  spotsLeft: number | undefined;
  href: string | null;
  label: string;
  ariaLabel: string;
  placement: string;
}

// One start time and everything you can buy at it.
interface Slot {
  startTime: string;
  rows: BookingRow[];
}

// Pooled sessions carry gated duration choices; everything else is a single
// Book Now. Both render as the same row shape.
function bookingRowsFor(event: EventItem, options: PooledBookingOption[]): BookingRow[] {
  if (options.length > 0) {
    return options.map((option) => ({
      minutes: option.minutes,
      fallbackLabel: option.label,
      credits: option.credits,
      spotsLeft: option.spotsLeft,
      href: option.soldOut ? null : option.href,
      label: option.soldOut ? 'Sold Out' : 'Book Now',
      ariaLabel: `${option.label} — ${event.title}`,
      placement: `event_page_${option.minutes}min`,
    }));
  }

  if (event.isPrivate || !event.cta) return [];

  return [
    {
      minutes: event.durationMinutes ?? 0,
      credits: creditsForPriceUsd(event.priceUsd),
      spotsLeft: event.spotsRemaining,
      href: event.cta.href,
      label: event.spotsRemaining === 0 ? 'Join Waitlist' : (event.cta.label ?? 'Book Now'),
      ariaLabel: event.cta.ariaLabel ?? `Book ${event.title}`,
      placement: 'event_page',
    },
  ];
}

const eventId = parseEventId(Astro.params.id);

let event: EventItem | null = null;
let slots: Slot[] = [];
let groupEvents: EventItem[] = [];

if (eventId) {
  // Same pipeline as /api/events — the site's one definition of "a session we
  // show". Practitioners are best-effort and resolve to an empty roster.
  const [rawEvents, teachers] = await Promise.all([fetchMomenceEvents(), fetchMomenceTeachers()]);
  const teachersById = indexTeachersById(teachers);
  const events = sortEventsByDate(excludeVolunteerEvents(filterValidEvents(rawEvents))).map((raw) =>
    transformToEventItem(raw, teachersById)
  );

  const requested = events.find((candidate) => candidate.id === eventId) ?? null;

  if (requested) {
    // The pooled model is derived across the whole calendar, so it has to be
    // built from the full list rather than one event.
    const { optionsById, hiddenIds } = buildPooledBookingModel(events);

    // Every session sharing this title, place and day. `date` is already the
    // formatted local day, so this groups by calendar date in Pyre's timezone
    // rather than by UTC.
    groupEvents = events.filter(
      (candidate) =>
        candidate.title === requested.title &&
        candidate.location === requested.location &&
        candidate.date === requested.date
    );

    // Longer sessions folded into an entry slot's duration options aren't their
    // own start time. If the whole group is hidden (a standalone long session
    // linked directly), fall back to the one that was asked for.
    const visible = groupEvents.filter((candidate) => !hiddenIds.has(candidate.id));
    const slotEvents = visible.length > 0 ? visible : [requested];

    // Already date-sorted by the pipeline; the earliest becomes the canonical URL.
    event = slotEvents[0];
    slots = slotEvents.map((slotEvent) => ({
      startTime: slotEvent.isoDate ? formatStartTime(slotEvent.isoDate) : slotEvent.time,
      rows: bookingRowsFor(slotEvent, optionsById.get(slotEvent.id) ?? []),
    }));
  }
}

// Every sibling renders the same page, so they all resolve to one URL — which
// also keeps the layout's pathname-derived canonical honest. Any utm_* params
// ride along.
if (event) {
  const canonical = eventPath(event);
  if (Astro.url.pathname !== canonical) {
    return Astro.redirect(`${canonical}${Astro.url.search}`, 302);
  }
}

// A link blasted into a group chat should cost one origin hit.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// -- Metadata ----------------------------------------------------------------

const MAX_META_DESCRIPTION = 155;

function metaDescription(item: EventItem): string {
  const raw = item.description.replace(/\s+/g, ' ').trim();
  if (!raw) return `${item.title} at Pyre in Richmond, VA — ${item.date}, ${item.time}.`;
  if (raw.length <= MAX_META_DESCRIPTION) return raw;
  return `${raw.slice(0, MAX_META_DESCRIPTION).replace(/\s+\S*$/, '')}…`;
}

const title = event ? `${event.title} — Pyre` : 'Event has ended — Pyre';
const description = event
  ? metaDescription(event)
  : 'This session has already happened. Browse upcoming sauna and cold plunge sessions at Pyre in Richmond, VA.';

// Momence banners are remote URLs of unknown size, so they ship without
// og:image:width/height; the local fallback knows its own dimensions.
const remoteImage = event?.image?.src;
const ogImage = remoteImage ?? ogFallback.src;
const ogDimensions = remoteImage
  ? {}
  : { ogImageWidth: ogFallback.width, ogImageHeight: ogFallback.height };

// -- View model --------------------------------------------------------------

const practitioners = event ? specialEventPractitioners(event) : [];
const bios = practitioners.filter(hasBio);
const bookableSlots = slots.filter((slot) => slot.rows.length > 0);
// Several start times each need their own heading; a single one is already
// named by the time chip above.
const showSlotHeadings = bookableSlots.length > 1;
// Nothing is bookable (a private event), so surface the raw spots count instead.
const spots =
  event && bookableSlots.length === 0 ? spotsLabel(event.spotsRemaining, event.totalSpots) : null;

// schema.org/Event — the day's span, from the first start to the last finish.
function eventEnd(item: EventItem): number | null {
  if (!item.isoDate) return null;
  return new Date(item.isoDate).getTime() + (item.durationMinutes ?? 0) * 60_000;
}

const groupEnd = groupEvents.length
  ? Math.max(...groupEvents.map((item) => eventEnd(item) ?? 0))
  : null;
const groupPrices = groupEvents
  .map((item) => item.priceUsd)
  .filter((price): price is number => typeof price === 'number' && price > 0);

const eventSchema =
  event && event.isoDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: event.title,
        description: event.description || description,
        startDate: event.isoDate,
        ...(groupEnd ? { endDate: new Date(groupEnd).toISOString() } : {}),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        ...(event.image ? { image: event.image.src } : {}),
        location: {
          '@type': 'Place',
          name: event.location,
          address: {
            '@type': 'PostalAddress',
            streetAddress: '1000 Westover Hills Blvd',
            addressLocality: 'Richmond',
            addressRegion: 'VA',
            addressCountry: 'US',
          },
        },
        organizer: {
          '@type': 'Organization',
          name: 'Pyre Sauna + Cold Plunge',
          url: 'https://pyresauna.com',
        },
        // An evening sold by the hour has a price range, not a price.
        ...(groupPrices.length > 0
          ? {
              offers:
                Math.min(...groupPrices) === Math.max(...groupPrices)
                  ? {
                      '@type': 'Offer',
                      price: String(groupPrices[0]),
                      priceCurrency: 'USD',
                      availability:
                        bookableSlots.length > 0
                          ? 'https://schema.org/InStock'
                          : 'https://schema.org/SoldOut',
                    }
                  : {
                      '@type': 'AggregateOffer',
                      lowPrice: String(Math.min(...groupPrices)),
                      highPrice: String(Math.max(...groupPrices)),
                      priceCurrency: 'USD',
                      offerCount: groupPrices.length,
                    },
            }
          : {}),
      }
    : null;

const siteOrigin = Astro.site?.toString() ?? 'https://pyresauna.com';
const breadcrumbSchema = event
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL('/', siteOrigin).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Events',
          item: new URL(EVENTS_PATH, siteOrigin).toString(),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: event.title,
          item: new URL(eventPath(event), siteOrigin).toString(),
        },
      ],
    }
  : null;

// Payload for the booking-click event, so the page feeds the same funnel as the
// schedule rows and the detail modal (see lib/analytics.ts).
const analyticsEvent = event
  ? {
      session_title: event.title,
      location: event.location,
      iso_date: event.isoDate,
      tags: event.tags,
      spots_remaining: event.spotsRemaining,
      fallback_id: event.id,
    }
  : null;
---

<MainLayout
  title={title}
  description={description}
  transparentNav={!!event?.image}
  ogImage={ogImage}
  noIndex={!event}
  {...ogDimensions}
>
  {/* JSON-LD is valid in the body, which keeps MainLayout free of a head slot. */}
  {eventSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}
  {breadcrumbSchema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <div class="relative min-h-screen overflow-hidden bg-[var(--pyre-black)] pb-24">
    {/* The site's animated brand wash, same as the blog index. */}
    <GradientOverlay variant="hero-mobile" />

    {/* Colour bloom behind the content — anchored to the page rather than the
        viewport, so it drifts past as you scroll instead of sitting flat. */}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -left-40 -top-24 h-[32rem] w-[32rem] rounded-full bg-[var(--pyre-red)]/25 blur-[130px]"></div>
      <div class="absolute -right-52 top-1/3 h-[38rem] w-[38rem] rounded-full bg-[var(--pyre-gold)]/20 blur-[150px]"></div>
      <div class="absolute bottom-8 left-1/4 h-[30rem] w-[30rem] rounded-full bg-[var(--pyre-sky)]/15 blur-[140px]"></div>
    </div>

    {event ? (
      <article class="relative z-10">
        {/* The banner sits whole inside a fixed-height band — capped in both
            directions and centred, so a tall portrait and a wide flyer are each
            shown complete rather than cropped to fit. The site's repeating logo
            fills whatever space the image doesn't, which is also why the band
            needs no fade: nothing is cut off, so there's no edge to hide. */}
        {event.image ? (
          <div class="relative flex h-[58vh] max-h-[640px] min-h-[340px] w-full items-center justify-center overflow-hidden px-4 pb-8 pt-24 md:pt-28">
            {/* Faded at the bottom so the band has no hard line for the drifting
                gradient to catch. Safe to fade here because it's decoration —
                unlike the image, nothing is lost. */}
            <RepeatingLogoBackground tileSizePx={96} class="absolute inset-0 mask-b-from-65% mask-b-to-100%" />
            <img
              src={event.image.src}
              alt={event.image.alt ?? event.title}
              class="relative max-h-full w-auto max-w-3xl object-contain"
              fetchpriority="high"
            />
          </div>
        ) : (
          <div class="h-24 md:h-32"></div>
        )}

        <div
          class:list={[
            'mx-auto max-w-3xl px-4 sm:px-6 lg:px-8',
            event.image ? 'relative pt-10' : 'pt-8',
          ]}
        >
          <a
            href={EVENTS_PATH}
            class="inline-flex items-center gap-2 rounded-full font-mono text-xs uppercase tracking-widest text-[var(--pyre-creme)]/60 transition-colors hover:text-[var(--pyre-creme)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-gold)]/50"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            All Upcoming Sessions
          </a>

          <h1 class="mt-5 font-primary-semibold text-[clamp(2.25rem,6vw,4.25rem)] uppercase leading-[0.95] tracking-[-0.03em] text-[var(--pyre-creme)]">
            {event.title}
          </h1>

          {/* Facts as chips rather than a stack of small icon rows. Time is only
              a chip when there's a single start — several starts are named by
              their own headings below. */}
          <div class="mt-7 flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-2 rounded-full border border-[var(--pyre-creme)]/15 bg-[var(--pyre-creme)]/5 px-4 py-2 font-mono text-xs uppercase tracking-widest text-[var(--pyre-creme)]/80 backdrop-blur-sm">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {event.date}
            </span>
            {!showSlotHeadings && (
              <span class="inline-flex items-center gap-2 rounded-full border border-[var(--pyre-creme)]/15 bg-[var(--pyre-creme)]/5 px-4 py-2 font-mono text-xs uppercase tracking-widest text-[var(--pyre-creme)]/80 backdrop-blur-sm">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {event.time}
              </span>
            )}
            <span class="inline-flex items-center gap-2 rounded-full border border-[var(--pyre-creme)]/15 bg-[var(--pyre-creme)]/5 px-4 py-2 font-mono text-xs uppercase tracking-widest text-[var(--pyre-creme)]/80 backdrop-blur-sm">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {event.location}
            </span>
            {spots && (
              <span
                class={`inline-flex items-center gap-2 rounded-full border border-[var(--pyre-creme)]/15 bg-[var(--pyre-creme)]/5 px-4 py-2 font-mono text-xs uppercase tracking-widest backdrop-blur-sm ${spotsColor(event.spotsRemaining)}`}
              >
                {spots}
              </span>
            )}
          </div>

          {practitioners.length > 0 && (
            <div class="mt-8 border-t border-[var(--pyre-creme)]/10 pt-6">
              <PractitionerByline practitioners={practitioners} variant="modal" />
              {bios.map((practitioner) => (
                <details class="mt-3">
                  <summary class="cursor-pointer list-none font-mono text-[11px] uppercase tracking-widest text-[var(--pyre-muted-gold)] transition-colors hover:text-[var(--pyre-creme)]">
                    About {practitioner.name}
                  </summary>
                  <div class="mt-3 space-y-3">
                    {practitioner.bio?.map((paragraph) => (
                      <p class="font-sans text-sm leading-relaxed text-[var(--pyre-creme)]/70">
                        {paragraph}
                      </p>
                    ))}
                    {practitioner.links && practitioner.links.length > 0 && (
                      <div class="flex flex-wrap gap-x-4 gap-y-1">
                        {practitioner.links.map((link) => (
                          <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-mono text-[11px] uppercase tracking-widest text-[var(--pyre-muted-gold)] transition-colors hover:text-[var(--pyre-creme)]"
                          >
                            {link.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </details>
              ))}
            </div>
          )}

          {event.description && (
            <p class="mt-8 whitespace-pre-line font-sans text-lg leading-relaxed text-[var(--pyre-creme)]/80">
              {event.description}
            </p>
          )}

          {bookableSlots.length > 0 && (
            <div class="relative mt-12 overflow-hidden rounded-2xl border border-[var(--pyre-creme)]/12 bg-[var(--pyre-black)]/70 px-5 py-4 backdrop-blur-md sm:px-6">
              {/* Lit top edge — the page's one piece of pure decoration. */}
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--pyre-gold)] to-transparent"
              >
              </div>
              <div
                aria-hidden="true"
                class="pointer-events-none absolute -top-10 left-1/2 h-20 w-2/3 -translate-x-1/2 bg-gradient-to-r from-[var(--pyre-sage)] via-[var(--pyre-gold)] to-[var(--pyre-red)] opacity-40 blur-3xl"
              >
              </div>

              {showSlotHeadings && (
                <p class="relative font-mono text-[11px] uppercase tracking-widest text-[var(--pyre-creme)]/40">
                  Choose a start time
                </p>
              )}

              {bookableSlots.map((slot) => (
                <section class="relative">
                  {showSlotHeadings && (
                    <h2 class="mt-5 mb-1 flex items-baseline gap-3 font-mono-bold text-base uppercase tracking-widest text-[var(--pyre-gold)]">
                      {slot.startTime}
                      <span class="h-px flex-1 bg-[var(--pyre-gold)]/20"></span>
                    </h2>
                  )}
                  {slot.rows.map((row) => (
                    <div class="grid grid-cols-[auto_auto_auto_1fr] items-center gap-3 border-t border-[var(--pyre-creme)]/10 py-3.5 first:border-t-0">
                      <span class="whitespace-nowrap font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)]">
                        {durationRowLabel(row.minutes, row.fallbackLabel)}
                      </span>
                      <span class="whitespace-nowrap font-mono-bold text-xs uppercase tracking-wide">
                        {row.credits !== null && (
                          <span class="text-[var(--pyre-muted-gold)]">
                            {row.credits} Credit{row.credits > 1 ? 's' : ''}
                          </span>
                        )}
                      </span>
                      <span class={`whitespace-nowrap text-[11px] ${spotsColor(row.spotsLeft)}`}>
                        {row.spotsLeft !== undefined ? `${row.spotsLeft} left` : ''}
                      </span>
                      {row.href ? (
                        <a
                          href={row.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={row.ariaLabel}
                          data-booking-link
                          data-placement={row.placement}
                          class="flex items-center justify-center gap-1 justify-self-end whitespace-nowrap rounded-full bg-[var(--pyre-red)] px-5 py-2.5 font-mono-bold text-xs uppercase tracking-wide text-[var(--pyre-creme)] transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-red)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--pyre-black)] sm:text-sm"
                        >
                          {row.label}
                          <span class="hidden items-center sm:inline-flex">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                          </span>
                        </a>
                      ) : (
                        <span
                          aria-disabled="true"
                          title="Not available"
                          class="flex cursor-not-allowed items-center justify-center justify-self-end whitespace-nowrap rounded-full border border-[var(--pyre-creme)]/15 px-5 py-2.5 font-mono-bold text-xs uppercase tracking-wide text-[var(--pyre-creme)]/35 sm:text-sm"
                        >
                          {row.label}
                        </span>
                      )}
                    </div>
                  ))}
                </section>
              ))}
            </div>
          )}

          <a
            href={EVENTS_PATH}
            class="mt-8 flex items-center justify-center rounded-full border border-[var(--pyre-creme)]/20 px-6 py-4 font-mono-bold text-sm uppercase tracking-widest text-[var(--pyre-creme)] transition-colors hover:border-[var(--pyre-gold)] hover:text-[var(--pyre-gold)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-gold)]/50"
          >
            All Upcoming Sessions
          </a>
        </div>
      </article>
    ) : (
      <div class="relative z-10 mx-auto max-w-xl px-4 pt-32 text-center sm:px-6 md:pt-40">
        <h1 class="font-primary-semibold text-[clamp(2rem,5vw,3.5rem)] uppercase leading-[0.95] tracking-[-0.03em] text-[var(--pyre-creme)]">
          This event has already happened
        </h1>
        <p class="mt-6 font-sans text-lg leading-relaxed text-[var(--pyre-creme)]/70">
          There are new sessions on the calendar — sauna, cold plunge, and guided
          rounds most days of the week.
        </p>
        <a
          href={EVENTS_PATH}
          class="mt-10 inline-flex items-center justify-center rounded-full bg-[var(--pyre-red)] px-8 py-4 font-mono-bold text-sm uppercase tracking-widest text-[var(--pyre-creme)] transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-red)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--pyre-black)]"
        >
          See Upcoming Sessions
        </a>
        <p class="mt-8 font-mono text-xs uppercase tracking-widest text-[var(--pyre-creme)]/40">
          Taking you there in a moment…
        </p>
      </div>
    )}
  </div>

  {!event && (
    <script is:inline define:vars={{ target: EVENTS_PATH, delay: REDIRECT_DELAY_MS }}>
      // `replace` so the dead URL doesn't become a back-button trap. The button
      // above works immediately and doesn't depend on this firing.
      setTimeout(function () {
        window.location.replace(target);
      }, delay);
    </script>
  )}

  {analyticsEvent && (
    <script is:inline define:vars={{ payload: analyticsEvent }}>
      // Mirrors trackBookingLinkClicked() in lib/analytics.ts so booking intent
      // from this page lands in the same funnel as the schedule and the modal.
      document.addEventListener('click', function (e) {
        var link = e.target instanceof Element ? e.target.closest('[data-booking-link]') : null;
        if (!link || !window.posthog) return;
        try {
          var match = /\/s\/(\d+)/.exec(link.getAttribute('href') || '');
          var attribution = typeof window.pyreAttribution === 'function' ? window.pyreAttribution() : {};
          window.posthog.capture(
            'booking_link_clicked',
            Object.assign(
              {
                placement: link.getAttribute('data-placement'),
                session_id: match ? match[1] : payload.fallback_id,
                session_title: payload.session_title,
                location: payload.location,
                iso_date: payload.iso_date,
                tags: payload.tags,
                spots_remaining: payload.spots_remaining,
                href: link.getAttribute('href'),
              },
              attribution
            )
          );
        } catch (err) {
          // analytics must never break the booking flow
        }
      });
    </script>
  )}
</MainLayout>
