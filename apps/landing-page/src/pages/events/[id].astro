---
// Single event page — the shareable URL for one Momence session.
//
// This route exists because link previews are read by crawlers that never run
// JavaScript: /events is prerendered and its og:image is baked in at build time,
// so every shared session used to preview with the same generic card. Rendering
// the session server-side per request puts its own image, title and description
// in <head>, and gives the link somewhere to land that looks like the thing that
// was shared.
//
// Momence's Events API only returns upcoming sessions, so any id it doesn't know
// — past, cancelled, unpublished, or mistyped — falls through to the "already
// happened" placeholder, which sends the visitor back to /events.

export const prerender = false;

import ogFallback from '@/assets/images/warm_sauna.webp';
import PractitionerByline from '@/components/events/PractitionerByline';
import MainLayout from '@/layouts/main.astro';
import { buildPooledBookingModel } from '@/lib/booking-model';
import { creditsForPriceUsd } from '@/lib/credits';
import { eventPath, parseEventId } from '@/lib/event-url';
import {
  excludeVolunteerEvents,
  fetchMomenceEvents,
  fetchMomenceTeachers,
  filterValidEvents,
  indexTeachersById,
  sortEventsByDate,
  transformToEventItem,
} from '@/lib/momence';
import { hasBio, specialEventPractitioners } from '@/lib/practitioners';
import { durationRowLabel, spotsColor, spotsLabel } from '@/lib/spots';
import type { EventItem, PooledBookingOption } from '@/lib/types';

const REDIRECT_DELAY_MS = 4000;
const EVENTS_PATH = '/events';

const eventId = parseEventId(Astro.params.id);

let event: EventItem | null = null;
let bookingOptions: PooledBookingOption[] = [];

if (eventId) {
  // Same pipeline as /api/events — the site's one definition of "a session we
  // show". Practitioners are best-effort and resolve to an empty roster.
  const [rawEvents, teachers] = await Promise.all([fetchMomenceEvents(), fetchMomenceTeachers()]);
  const teachersById = indexTeachersById(teachers);
  const events = sortEventsByDate(excludeVolunteerEvents(filterValidEvents(rawEvents))).map((raw) =>
    transformToEventItem(raw, teachersById)
  );

  event = events.find((candidate) => candidate.id === eventId) ?? null;

  // Pooled sessions (open hours, social evenings) are sold as gated duration
  // choices rather than a single Book Now, and the model is derived across the
  // whole calendar — so it has to be built from the full list, not one event.
  if (event) {
    bookingOptions = buildPooledBookingModel(events).optionsById.get(event.id) ?? [];
  }
}

// One URL serves the page, so the layout's pathname-derived canonical stays
// honest. A bare id or a stale slug redirects to the current canonical form,
// carrying any utm_* params along.
if (event) {
  const canonical = eventPath(event);
  if (Astro.url.pathname !== canonical) {
    return Astro.redirect(`${canonical}${Astro.url.search}`, 302);
  }
}

// A link blasted into a group chat should cost one origin hit.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// -- Metadata ----------------------------------------------------------------

const MAX_META_DESCRIPTION = 155;

function metaDescription(item: EventItem): string {
  const raw = item.description.replace(/\s+/g, ' ').trim();
  if (!raw) return `${item.title} at Pyre in Richmond, VA — ${item.date}, ${item.time}.`;
  if (raw.length <= MAX_META_DESCRIPTION) return raw;
  return `${raw.slice(0, MAX_META_DESCRIPTION).replace(/\s+\S*$/, '')}…`;
}

const title = event ? `${event.title} — Pyre` : 'Event has ended — Pyre';
const description = event
  ? metaDescription(event)
  : 'This session has already happened. Browse upcoming sauna and cold plunge sessions at Pyre in Richmond, VA.';

// Momence banners are remote URLs of unknown size, so they ship without
// og:image:width/height; the local fallback knows its own dimensions.
const remoteImage = event?.image?.src;
const ogImage = remoteImage ?? ogFallback.src;
const ogDimensions = remoteImage
  ? {}
  : { ogImageWidth: ogFallback.width, ogImageHeight: ogFallback.height };

// -- View model --------------------------------------------------------------

const practitioners = event ? specialEventPractitioners(event) : [];
const bios = practitioners.filter(hasBio);
const spots = event ? spotsLabel(event.spotsRemaining, event.totalSpots) : null;
const hasBookingOptions = bookingOptions.length > 0;
const singleCta = event && !event.isPrivate ? event.cta : undefined;
const isWaitlist = event?.spotsRemaining === 0;
const ctaLabel = isWaitlist ? 'Join Waitlist' : (singleCta?.label ?? 'Book Now');
// Special (non-pooled) events show their credit cost next to Book Now.
const singleCredits = hasBookingOptions ? null : creditsForPriceUsd(event?.priceUsd);
const showSpotsRow = spots && !hasBookingOptions && !singleCta;

// Rows shared by pooled duration choices and the single special-event CTA, so
// both render identically (mirrors BookingRow in EventDetailModal).
const bookingRows = hasBookingOptions
  ? bookingOptions.map((option) => ({
      minutes: option.minutes,
      fallbackLabel: option.label,
      credits: option.credits,
      spotsLeft: option.spotsLeft,
      href: option.soldOut ? null : option.href,
      label: option.soldOut ? 'Sold Out' : 'Book Now',
      ariaLabel: `${option.label} — ${event?.title ?? ''}`,
      placement: `event_page_${option.minutes}min`,
    }))
  : singleCta
    ? [
        {
          minutes: event?.durationMinutes ?? 0,
          fallbackLabel: undefined,
          credits: singleCredits,
          spotsLeft: event?.spotsRemaining,
          href: singleCta.href,
          label: ctaLabel,
          ariaLabel: singleCta.ariaLabel ?? `Book ${event?.title ?? ''}`,
          placement: 'event_page',
        },
      ]
    : [];

// schema.org/Event — only for a session that is actually on the calendar.
const eventSchema =
  event && event.isoDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: event.title,
        description: event.description || description,
        startDate: event.isoDate,
        ...(event.durationMinutes
          ? {
              endDate: new Date(
                new Date(event.isoDate).getTime() + event.durationMinutes * 60_000
              ).toISOString(),
            }
          : {}),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        ...(event.image ? { image: event.image.src } : {}),
        location: {
          '@type': 'Place',
          name: event.location,
          address: {
            '@type': 'PostalAddress',
            streetAddress: '1000 Westover Hills Blvd',
            addressLocality: 'Richmond',
            addressRegion: 'VA',
            addressCountry: 'US',
          },
        },
        organizer: {
          '@type': 'Organization',
          name: 'Pyre Sauna + Cold Plunge',
          url: 'https://pyresauna.com',
        },
        ...(event.priceUsd && singleCta
          ? {
              offers: {
                '@type': 'Offer',
                price: String(event.priceUsd),
                priceCurrency: 'USD',
                availability: isWaitlist
                  ? 'https://schema.org/SoldOut'
                  : 'https://schema.org/InStock',
                url: singleCta.href,
              },
            }
          : {}),
      }
    : null;

const siteOrigin = Astro.site?.toString() ?? 'https://pyresauna.com';
const breadcrumbSchema = event
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteOrigin).toString() },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Events',
          item: new URL(EVENTS_PATH, siteOrigin).toString(),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: event.title,
          item: new URL(eventPath(event), siteOrigin).toString(),
        },
      ],
    }
  : null;

// Payload for the booking-click event, so the page feeds the same funnel as the
// schedule rows and the detail modal (see lib/analytics.ts).
const analyticsEvent = event
  ? {
      session_title: event.title,
      location: event.location,
      iso_date: event.isoDate,
      tags: event.tags,
      spots_remaining: event.spotsRemaining,
      fallback_id: event.id,
    }
  : null;
---

<MainLayout
  title={title}
  description={description}
  transparentNav={false}
  ogImage={ogImage}
  noIndex={!event}
  {...ogDimensions}
>
  {/* JSON-LD is valid in the body, which keeps MainLayout free of a head slot. */}
  {eventSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}
  {breadcrumbSchema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <div class="min-h-screen bg-[var(--pyre-black)] pb-16 pt-24 md:pt-32">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      {event ? (
        <>
          {/* Back to the full calendar — the page should read as part of /events */}
          <a
            href={EVENTS_PATH}
            class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[var(--pyre-creme)]/50 transition-colors hover:text-[var(--pyre-creme)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-gold)]/50 rounded-full"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            All Upcoming Sessions
          </a>

          <article class="mt-6 overflow-hidden rounded-lg border border-[var(--pyre-creme)]/10 bg-[var(--pyre-black)]">
            {event.image && (
              <img
                src={event.image.src}
                alt={event.image.alt ?? event.title}
                class="w-full h-56 sm:h-72 object-cover"
                fetchpriority="high"
              />
            )}

            <div class="px-6 pt-8 pb-6">
              <h1 class="font-mono-bold text-2xl sm:text-3xl uppercase tracking-wide text-[var(--pyre-creme)]">
                {event.title}
              </h1>

              <div class="mt-4 space-y-2">
                <div class="flex items-center gap-2 text-sm text-[var(--pyre-creme)]/70">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>{event.date}</span>
                </div>
                <div class="flex items-center gap-2 text-sm text-[var(--pyre-creme)]/70">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>{event.time}</span>
                </div>
                <div class="flex items-center gap-2 text-sm text-[var(--pyre-creme)]/70">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>{event.location}</span>
                </div>
                {showSpotsRow && (
                  <div class={`flex items-center gap-2 text-sm ${spotsColor(event.spotsRemaining)}`}>
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <span>{spots}</span>
                  </div>
                )}
              </div>

              {practitioners.length > 0 && (
                <div class="mt-5 border-t border-[var(--pyre-creme)]/10 pt-4">
                  <PractitionerByline practitioners={practitioners} variant="modal" />
                  {bios.map((practitioner) => (
                    <details class="mt-3 group">
                      <summary class="cursor-pointer list-none font-mono text-[11px] uppercase tracking-wide text-[var(--pyre-muted-gold)] hover:text-[var(--pyre-creme)] transition-colors">
                        About {practitioner.name}
                      </summary>
                      <div class="mt-2 space-y-3">
                        {practitioner.bio?.map((paragraph) => (
                          <p class="font-sans text-sm leading-relaxed text-[var(--pyre-creme)]/70">
                            {paragraph}
                          </p>
                        ))}
                        {practitioner.links && practitioner.links.length > 0 && (
                          <div class="flex flex-wrap gap-x-4 gap-y-1">
                            {practitioner.links.map((link) => (
                              <a
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-mono text-[11px] uppercase tracking-wide text-[var(--pyre-muted-gold)] hover:text-[var(--pyre-creme)] transition-colors"
                              >
                                {link.label}
                              </a>
                            ))}
                          </div>
                        )}
                      </div>
                    </details>
                  ))}
                </div>
              )}

              {event.description && (
                <p class="mt-5 whitespace-pre-line font-sans text-base leading-relaxed text-[var(--pyre-creme)]/80">
                  {event.description}
                </p>
              )}
            </div>

            {bookingRows.length > 0 && (
              <div class="border-t border-[var(--pyre-creme)]/10 px-6 py-2">
                {bookingRows.map((row) => (
                  <div class="grid grid-cols-[auto_auto_auto_1fr] items-center gap-3 border-t border-[var(--pyre-creme)]/10 py-2.5 first:border-t-0">
                    <span class="font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] whitespace-nowrap">
                      {durationRowLabel(row.minutes, row.fallbackLabel)}
                    </span>
                    <span class="font-mono-bold text-xs uppercase tracking-wide whitespace-nowrap">
                      {row.credits !== null && row.credits !== undefined && (
                        <span class="text-[var(--pyre-muted-gold)]">
                          {row.credits} Credit{row.credits > 1 ? 's' : ''}
                        </span>
                      )}
                    </span>
                    <span class={`text-[11px] whitespace-nowrap ${spotsColor(row.spotsLeft)}`}>
                      {row.spotsLeft !== undefined ? `${row.spotsLeft} left` : ''}
                    </span>
                    {row.href ? (
                      <a
                        href={row.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={row.ariaLabel}
                        data-booking-link
                        data-placement={row.placement}
                        class="flex items-center justify-center gap-1 justify-self-end rounded-full bg-[var(--pyre-red)] px-4 py-2 font-mono-bold text-xs sm:text-sm uppercase tracking-wide whitespace-nowrap text-[var(--pyre-creme)] transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-red)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--pyre-black)]"
                      >
                        {row.label}
                        <span class="hidden sm:inline-flex items-center">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                          </svg>
                        </span>
                      </a>
                    ) : (
                      <span
                        aria-disabled="true"
                        title="Not available"
                        class="flex items-center justify-center justify-self-end rounded-full border border-[var(--pyre-creme)]/15 px-4 py-2 font-mono-bold text-xs sm:text-sm uppercase tracking-wide whitespace-nowrap text-[var(--pyre-creme)]/35 cursor-not-allowed"
                      >
                        {row.label}
                      </span>
                    )}
                  </div>
                ))}
              </div>
            )}
          </article>

          <a
            href={EVENTS_PATH}
            class="mt-6 flex items-center justify-center rounded-full border border-[var(--pyre-creme)]/20 px-6 py-3 font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] transition-colors hover:border-[var(--pyre-gold)] hover:text-[var(--pyre-gold)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-gold)]/50"
          >
            All Upcoming Sessions
          </a>
        </>
      ) : (
        <div class="mx-auto max-w-md text-center">
          <h1 class="font-primary-semibold text-[clamp(1.75rem,3.5vw,2.5rem)] uppercase tracking-[-0.02em] text-[var(--pyre-creme)]">
            This event has already happened
          </h1>
          <p class="mt-4 font-sans text-base leading-relaxed text-[var(--pyre-creme)]/70">
            There are new sessions on the calendar — sauna, cold plunge, and guided
            rounds most days of the week.
          </p>
          <a
            href={EVENTS_PATH}
            class="mt-8 inline-flex items-center justify-center rounded-full bg-[var(--pyre-red)] px-6 py-3 font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-red)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--pyre-black)]"
          >
            See Upcoming Sessions
          </a>
          <p class="mt-6 font-mono text-xs uppercase tracking-widest text-[var(--pyre-creme)]/40">
            Taking you there in a moment…
          </p>
        </div>
      )}
    </div>
  </div>

  {!event && (
    <script is:inline define:vars={{ target: EVENTS_PATH, delay: REDIRECT_DELAY_MS }}>
      // `replace` so the dead URL doesn't become a back-button trap. The button
      // above works immediately and doesn't depend on this firing.
      setTimeout(function () {
        window.location.replace(target);
      }, delay);
    </script>
  )}

  {analyticsEvent && (
    <script is:inline define:vars={{ payload: analyticsEvent }}>
      // Mirrors trackBookingLinkClicked() in lib/analytics.ts so booking intent
      // from this page lands in the same funnel as the schedule and the modal.
      document.addEventListener('click', function (e) {
        var link = e.target instanceof Element ? e.target.closest('[data-booking-link]') : null;
        if (!link || !window.posthog) return;
        try {
          var match = /\/s\/(\d+)/.exec(link.getAttribute('href') || '');
          var attribution = typeof window.pyreAttribution === 'function' ? window.pyreAttribution() : {};
          window.posthog.capture(
            'booking_link_clicked',
            Object.assign(
              {
                placement: link.getAttribute('data-placement'),
                session_id: match ? match[1] : payload.fallback_id,
                session_title: payload.session_title,
                location: payload.location,
                iso_date: payload.iso_date,
                tags: payload.tags,
                spots_remaining: payload.spots_remaining,
                href: link.getAttribute('href'),
              },
              attribution
            )
          );
        } catch (err) {
          // analytics must never break the booking flow
        }
      });
    </script>
  )}
</MainLayout>
