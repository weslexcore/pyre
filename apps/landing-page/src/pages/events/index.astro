---
export const prerender = true;

import ogImg from '@/assets/images/warm_sauna.webp';
import EventsGrid from '@/components/events/EventsGrid';
import MainLayout from '@/layouts/main.astro';
import fallbackEvents from '@/lib/events';

// SEO metadata
const title = 'Events - Pyre';
const description =
  'Browse and book upcoming sauna sessions, cold plunge classes, and guided wellness events at Pyre in Richmond, VA.';
---

<MainLayout title={title} description={description} transparentNav={true} ogImage={ogImg.src} ogImageWidth={ogImg.width} ogImageHeight={ogImg.height}>
  <div class="min-h-screen bg-[var(--pyre-black)] pb-16 pt-24 md:pt-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="mb-8">
        <h1 class="font-primary-semibold text-[clamp(2rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-4 text-[var(--pyre-creme)]">
          {fallbackEvents.title}
        </h1>
        <p class="font-sans text-xl leading-relaxed text-[var(--pyre-creme)]/70">
          {description}
        </p>
      </header>

      <!-- Dynamic Events Grid (React island) — renders its own session-type filters -->

      <div id="events-container">
        {/* Server-rendered skeleton shown instantly, replaced when React hydrates */}
        <div id="events-skeleton" class="space-y-8 text-[var(--pyre-creme)]">
          {Array.from({ length: 3 }).map((_, gi) => (
            <div>
              <div class="flex items-center gap-4 mb-3">
                <div class="h-4 w-48 bg-current/10 rounded animate-pulse" />
                <div class="flex-1 h-px bg-current/10" />
              </div>
              {Array.from({ length: 2 }).map((_, ri) => (
                <div class="flex items-center gap-4 py-3 px-4 animate-pulse">
                  <div class="h-4 w-36 bg-current/10 rounded" />
                  <div class="flex-1" />
                  <div class="h-4 w-32 bg-current/10 rounded" />
                  <div class="h-4 w-20 bg-current/10 rounded" />
                  <div class="h-7 w-24 bg-current/10 rounded-full" />
                </div>
              ))}
            </div>
          ))}
        </div>
        <EventsGrid client:idle fallback={fallbackEvents.items} />
      </div>

      <!-- Results Count -->
      <div id="results-count" class="mt-6 text-center">
        <p class="font-mono text-sm text-[var(--pyre-creme)]/50">
          Showing <span id="visible-count">0</span> of <span id="total-count">0</span> sessions
        </p>
      </div>
    </div>

    <!-- About Our Sessions (always visible — improves SEO and helps first-timers) -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-24 pb-4">
      <div class="border-t border-[var(--pyre-creme)]/10 pt-16">
        <h2 class="font-primary-semibold text-2xl md:text-3xl uppercase tracking-[-0.02em] text-[var(--pyre-creme)] mb-10">
          About Our Sessions
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-16">
          <div>
            <h3 class="font-primary-semibold text-lg uppercase tracking-wide text-[var(--pyre-creme)] mb-3">Social Sessions</h3>
            <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
             Sauna and cold plunge combined with DJ sets, live music, and community events. Great for first-timers and regulars alike. Bring a friend or make a new one. Drop in for a single hour or book the full evening.
            </p>
          </div>
          <div>
            <h3 class="font-primary-semibold text-lg uppercase tracking-wide text-[var(--pyre-creme)] mb-3">Open Hours</h3>
            <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
              Self-paced sessions for socializing, resting and unwinding. Great for first-timers and regulars alike. Talk, relax, or zone out — the space is yours.
            </p>
          </div>
          <div>
            <h3 class="font-primary-semibold text-lg uppercase tracking-wide text-[var(--pyre-creme)] mb-3">Guided Sessions</h3>
            <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
              Our certified Sauna Masters guide you through contrast therapy rounds — sauna heat, cold plunge, movement and rest timed for maximum benefit and community connection. No experience required.
            </p>
          </div>
        </div>

        <h2 class="font-primary-semibold text-2xl md:text-3xl uppercase tracking-[-0.02em] text-[var(--pyre-creme)] mb-8">
          What to Expect
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-16">
          <div class="space-y-6">
            <div>
              <h3 class="font-primary-semibold text-base uppercase tracking-wide text-[var(--pyre-creme)] mb-2">Location</h3>
              <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
                Pyre is located at 1000 Westover Hills Blvd, Richmond, VA. Sessions are held outdoors and we have changing rooms and a rinse shower for during and after your session. All sessions include towel service and cubby access.
              </p>
            </div>
            <div>
              <h3 class="font-primary-semibold text-base uppercase tracking-wide text-[var(--pyre-creme)] mb-2">What to Bring</h3>
              <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
                Wear a swimsuit, bring a water bottle and sandals if you'd like. We provide towels, cubbies, and water. Leave your phone in the cubby — sessions are a digital detox by design.
              </p>
            </div>
          </div>
          <div class="space-y-6">
            <div>
              <h3 class="font-primary-semibold text-base uppercase tracking-wide text-[var(--pyre-creme)] mb-2">Session Length</h3>
              <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
                Most sessions run 60 minutes — open hours can be booked for one or two hours, and social evenings by the hour or as a full evening. A typical contrast therapy round is 10–15 minutes in the sauna followed by 2–3 minutes in the cold plunge, repeated 3–5 times with rest in between.
              </p>
            </div>
            <div>
              <h3 class="font-primary-semibold text-base uppercase tracking-wide text-[var(--pyre-creme)] mb-2">Booking</h3>
              <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
                Sessions are bookable online — browse upcoming sessions and filter by session type above. New to Pyre? <a href="/#membership" class="text-[var(--pyre-muted-gold)] hover:text-[var(--pyre-creme)]">Our intro 2-pack</a> is the best way to try it.
              </p>
            </div>
          </div>
        </div>

        <h2 class="font-primary-semibold text-2xl md:text-3xl uppercase tracking-[-0.02em] text-[var(--pyre-creme)] mb-8">
          FAQ
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-primary-semibold text-base uppercase tracking-wide text-[var(--pyre-creme)] mb-2">Do I need experience with saunas?</h3>
            <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
              No. Guided sessions are designed for beginners and include full instruction. Social and open hours sessions are self-guided — you set your own pace - however, our staff is always available for questions.
            </p>
          </div>
          <div>
            <h3 class="font-primary-semibold text-base uppercase tracking-wide text-[var(--pyre-creme)] mb-2">Is there a minimum age?</h3>
            <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
              Guests must be 18 or older to book a session. All sessions require completing a waiver before entering.
            </p>
          </div>
          <div>
            <h3 class="font-primary-semibold text-base uppercase tracking-wide text-[var(--pyre-creme)] mb-2">Can I cancel or reschedule?</h3>
            <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
              Yes. Cancellations made at least 24 hours before a session receive a full credit toward a future booking. Same-day cancellations are non-refundable.
            </p>
          </div>
          <div>
            <h3 class="font-primary-semibold text-base uppercase tracking-wide text-[var(--pyre-creme)] mb-2">Do you offer membership?</h3>
            <p class="font-sans text-[var(--pyre-creme)]/70 leading-relaxed">
              Yes. Monthly memberships give you unlimited or discounted access depending on the tier. Members also get discounts on extra credits for themselves and guests. <a href="/#membership" class="text-[var(--pyre-muted-gold)] hover:text-[var(--pyre-creme)]">See our homepage for membership options.</a>
            </p>
          </div>
        </div>
        <div class="text-center mt-8">
        <span class="text-[var(--pyre-creme)]/70 leading-relaxed">
          Have other questions? See our full <a href="/#faq" class="text-[var(--pyre-muted-gold)] hover:text-[var(--pyre-creme)]">FAQ</a> or reach out to us at <a href="mailto:info@pyresauna.com" class="text-[var(--pyre-muted-gold)] hover:text-[var(--pyre-creme)]">hello@pyresauna.com</a>.</span>
        </div>
        </div>
    </div>
  </div>
</MainLayout>
