---
export const prerender = true;

import PartnerLanding from '../components/PartnerLanding.astro';
import embody from '../lib/embody';
---

<PartnerLanding content={embody}>
  <span
    slot="logo"
    class="flex flex-col items-center font-primary-semibold text-2xl md:text-4xl uppercase tracking-[0.08em] leading-[0.95] text-[var(--pyre-creme)]"
    role="img"
    aria-label="Embody Pilates"
  >
    <span>Embody</span>
    <span>Pilates</span>
  </span>
</PartnerLanding>
