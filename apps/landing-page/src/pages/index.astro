---
export const prerender = true;

import ogImg from '../assets/images/cyano_sweat_logo.jpg';
import EventsSection from '../components/EventsSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import GiftCardSection from '../components/GiftCardSection.astro';
import GroupBookingSection from '../components/GroupBookingSection.astro';
import MembershipSection from '../components/MembershipSection.astro';
import SessionSection from '../components/SessionSection.astro';
import SignupForm from '../components/SignupForm.astro';
import SwissHero from '../components/swiss/SwissHero.astro';
import SwissIntro from '../components/swiss/SwissIntro.astro';
import SwissMission from '../components/swiss/SwissMission.astro';
import SwissSection from '../components/swiss/SwissSection.astro';
import SwissValues from '../components/swiss/SwissValues.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import Layout from '../layouts/main.astro';
---

<Layout isHomePage={true} ogImage={ogImg.src} ogImageWidth={ogImg.width} ogImageHeight={ogImg.height}>
  <!-- Cover -->
  <SwissHero />

  <!-- Interior document pages -->
  <div class="bg-[var(--pyre-creme)] text-[var(--pyre-black)]">
    <div class="mx-auto max-w-[1440px] px-4 pt-16 md:px-8 md:pt-24">
      <SwissSection index="01" label="Introduction" id="about">
        <SwissIntro />
      </SwissSection>

      <!-- Mission running header (band itself is full-bleed below) -->
      <div class="border-t border-current/80"></div>
      <div class="flex items-baseline justify-between gap-4 pt-3 pb-10 font-mono-bold text-[0.65rem] md:text-xs uppercase tracking-[0.14em] md:pb-14">
        <span>02&nbsp;&nbsp;Mission Statement</span>
        <span class="hidden md:inline opacity-60">Standard Identity Procedures</span>
        <span class="opacity-60">ESTD. '24</span>
      </div>
    </div>

    <SwissMission />

    <div class="mx-auto max-w-[1440px] px-4 pt-16 md:px-8 md:pt-24">
      <SwissSection index="03" label="Experiences" id="experiences">
        <SwissValues />
      </SwissSection>

      <SwissSection index="04" label="Upcoming Events" defer>
        <EventsSection limit={10} />
      </SwissSection>

      <SwissSection index="05" label="Community" defer>
        <TestimonialsSection />
      </SwissSection>

      <SwissSection index="06" label="Credits + Passes" defer>
        <SessionSection />
      </SwissSection>

      <SwissSection index="07" label="Memberships" defer>
        <MembershipSection />
      </SwissSection>

      <SwissSection index="08" label="Groups + Gifts" defer>
        <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-12">
          <GroupBookingSection />
          <GiftCardSection />
        </div>
      </SwissSection>

      <SwissSection index="09" label="Common Questions" id="faq" defer>
        <FAQAccordion />
      </SwissSection>
    </div>

    <!-- Join: black plate, mirrors the cover -->
    <div id="signup" class="dark bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
      <div class="mx-auto max-w-[1440px] px-4 py-16 md:px-8 md:py-24">
        <div class="border-t border-[var(--pyre-creme)]/40"></div>
        <div class="flex items-baseline justify-between gap-4 pt-3 pb-10 font-mono-bold text-[0.65rem] md:text-xs uppercase tracking-[0.14em] md:pb-14">
          <span>10&nbsp;&nbsp;Join Us</span>
          <span class="hidden md:inline opacity-60">Standard Identity Procedures</span>
          <span class="opacity-60">ESTD. '24</span>
        </div>
        <SignupForm />

        <!-- Running footer: brand taglines -->
        <div class="mt-16 border-t border-[var(--pyre-creme)]/40 md:mt-24"></div>
        <div class="flex items-center justify-between gap-4 pt-4 font-mono-bold text-[0.6rem] uppercase tracking-[0.14em] opacity-70 md:text-xs">
          <span>A Duality</span>
          <span class="hidden sm:inline">Something Social</span>
          <span>From Purge to Plunge</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* Swiss square CTAs — shared across the reworked homepage components */
  .swiss-btn {
    display: inline-block;
    text-align: center;
    font-family: var(--font-mono-bold);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 1rem 1.75rem;
    border: 1px solid transparent;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .swiss-btn--red {
    background: var(--pyre-red);
    color: var(--pyre-creme);
  }

  .swiss-btn--red:hover {
    background: var(--pyre-creme);
    color: var(--pyre-black);
  }

  .swiss-btn--black {
    background: var(--pyre-black);
    color: var(--pyre-creme);
  }

  .swiss-btn--black:hover {
    background: var(--pyre-red);
  }

  .swiss-btn--outline-creme {
    border-color: color-mix(in srgb, var(--pyre-creme) 45%, transparent);
    color: var(--pyre-creme);
  }

  .swiss-btn--outline-creme:hover {
    background: var(--pyre-creme);
    color: var(--pyre-black);
  }
</style>
