---
import TexturedCard from '@/components/TexturedCard.astro';
import AboutContent from '../components/AboutContent.astro';
import AboutSection from '../components/AboutSection.astro';
import BenefitsContent from '../components/BenefitsContent.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import EventsContent from '../components/EventsContent.astro';
import EventsSection from '../components/EventsSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import FAQContent from '../components/FAQContent.astro';
import Hero from '../components/Hero.astro';
import HeroBackground from '../components/HeroBackground.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import MembershipContent from '../components/MembershipContent.astro';
import MembershipPricing from '../components/MembershipPricing.astro';
import SectionBridge from '../components/SectionBridge.astro';
import SectionCard from '../components/SectionCard.astro';
import SectionDivider from '../components/SectionDivider.astro';
import SessionContent from '../components/SessionContent.astro';
import SessionPricing from '../components/SessionPricing.astro';
import SignupForm from '../components/SignupForm.astro';
import SignupFormCompact from '../components/SignupFormCompact.astro';
import Layout from '../layouts/main.astro';
import ScrollGradientOverlay from '../components/ScrollGradientOverlay.astro';
---

<Layout isHomePage={true}>
  <main class="dark">
    <!-- Mobile: three-layer scroll effect -->
    <!-- Black background prevents white showing during overscroll bounce -->
    <div class="lg:hidden bg-[var(--pyre-black)]">
      <!-- Layer 1: Fixed text (z-0) + spacer - rendered by Hero component -->
      <Hero />

      <!-- Layer 2: Sticky image (z-10) - starts at 80dvh, scrolls up and locks at top -->
      <div class="sticky top-0 z-10 h-[100dvh] hero-wave-mask">
        <HeroCarousel />
      </div>

      <!-- Animated gradient overlay (z-15) - fixed, fades as content scrolls -->
      <ScrollGradientOverlay variant="hero-mobile" />

      <!-- Layer 3: Content cards (z-20) - scroll over the locked image -->
      <div class="relative z-20 px-4 pt-4 pb-4 -mt-[50dvh]">
        <!-- <SectionDivider variant="wave" animate="wave" class="my-8 mx-auto w-72"/> -->
        <div class="relative rounded-lg overflow-hidden bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
          <AboutSection />
        </div>
        <SectionDivider variant="wave" animate="wave" class="my-8 mx-auto w-72"/>
        <div class="relative rounded-lg overflow-hidden bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
          <BenefitsSection />
        </div>
        <SectionDivider variant="blob" animate="reveal" class="my-8 mx-auto w-72"/>
        <div class="relative rounded-t-lg overflow-hidden bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
          <SessionPricing />
        </div>
        <SectionBridge bgColor="var(--pyre-black)" variant="wave" position="bottom" />
        <div class="h-4"></div>
        <SectionBridge bgColor="var(--pyre-black)" variant="wave" position="top" />
        <div class="relative rounded-b-lg overflow-hidden bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
          <MembershipPricing />
        </div>
        <SectionDivider variant="squiggle" animate="reveal" class="my-8 mx-auto w-72"/>
        <div class="relative rounded-lg overflow-hidden bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
          <EventsSection />
        </div>
        <SectionDivider variant="torn" animate="reveal" class="my-8 mx-auto w-72"/>
        <div class="relative rounded-lg overflow-hidden bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
          <FAQAccordion />
        </div>
        <SectionDivider variant="wave" flip animate="wave" />
        <div class="relative rounded-lg overflow-hidden bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
          <SignupForm />
        </div>
      </div>
    </div>

    <!-- Desktop: fixed background + scrolling cards on right side only -->
    <div class="hidden lg:block">
      <!-- Fixed background layer (z-0) -->
      <HeroBackground />

      <!-- Animated gradient overlay on hero background (left 40%) -->
      <ScrollGradientOverlay variant="hero-desktop" />

      <!-- Scrolling cards layer - positioned on right 60% only -->
      <div class="relative z-10 ml-[40%] w-[60%] pt-[100vh] pb-0">
        <div class="px-6 pb-6">
          <!-- <SectionDivider variant="wave" animate="wave" /> -->
          <SectionCard stackIndex={0}>
            <AboutContent />
          </SectionCard>
          <SectionDivider variant="wave" animate="wave" class="my-4 mx-auto w-72"/>
          <SectionCard stackIndex={1}>
            <BenefitsContent />
          </SectionCard>
          <SectionDivider variant="blob" animate="wave" class="my-4 mx-auto w-72"/>
          <SectionCard stackIndex={2} class="lg:rounded-t-lg lg:rounded-b-none">
            <SessionContent />
          </SectionCard>
          <SectionBridge bgColor="var(--pyre-black)" variant="wave" position="bottom" />
          <div class="h-4"></div>
          <SectionBridge bgColor="var(--pyre-black)" variant="wave" position="top" />
          <SectionCard stackIndex={3} class="lg:rounded-t-none lg:rounded-b-lg">
            <MembershipContent />
          </SectionCard>
          <SectionDivider variant="squiggle" animate="reveal" class="my-4 mx-auto w-72"/>
          <SectionCard stackIndex={4}>
            <EventsContent />
          </SectionCard>
          <SectionDivider variant="torn" animate="reveal" class="my-4 mx-auto w-72"/>
          <SectionCard stackIndex={5}>
            <FAQContent />
          </SectionCard>
          <SectionDivider variant="wave" flip animate="wave" class="my-4 mx-auto w-72"/>
          <SectionCard stackIndex={6}>
            <SignupFormCompact />
          </SectionCard>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Wavy top edge mask for mobile hero image */
  .hero-wave-mask {
    --wave-svg: url("data:image/svg+xml,%3Csvg viewBox='0 0 100 100' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0,3 C12.5,1 25,5 37.5,3 C50,1 62.5,5 75,3 C87.5,1 100,5 100,3 L100,100 L0,100 Z' fill='white'/%3E%3C/svg%3E");
    -webkit-mask-image: var(--wave-svg);
    mask-image: var(--wave-svg);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
</style>
