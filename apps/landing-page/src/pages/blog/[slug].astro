---
export const prerender = false;

import { getCollection, render } from 'astro:content';
import BlogPostLayout from '@/layouts/blog-post.astro';
import { calculateReadingTime } from '@/lib/reading-time';
import { getRelatedPosts } from '@/lib/related-posts';

const { slug } = Astro.params;

// Get all published, non-future posts
const now = new Date();
const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.date <= now;
});

// Find the requested post
const post = allPosts.find((p) => p.id === slug);

if (!post) {
  return Astro.redirect('/404');
}

// Calculate reading time
const readingTime = calculateReadingTime(post.body ?? '');

// Get related posts
const relatedPosts = getRelatedPosts(post, allPosts);

// Render the post content
const { Content } = await render(post);
---

<BlogPostLayout post={post} relatedPosts={relatedPosts} readingTime={readingTime}>
  <Content />
</BlogPostLayout>
