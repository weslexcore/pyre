---
export const prerender = true;

import { Image } from 'astro:assets';
import heroImg from '../assets/images/837A0206.webp';
import introImg from '../assets/images/837A0269.webp';
import communityImg from '../assets/images/community_3.webp';
import joinImg from '../assets/images/plunging.webp';
import Button from '../components/Button.astro';
import CtaTracking from '../components/CtaTracking.astro';
import FoundingCountdown from '../components/FoundingCountdown.astro';
import GoogleRatingBadge from '../components/GoogleRatingBadge.astro';
import SectionDivider from '../components/SectionDivider.astro';
import StickyOfferBar from '../components/StickyOfferBar.astro';
import Layout from '../layouts/main.astro';
import testimonials from '../lib/testimonials';
import unlimited from '../lib/unlimited';

// Benefits first; the price appears only in the `join` (checkout) section at the bottom.
const { hero, stats, included, founding, intro, faqs, join } = unlimited;
const quotes = testimonials.items.filter((t) => t.highlight).slice(0, 3);
const [featuredQuote, ...otherQuotes] = quotes;

const check = 'M5 13l4 4L19 7';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.items.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Layout
  title={unlimited.meta.title}
  description={unlimited.meta.description}
  ogImage={heroImg.src}
  ogImageWidth={heroImg.width}
  ogImageHeight={heroImg.height}
  hidePromos={true}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="dark bg-[var(--pyre-black)] text-[var(--pyre-creme)] scroll-smooth">
    <!-- Hero -->
    <section class="relative w-full min-h-[90dvh] flex items-center justify-center overflow-hidden">
      <Image
        src={heroImg}
        alt="Pyre sauna"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="absolute inset-0 w-full h-full object-cover object-center sm:object-[20%_20%]"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-[var(--pyre-black)]/45"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--pyre-black)] via-[var(--pyre-black)]/10 to-[var(--pyre-black)]/40"></div>

      <div class="relative z-10 max-w-3xl mx-auto px-4 pt-32 pb-16 md:pt-40 md:pb-24 text-center">
        <p class="font-mono-bold text-sm md:text-base tracking-[0.2em] uppercase text-[var(--pyre-muted-gold)] mb-4">
          {hero.eyebrow}
        </p>
        <h1 class="font-primary-semibold text-[clamp(2.5rem,6vw,4.5rem)] tracking-[-0.02em] uppercase leading-[1.05] mb-4 md:mb-6">
          {hero.title}
        </h1>
        <p class="text-base md:text-lg opacity-85 max-w-xl mx-auto mb-6">{hero.subtitle}</p>
        <div class="flex flex-wrap items-center justify-center gap-2 mb-8">
          <p class="inline-block px-3 py-1 bg-[var(--pyre-muted-gold)] text-[var(--pyre-black)] text-xs font-mono-bold uppercase tracking-wide rounded-full">
            {hero.pill}
          </p>
          <FoundingCountdown />
        </div>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <Button
            href={hero.primaryCta.href}
            variant="primary"
            size="lg"
            ariaLabel={hero.primaryCta.ariaLabel}
            data-track-placement="unlimited_hero"
          >
            {hero.primaryCta.label}
          </Button>
          <Button
            href={hero.secondaryCta.href}
            variant="outline"
            size="lg"
            ariaLabel={hero.secondaryCta.ariaLabel}
            data-track-placement="unlimited_hero_intro_link"
          >
            {hero.secondaryCta.label}
          </Button>
        </div>
        <GoogleRatingBadge placement="unlimited_hero_google_rating" class="mt-6" />
      </div>
    </section>

    <!-- Stats -->
    <section aria-label="Membership at a glance" class="px-4 pb-12 md:pb-16">
      <ul class="max-w-4xl mx-auto grid grid-cols-3 gap-2 md:gap-6 text-center">
        {stats.map((stat) => (
          <li class="border border-current/15 rounded-lg py-4 px-2 md:py-6">
            <span class="block font-primary-semibold text-2xl md:text-4xl text-[var(--pyre-muted-gold)] leading-none mb-2">
              {stat.value}
            </span>
            <span class="block text-[11px] md:text-sm opacity-70 leading-snug">{stat.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- What's included -->
    <section id="included" aria-labelledby="included-heading" class="border-t border-[var(--pyre-muted-gold)]/20 bg-[var(--pyre-black)] bg-[radial-gradient(ellipse_at_top,color-mix(in_oklch,var(--pyre-muted-gold)_14%,transparent),transparent_65%)] py-16 md:py-24 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8 md:mb-12">
          <h2
            id="included-heading"
            class="font-primary-semibold text-[clamp(1.75rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-3"
          >
            {included.heading}
          </h2>
          <p class="text-base md:text-lg opacity-80 max-w-xl mx-auto">{included.subtitle}</p>
          <SectionDivider variant="wave" revealAnimation="draw" visibleAnimation="pulse" class="mx-auto w-72 my-6 [&_path]:[stroke:var(--pyre-muted-gold)]" scrollAware={true} />
        </div>

        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-5">
          {included.benefits.map((benefit) => (
            <li class="border border-[var(--pyre-muted-gold)]/25 rounded-lg p-6 md:p-7 bg-[var(--pyre-creme)]/[0.03] transition-colors duration-300 hover:border-[var(--pyre-muted-gold)]/60">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-[var(--pyre-muted-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={check} />
                </svg>
                <div>
                  <h3 class="font-mono-bold text-sm md:text-base uppercase tracking-[0.12em] text-[var(--pyre-muted-gold)] mb-2">{benefit.title}</h3>
                  <p class="text-sm opacity-70 leading-relaxed">{benefit.body}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Testimonials -->
    {quotes.length > 0 && (
      <section aria-labelledby="quotes-heading" class="relative py-20 md:py-32 px-4 overflow-hidden">
        <Image
          src={communityImg}
          alt=""
          widths={[768, 1280, 1920]}
          sizes="100vw"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[var(--pyre-black)]/85"></div>

        <div class="relative z-10 max-w-4xl mx-auto text-center">
          <h2 id="quotes-heading" class="font-mono-bold text-xs md:text-sm tracking-[0.3em] uppercase text-[var(--pyre-muted-gold)] mb-10 md:mb-14">
            {unlimited.testimonials.heading}
          </h2>

          <!-- Featured quote -->
          <figure class="mb-14 md:mb-20">
            <blockquote class="font-primary-semibold text-[clamp(1.375rem,3.2vw,2.25rem)] leading-[1.3] tracking-[-0.01em]">
              &ldquo;{featuredQuote.quote}&rdquo;
            </blockquote>
            <figcaption class="mt-6 flex items-center justify-center gap-3 font-mono-bold text-xs uppercase tracking-[0.2em] text-[var(--pyre-muted-gold)]">
              <span class="h-px w-8 bg-[var(--pyre-muted-gold)]/60" aria-hidden="true"></span>
              {featuredQuote.name}
              <span class="h-px w-8 bg-[var(--pyre-muted-gold)]/60" aria-hidden="true"></span>
            </figcaption>
          </figure>

          {otherQuotes.length > 0 && (
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 text-left">
              {otherQuotes.map((quote) => (
                <li>
                  <figure class="border-l border-[var(--pyre-muted-gold)]/50 pl-5 md:pl-6">
                    <blockquote class="text-sm md:text-base italic opacity-80 leading-relaxed">
                      &ldquo;{quote.quote}&rdquo;
                    </blockquote>
                    <figcaption class="mt-4 font-mono-bold text-[11px] uppercase tracking-[0.2em] opacity-60">
                      {quote.name} · {quote.sessionType}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    <!-- Why founding -->
    <section id="founding" aria-labelledby="founding-heading" class="border-t border-current/10 py-16 md:py-24 px-4">
      <div class="max-w-4xl mx-auto md:grid md:grid-cols-2 md:gap-12 md:items-center">
        <div class="mb-8 md:mb-0 text-center md:text-left">
          <h2 id="founding-heading" class="font-primary-semibold text-[clamp(1.75rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-4">
            {founding.heading}
          </h2>
          <p class="text-base md:text-lg opacity-80 mb-6">{founding.body}</p>
          <Button
            href={hero.primaryCta.href}
            variant="primary"
            size="lg"
            ariaLabel={hero.primaryCta.ariaLabel}
            data-track-placement="unlimited_founding"
            class="w-full sm:w-auto"
          >
            {hero.primaryCta.label}
          </Button>
        </div>

        <ul class="rounded-lg border-2 border-[var(--pyre-muted-gold)] bg-[var(--pyre-muted-gold)]/5 p-6 md:p-8 space-y-4">
          {founding.points.map((point) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-[var(--pyre-muted-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={check} />
              </svg>
              <span class="font-mono-bold text-sm md:text-base uppercase tracking-wide">{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Intro funnel -->
    <section id="intro" aria-labelledby="intro-heading" class="relative border-t border-current/10 py-16 md:py-24 px-4 overflow-hidden scroll-mt-20">
      <Image
        src={introImg}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-[var(--pyre-black)]/80"></div>

      <div class="relative z-10 max-w-5xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <p class="font-mono-bold text-xs md:text-sm tracking-[0.2em] uppercase text-[var(--pyre-muted-gold)] mb-3">
            {intro.eyebrow}
          </p>
          <h2 id="intro-heading" class="font-primary-semibold text-[clamp(1.75rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-3">
            {intro.heading}
          </h2>
          <p class="text-base md:text-lg opacity-85 max-w-2xl mx-auto">{intro.body}</p>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-5 mb-10 md:mb-12">
          {intro.steps.map((step, index) => (
            <li class="border border-current/20 rounded-lg p-5 md:p-6 bg-[var(--pyre-black)]/40">
              <span class="block font-primary-semibold text-3xl text-[var(--pyre-muted-gold)] leading-none mb-3">
                {index + 1}
              </span>
              <h3 class="font-mono-bold text-sm md:text-base uppercase tracking-wide mb-1.5">{step.title}</h3>
              <p class="text-sm opacity-75">{step.body}</p>
            </li>
          ))}
        </ol>

        <div class="max-w-md mx-auto border-2 border-[var(--pyre-gold)] bg-[var(--pyre-black)]/85 rounded-lg p-6 md:p-8 text-center shadow-2xl">
          <ul class="space-y-2 mb-6 text-left inline-block">
            {intro.perks.map((perk) => (
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-4 h-4 flex-shrink-0 mt-0.5 text-[var(--pyre-muted-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={check} />
                </svg>
                <span>{perk}</span>
              </li>
            ))}
          </ul>
          <Button
            href={intro.cta.href}
            variant="outline"
            size="lg"
            ariaLabel={intro.cta.ariaLabel}
            data-track-placement="unlimited_intro"
            class="w-full"
          >
            {intro.cta.label}
          </Button>
          <p class="mt-3 text-xs opacity-60">{intro.finePrint}</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" aria-labelledby="faq-heading" class="border-t border-[var(--pyre-muted-gold)]/20 bg-[var(--pyre-black)] py-16 md:py-24 px-4">
      <div class="max-w-3xl mx-auto">
        <h2 id="faq-heading" class="font-primary-semibold text-[clamp(1.75rem,4vw,3rem)] tracking-[-0.02em] uppercase text-center mb-8">
          {faqs.heading}
        </h2>
        <div class="space-y-1">
          {faqs.items.map((faq) => (
            <details class="group border-b border-[var(--pyre-muted-gold)]/20">
              <summary class="flex items-center justify-between gap-4 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <span class="font-mono-bold text-base md:text-lg transition-colors group-open:text-[var(--pyre-muted-gold)] group-hover:text-[var(--pyre-muted-gold)]">{faq.question}</span>
                <svg class="w-5 h-5 flex-shrink-0 text-[var(--pyre-muted-gold)] transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12M6 12h12" />
                </svg>
              </summary>
              <p class="pb-5 text-sm md:text-base opacity-70 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Checkout: the only place on the page that shows the price -->
    <section
      id="join"
      aria-labelledby="join-heading"
      data-sticky-bar-hide
      class="relative py-20 md:py-32 px-4 border-t border-current/10 text-center overflow-hidden scroll-mt-20"
    >
      <Image
        src={joinImg}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--pyre-blue)]/95 to-[var(--pyre-blue)]/70"></div>
      <div class="relative z-10 max-w-2xl mx-auto">
        <p class="font-mono-bold text-xs md:text-sm tracking-[0.2em] uppercase text-[var(--pyre-muted-gold)] mb-3">
          {join.eyebrow}
        </p>
        <h2 id="join-heading" class="font-primary-semibold text-[clamp(1.75rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-4">
          {join.heading}
        </h2>
        <p class="text-base md:text-lg opacity-90 mb-4">{join.body}</p>
        <FoundingCountdown class="mb-8" />

        <div class="max-w-md mx-auto border-2 border-[var(--pyre-gold)] bg-[var(--pyre-black)]/85 rounded-lg p-6 md:p-8 shadow-2xl">
          <div class="flex items-baseline justify-center gap-2 flex-wrap mb-2">
            <span class="text-lg opacity-50 line-through">${join.originalPrice}</span>
            <span class="font-primary-semibold text-5xl text-[var(--pyre-muted-gold)] leading-none">${join.price}</span>
            <span class="text-sm opacity-70">{join.period}</span>
          </div>
          <p class="inline-block rounded-full bg-[var(--pyre-muted-gold)]/15 px-2.5 py-1 font-mono-bold text-[10px] md:text-xs uppercase tracking-wide text-[var(--pyre-muted-gold)] mb-5">
            {join.savings}
          </p>
          <ul class="space-y-2 mb-6 text-left inline-block">
            {join.recap.map((item) => (
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-4 h-4 flex-shrink-0 mt-0.5 text-[var(--pyre-muted-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={check} />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <Button
            href={join.cta.href}
            variant="primary"
            size="lg"
            ariaLabel={join.cta.ariaLabel}
            data-track-placement="unlimited_join"
            class="w-full"
            target="_blank"
            rel="noopener noreferrer"
          >
            {join.cta.label}
          </Button>
          {join.finePrint && <p class="mt-3 text-xs opacity-60 italic">{join.finePrint}</p>}
        </div>

        <a
          href={join.intro.href}
          aria-label={join.intro.ariaLabel}
          data-track-placement="unlimited_join_intro"
          class="mt-8 inline-block text-sm underline underline-offset-4 opacity-80 hover:opacity-100"
        >
          {join.intro.label}
        </a>
      </div>
    </section>
  </div>

  <!-- Layout skips the sticky bar on hidePromos pages; this page wants it, founding first, pointing at the checkout step -->
  <StickyOfferBar mode="founding" foundingHref="#join" foundingAction="Join" placementPrefix="unlimited_sticky_bar" />
</Layout>

<CtaTracking />
