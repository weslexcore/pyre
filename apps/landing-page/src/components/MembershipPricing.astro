---
import membership from '../lib/membership';
import Button from './Button.astro';

const maxMobileFeatures = 3;
---

<section id="membership" aria-labelledby="membership-heading" class="py-8 md:py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-6 md:mb-12">
      <h2
        id="membership-heading"
        class="font-primary-semibold text-[clamp(1.75rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-2 md:mb-4"
      >
        {membership.title}
      </h2>
      {membership.subtitle && (
        <p class="text-base md:text-lg opacity-80">{membership.subtitle}</p>
      )}
      {membership.note && (
        <p class="text-xs md:text-sm opacity-60 mt-2 italic">{membership.note}</p>
      )}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-2 gap-3 md:gap-6 lg:gap-8 max-w-3xl mx-auto">
      {membership.tiers.map((tier) => (
        <div
          class={`pricing-card relative flex flex-col p-4 md:p-6 lg:p-8 border rounded-lg transition-all duration-300 ${
            tier.popular
              ? 'border-[var(--pyre-muted-gold)] bg-[var(--pyre-muted-gold)]/5 md:scale-105 shadow-lg'
              : 'border-current/20 hover:border-current/40'
          }`}
        >
          {tier.popular && (
            <div class="absolute -top-2.5 md:-top-3 left-1/2 -translate-x-1/2 px-2 md:px-3 py-0.5 md:py-1 bg-[var(--pyre-muted-gold)] text-[var(--pyre-black)] text-[10px] md:text-xs font-mono-bold uppercase tracking-wide rounded-full whitespace-nowrap">
              Most Popular
            </div>
          )}

          <div class="mb-3 md:mb-6">
            <h3 class="font-mono-bold text-sm md:text-xl uppercase tracking-wide mb-1 md:mb-2">
              {tier.name}
            </h3>
            <p class="text-xs md:text-sm opacity-70 line-clamp-2">{tier.description}</p>
          </div>

          <div class="mb-3 md:mb-6">
            <span class={`font-primary-semibold text-2xl md:text-[clamp(2.5rem,5vw,3.5rem)] leading-none ${tier.popular ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
              ${tier.price}
            </span>
            <span class="text-xs md:text-sm opacity-70">{tier.period}</span>
          </div>

          {/* Mobile: show limited features */}
          <ul class="space-y-2 mb-4 flex-grow md:hidden">
            {tier.features.slice(0, maxMobileFeatures).map((feature) => (
              <li class={`flex items-start gap-2 ${feature.highlighted ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
                <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs">{feature.text}</span>
              </li>
            ))}
          </ul>

          {/* Desktop: show all features */}
          <ul class="hidden md:block space-y-3 mb-8 flex-grow">
            {tier.features.map((feature) => (
              <li class={`flex items-start gap-3 ${feature.highlighted ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm">{feature.text}</span>
              </li>
            ))}
          </ul>

          <Button
            href={tier.cta.href}
            variant={tier.popular ? 'primary' : 'outline'}
            size="md"
            ariaLabel={tier.cta.ariaLabel}
            class="w-full text-xs md:text-base"
          >
            {tier.cta.label}
          </Button>
        </div>
      ))}
    </div>
  </div>
</section>
