---
import location from '../lib/location';
import HeroCarousel from './HeroCarousel.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
---

<!-- DESKTOP HERO: Fixed background layer for desktop parallax effect -->
<div class="fixed inset-0 z-0 bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
  <div id="nav-sentinel" class="absolute top-0 left-0 w-full h-1" aria-hidden="true"></div>

  <div class="h-screen grid grid-cols-[40%_60%]">
    <!-- Left: Location Info -->
    <div class="flex flex-col justify-between p-12">
      <!-- Location Name -->
      <div class="pt-20">
        <h1 class="font-logo text-[clamp(4rem,8vw,7rem)] tracking-[-0.03em] leading-[0.85] uppercase">
          {location.name}
        </h1>
        <h2
        class="text-3xl py-8"
      >
        SAUNA + COLD PLUNGE
      </h2>
      <h3
      class="text-2xl"
    >
      {location.tagline}
    </h3>
      </div>


      <!-- Contact Info -->
      <div class="space-y-6">
        <!-- Address -->
        <div>
          <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-1">Address</h2>
          <a href={location.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-lg hover:underline underline-offset-4">{location.address}</a>
        </div>

        <!-- Instagram -->
        <div>
          <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-1">Instagram</h2>
          <a
            href={location.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-lg hover:underline underline-offset-4"
          >
            <InstagramIcon class="size-[1.1em] shrink-0" />
            {location.instagram}
          </a>
        </div>

        <!-- Mailing List -->
        <div>
          <a href="#signup" class="text-lg hover:underline underline-offset-4 text-[var(--pyre-red)]" >Join Our Mailing List</a>
        </div>
      </div>

      <!-- Hours -->
      <!-- <div>
        <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-3">Soft Opening Hours</h2>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-base">
          {location.hours.map((h) => (
            <div class="flex justify-between">
              <span class="font-mono-bold opacity-80">{h.day}</span>
              <span>{h.open} - {h.close}</span>
            </div>
          ))}
        </div>
        <p class="text-xs opacity-60 mt-2">Last entry is 1 hour before closing</p>
      </div> -->
    </div>

    <!-- Right: Image -->
    <div class="relative h-full">
      <HeroCarousel />
    </div>
  </div>
</div>
