---
import location from '../lib/location';
import GoogleRatingBadge from './GoogleRatingBadge.astro';
import HeroOfferCta from './HeroOfferCta.astro';
import HeroVideo from './HeroVideo.astro';
---

<!-- DESKTOP HERO: Fixed background layer for desktop parallax effect -->
<div class="fixed inset-0 z-0 bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
  <div data-nav-sentinel class="absolute top-0 left-0 w-full h-1" aria-hidden="true"></div>

  <div class="h-screen grid grid-cols-[40%_60%]">
    <!-- Left: Location Info -->
    <div class="flex flex-col justify-between p-12">
      <!-- Location Name -->
      <div class="pt-20">
        <h1 class="font-logo text-[clamp(4rem,8vw,7rem)] tracking-[-0.03em] leading-[0.85] uppercase">
          {location.name}
        </h1>
        <h2
        class="text-3xl py-8"
      >
        SAUNA + COLD PLUNGE
      </h2>
      <h3
      class="text-2xl"
    >
      {location.tagline}
    </h3>
      </div>


      <!-- Offer CTAs + Google rating -->
      <div class="space-y-6">
        <HeroOfferCta role="desktop" />
        <GoogleRatingBadge placement="home_hero_google_rating_desktop" />
      </div>
    </div>

    <!-- Right: Video (keeps playing behind the content cards as they scroll up) -->
    <div class="relative h-full overflow-hidden">
      <HeroVideo priority={true} role="desktop" class="absolute inset-0" />
    </div>
  </div>
</div>
