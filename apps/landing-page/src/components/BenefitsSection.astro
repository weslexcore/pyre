---
import { Image } from 'astro:assets';
import plunging from '../assets/images/plunging.webp';
import benefits from '../lib/benefits';
import Button from './Button.astro';
import SectionDivider from './SectionDivider.astro';
---

<section id="benefits" aria-labelledby="benefits-heading" class="py-12 md:py-16 lg:py-0 px-4 lg:px-0 bg-[var(--pyre-black)]/5 lg:bg-transparent">
  <div class="max-w-6xl mx-auto lg:max-w-none">
 
        <!-- Header column -->
        <div class="text-center">
          <h2
            aria-hidden="true"
            class="font-primary-semibold text-[clamp(2rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-4"
          >
            {benefits.title}
          </h2>
          {benefits.subtitle && (
            <p class="text-sm opacity-80">{benefits.subtitle}</p>
          )}
          <SectionDivider variant="blob" revealAnimation="draw" visibleAnimation="pulse" class="w-48 my-4 mx-auto" scrollAware={true}/>
        </div>
 

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {benefits.items.map((benefit) => (
          <div class="benefit-card p-6 border border-current/10 rounded-lg">
            <h3 class="font-mono-bold text-lg uppercase tracking-wide mb-3">
              {benefit.title}
            </h3>
            <p class="leading-relaxed opacity-80">
              {benefit.description}
            </p>
          </div>
        ))}
      </div>

      {benefits.closing&& (
          <p class="mt-6 text-lg opacity-80 text-center">{benefits.closing}</p>
        )}

      {benefits.cta && (
        <div class="mt-8 text-center">
          <Button
            href={benefits.cta.href}
            variant="primary"
            size="lg"
            ariaLabel={benefits.cta.ariaLabel}
          >
            {benefits.cta.label}
          </Button>
        </div>
      )}
    </div>
  </div>
</section>
