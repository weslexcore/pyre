---
// Mobile-only bottom bar that keeps an offer one tap away. It appears once the
// visitor scrolls past the first screen (the homepage hero has its own CTAs),
// hides while the homepage offer section (or any `data-sticky-bar-hide`
// element) is on screen, and switches from the intro offer to the founding
// membership once the visitor has scrolled past the membership section. The
// founding variant is dropped after the founding offer ends. With
// `mode="founding"` (the /unlimited page) it leads with the founding
// membership the whole way and falls back to the intro after it ends; with
// `mode="intro"` (the /intro page) it only ever shows the intro. Neither
// variant shows a price: the links lead to the landing pages, or, via
// `introHref` / `foundingHref`, to a landing page's own checkout step.
import stickyOfferBar from '../lib/stickyOfferBar';

interface Props {
  mode?: 'intro-then-founding' | 'founding' | 'intro';
  /** Tracking placement prefix: "<prefix>_intro" / "<prefix>_founding". */
  placementPrefix?: string;
  /** Override the intro link and button label, e.g. "#claim" / "Claim" on the /intro page itself. */
  introHref?: string;
  introAction?: string;
  /** Override the founding link and button label, e.g. "#join" / "Join" on the /unlimited page itself. */
  foundingHref?: string;
  foundingAction?: string;
}

const {
  mode = 'intro-then-founding',
  placementPrefix = 'sticky_bar',
  introHref,
  introAction,
  foundingHref,
  foundingAction,
} = Astro.props;
const { endsAt } = stickyOfferBar;
const intro = {
  ...stickyOfferBar.intro,
  href: introHref ?? stickyOfferBar.intro.href,
  action: introAction ?? stickyOfferBar.intro.action,
};
const founding = {
  ...stickyOfferBar.founding,
  href: foundingHref ?? stickyOfferBar.founding.href,
  action: foundingAction ?? stickyOfferBar.founding.action,
};
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<div
  data-sticky-offer-bar
  data-ends-at={endsAt}
  data-mode={mode}
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-[var(--pyre-muted-gold)]/40 bg-[var(--pyre-black)]/95 px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] text-[var(--pyre-creme)] backdrop-blur transition-transform duration-300 motion-reduce:transition-none md:hidden"
  aria-hidden="true"
>
  {[
    { variant: 'intro', ...intro },
    { variant: 'founding', ...founding },
  ].map((option) => (
    <a
      href={option.href}
      target={isExternal(option.href) ? '_blank' : undefined}
      rel={isExternal(option.href) ? 'noopener noreferrer' : undefined}
      tabindex="-1"
      aria-label={option.ariaLabel}
      data-sticky-variant={option.variant}
      data-track-placement={`${placementPrefix}_${option.variant}`}
      class={`${option.variant === 'intro' ? 'flex' : 'hidden'} items-center justify-between gap-3`}
    >
      <span class="min-w-0">
        <span class="block font-mono-bold text-[10px] uppercase tracking-wider text-[var(--pyre-muted-gold)]">{option.eyebrow}</span>
        <span class="block truncate font-mono-bold text-sm uppercase tracking-wide">{option.label}</span>
      </span>
      <span class="shrink-0 rounded-md bg-[var(--pyre-muted-gold)] px-4 py-2.5 font-mono-bold text-xs uppercase tracking-wide text-[var(--pyre-black)]">
        {option.action}
      </span>
    </a>
  ))}
</div>

<script>
  function initStickyOfferBar(): (() => void) | undefined {
    const bar = document.querySelector<HTMLElement>('[data-sticky-offer-bar]');
    if (!bar) return;

    const introLink = bar.querySelector<HTMLElement>('[data-sticky-variant="intro"]');
    const foundingLink = bar.querySelector<HTMLElement>('[data-sticky-variant="founding"]');
    const foundingLive = Date.now() < Date.parse(bar.dataset.endsAt ?? '');
    const membership = document.getElementById('membership');
    const hideWhenVisible = document.querySelectorAll<HTMLElement>('#offer, [data-sticky-bar-hide]');

    const inView = new Set<Element>();
    let visible = false;

    const foundingFirst = bar.dataset.mode === 'founding';
    const introOnly = bar.dataset.mode === 'intro';

    function setVariant() {
      const showFounding =
        foundingLive &&
        !introOnly &&
        (foundingFirst || (!!membership && membership.getBoundingClientRect().top < 0));
      introLink?.classList.toggle('hidden', showFounding);
      introLink?.classList.toggle('flex', !showFounding);
      foundingLink?.classList.toggle('hidden', !showFounding);
      foundingLink?.classList.toggle('flex', showFounding);
    }

    function setVisible(next: boolean) {
      if (next === visible) return;
      visible = next;
      bar!.classList.toggle('translate-y-full', !next);
      bar!.setAttribute('aria-hidden', String(!next));
      bar!.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', next ? '0' : '-1'));
      // Keep the bar from covering the bottom of the page (e.g. the footer).
      document.body.style.paddingBottom = next ? `${bar!.offsetHeight}px` : '';
    }

    function update() {
      const pastFirstScreen = window.scrollY > window.innerHeight * 0.8;
      const popupOpen = document.body.style.overflow === 'hidden';
      setVisible(pastFirstScreen && inView.size === 0 && !popupOpen);
      setVariant();
    }

    let observer: IntersectionObserver | undefined;
    if (hideWhenVisible.length > 0) {
      observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inView.add(entry.target);
          else inView.delete(entry.target);
        }
        update();
      });
      hideWhenVisible.forEach((el) => observer!.observe(el));
    }

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    update();

    return () => {
      window.removeEventListener('scroll', onScroll);
      observer?.disconnect();
      document.body.style.paddingBottom = '';
    };
  }

  let cleanup: (() => void) | undefined;
  function boot() {
    cleanup?.();
    cleanup = initStickyOfferBar();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
</script>
