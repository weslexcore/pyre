---
// Client-side script to track Book CTA clicks with PostHog
---

<script>
  (function() {
    function setupBookingTracking() {
      const bookCTAs = document.querySelectorAll('.book-cta');
      
      bookCTAs.forEach((cta) => {
        cta.addEventListener('click', (event) => {
          const element = event.currentTarget as HTMLElement;
          const placement = element.getAttribute('data-placement') || 'unknown';
          const href = element.getAttribute('href');
          
          if (!href) return;

          // Get the final URL (after redirect)
          const finalUrl = new URL(href, window.location.origin);
          
          // Track the event with PostHog
          if ((window as any).posthog) {
            try {
              (window as any).posthog.capture('booking_link_clicked', {
                placement: placement,
                page_path: window.location.pathname,
                final_url: href,
                referrer: document.referrer,
                timestamp: new Date().toISOString(),
              });
            } catch (error) {
              console.error('Error tracking booking link click:', error);
            }
          }
        });
      });
    }

    // Initialize tracking when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupBookingTracking, { once: true });
    } else {
      setupBookingTracking();
    }

    // Re-initialize on page navigation (for SPAs)
    document.addEventListener('astro:page-load', setupBookingTracking);
  })();
</script>

