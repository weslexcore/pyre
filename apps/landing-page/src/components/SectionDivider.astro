---
interface Props {
  variant?: 'wave' | 'squiggle' | 'zigzag' | 'blob' | 'scallop' | 'torn';
  flip?: boolean;
  revealAnimation?: 'draw' | 'fade' | 'scale' | 'none';
  visibleAnimation?: 'wave' | 'pulse' | 'none';
  animate?: 'wave' | 'reveal' | 'none';  // deprecated, for backwards compat
  scrollAware?: boolean;  // Enable scroll-direction-aware reveal/hide
  strokeWidth?: number;  // Stroke width for the divider path (default: 3)
  class?: string;
}

const {
  variant = 'wave',
  flip = false,
  revealAnimation: revealAnimationProp,
  visibleAnimation: visibleAnimationProp,
  animate,
  scrollAware = false,
  strokeWidth = 3,
  class: className = ''
} = Astro.props;

// Handle backwards compatibility for deprecated `animate` prop
let revealAnimation = revealAnimationProp ?? 'none';
let visibleAnimation = visibleAnimationProp ?? 'none';

if (animate !== undefined) {
  // Map old animate values to new props (backwards compat)
  if (animate === 'wave') {
    visibleAnimation = visibleAnimationProp ?? 'wave';
  } else if (animate === 'reveal') {
    revealAnimation = revealAnimationProp ?? 'draw';
  }
}

const flipClass = flip ? 'rotate-180' : '';

// Build animation classes
const revealClass = revealAnimation !== 'none' ? `reveal-${revealAnimation}` : '';
const visibleClass = visibleAnimation !== 'none' ? `visible-${visibleAnimation}` : '';

// Check if a custom width class is passed, otherwise default to w-full
const hasCustomWidth = /\bw-\d+|\bw-\[/.test(className);
const widthClass = hasCustomWidth ? '' : 'w-full';
---

<div
  class:list={['section-divider h-12 md:h-16 lg:h-20 overflow-hidden w-75', widthClass, flipClass, revealClass, visibleClass, className]}
  data-reveal-animation={revealAnimation}
  data-visible-animation={visibleAnimation}
  data-animate={animate}
  data-scroll-aware={scrollAware ? 'true' : undefined}
>
  {variant === 'wave' && (
    <svg
      viewBox="0 0 1200 60"
      preserveAspectRatio="none"
      class="w-full h-full divider-svg"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,30 C100,10 200,50 300,30 C400,10 500,50 600,30 C700,10 800,50 900,30 C1000,10 1100,50 1200,30"
        stroke="var(--pyre-creme)"
        stroke-width={strokeWidth}
        stroke-linecap="round"
        class="divider-path"
      />
    </svg>
  )}

  {variant === 'squiggle' && (
    <svg
      viewBox="0 0 1200 60"
      preserveAspectRatio="none"
      class="w-full h-full divider-svg"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,30 Q50,15 75,30 T150,30 T225,30 T300,30 T375,30 T450,30 T525,30 T600,30 T675,30 T750,30 T825,30 T900,30 T975,30 T1050,30 T1125,30 T1200,30"
        stroke="var(--pyre-creme)"
        stroke-width={strokeWidth}
        stroke-linecap="round"
        class="divider-path"
      />
    </svg>
  )}

  {variant === 'zigzag' && (
    <svg
      viewBox="0 0 1200 60"
      preserveAspectRatio="none"
      class="w-full h-full divider-svg"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,45 L40,15 L80,45 L120,15 L160,45 L200,15 L240,45 L280,15 L320,45 L360,15 L400,45 L440,15 L480,45 L520,15 L560,45 L600,15 L640,45 L680,15 L720,45 L760,15 L800,45 L840,15 L880,45 L920,15 L960,45 L1000,15 L1040,45 L1080,15 L1120,45 L1160,15 L1200,45"
        stroke="var(--pyre-creme)"
        stroke-width={strokeWidth}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="divider-path"
      />
    </svg>
  )}

  {variant === 'blob' && (
    <svg
      viewBox="0 0 1200 60"
      preserveAspectRatio="none"
      class="w-full h-full divider-svg"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,30 C80,50 120,10 200,30 C280,50 320,15 400,25 C480,35 520,55 600,30 C680,5 720,45 800,35 C880,25 920,50 1000,30 C1080,10 1120,40 1200,30"
        stroke="var(--pyre-creme)"
        stroke-width={strokeWidth}
        stroke-linecap="round"
        class="divider-path"
      />
    </svg>
  )}

  {variant === 'scallop' && (
    <svg
      viewBox="0 0 1200 60"
      preserveAspectRatio="none"
      class="w-full h-full divider-svg"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,50 Q50,10 100,50 Q150,10 200,50 Q250,10 300,50 Q350,10 400,50 Q450,10 500,50 Q550,10 600,50 Q650,10 700,50 Q750,10 800,50 Q850,10 900,50 Q950,10 1000,50 Q1050,10 1100,50 Q1150,10 1200,50"
        stroke="var(--pyre-creme)"
        stroke-width={strokeWidth}
        stroke-linecap="round"
        class="divider-path"
      />
    </svg>
  )}

  {variant === 'torn' && (
    <svg
      viewBox="0 0 1200 60"
      preserveAspectRatio="none"
      class="w-full h-full divider-svg"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,35 L45,25 L70,40 L110,20 L150,45 L180,15 L230,38 L270,22 L320,42 L355,18 L400,35 L450,28 L490,48 L540,12 L580,40 L630,25 L680,45 L720,20 L770,38 L810,15 L860,42 L900,30 L950,48 L1000,18 L1040,35 L1090,25 L1130,45 L1170,20 L1200,32"
        stroke="var(--pyre-creme)"
        stroke-width={strokeWidth}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="divider-path"
      />
    </svg>
  )}
</div>

<style>
  /* Ensure SVG doesn't clip */
  .section-divider {
    line-height: 0;
  }

  /* ========================================
     REVEAL ANIMATIONS (one-time entrance)
     Triggered by .is-visible class
     ======================================== */

  /* Draw - stroke draws in */
  .reveal-draw .divider-path {
    stroke-dasharray: 3000;
    stroke-dashoffset: 3000;
    transition: stroke-dashoffset 2s ease-out;
  }
  .reveal-draw.is-visible .divider-path {
    stroke-dashoffset: 0;
  }

  /* Fade - opacity transition */
  .reveal-fade .divider-svg {
    opacity: 0;
    transition: opacity 1.5s ease-out;
  }
  .reveal-fade.is-visible .divider-svg {
    opacity: 1;
  }

  /* Scale - scales up horizontally */
  .reveal-scale .divider-svg {
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 1.5s ease-out;
  }
  .reveal-scale.is-visible .divider-svg {
    transform: scaleX(1);
  }

  /* ========================================
     VISIBLE ANIMATIONS (ongoing after reveal)
     Triggered by .is-revealed class
     ======================================== */

  /* Wave - subtle vertical undulation */
  @keyframes divider-wave {
    0%, 100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(1.5);
    }
  }

  .visible-wave.is-revealed .divider-svg {
    animation: divider-wave 3s ease-in-out infinite;
  }

  /* Pulse - opacity breathing */
  @keyframes divider-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }

  .visible-pulse.is-revealed .divider-svg {
    animation: divider-pulse 2s ease-in-out infinite;
  }

  /* ========================================
     IMMEDIATE VISIBLE ANIMATIONS
     For when there's no reveal animation
     ======================================== */

  /* If no reveal animation, start visible animation immediately */
  .visible-wave:not(.reveal-draw):not(.reveal-fade):not(.reveal-scale) .divider-svg {
    animation: divider-wave 3s ease-in-out infinite;
  }

  .visible-pulse:not(.reveal-draw):not(.reveal-fade):not(.reveal-scale) .divider-svg {
    animation: divider-pulse 2s ease-in-out infinite;
  }

  /* ========================================
     SCROLL-AWARE: Scroll-linked animations
     Progress tied directly to scroll position
     ======================================== */

  /* Disable CSS transitions for scroll-aware - JS controls the values directly */
  .reveal-draw[data-scroll-aware="true"] .divider-path {
    transition: none;
  }

  .reveal-fade[data-scroll-aware="true"] .divider-svg {
    transition: none;
  }

  .reveal-scale[data-scroll-aware="true"] .divider-svg {
    transition: none;
  }

  /* Reduced motion: instant state changes */
  @media (prefers-reduced-motion: reduce) {
    .reveal-draw[data-scroll-aware="true"] .divider-path,
    .reveal-fade[data-scroll-aware="true"] .divider-svg,
    .reveal-scale[data-scroll-aware="true"] .divider-svg {
      transition: none;
    }
  }
</style>

<script>
  // Reveal animation durations (ms) - matches CSS transition durations
  const revealDurations: Record<string, number> = {
    draw: 2000,   // 2s
    fade: 1500,   // 1.5s
    scale: 1500,  // 1.5s
    none: 0
  };

  // Select all section dividers that have any animation
  const animatedDividers = document.querySelectorAll(
    '.section-divider[data-reveal-animation]:not([data-reveal-animation="none"]), ' +
    '.section-divider[data-visible-animation]:not([data-visible-animation="none"])'
  );

  // Deprecation warning for old animate prop
  const deprecatedDividers = document.querySelectorAll('.section-divider[data-animate]:not([data-animate="none"])');
  if (deprecatedDividers.length > 0) {
    console.warn(
      '[SectionDivider] The "animate" prop is deprecated. ' +
      'Use "revealAnimation" and "visibleAnimation" props instead.'
    );
  }

  if (animatedDividers.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            const revealType = target.dataset.revealAnimation || 'none';
            const visibleType = target.dataset.visibleAnimation || 'none';

            // Add .is-visible immediately (starts reveal animation)
            target.classList.add('is-visible');

            // If there's a reveal animation, wait for it to complete before starting visible animation
            if (revealType !== 'none' && visibleType !== 'none') {
              const delay = revealDurations[revealType] || 0;
              setTimeout(() => {
                target.classList.add('is-revealed');
              }, delay);
            } else if (visibleType !== 'none') {
              // No reveal animation, start visible animation immediately
              target.classList.add('is-revealed');
            }

            // Stop observing this element
            observer.unobserve(target);
          }
        });
      },
      {
        threshold: 0.3,
        rootMargin: '0px 0px -50px 0px'
      }
    );

    animatedDividers.forEach((divider) => {
      // Skip scroll-aware dividers - they have their own observer
      if ((divider as HTMLElement).dataset.scrollAware !== 'true') {
        observer.observe(divider);
      }
    });
  }

  // ========================================
  // SCROLL-AWARE DIVIDERS
  // Animation progress tied to scroll position
  // ========================================

  const scrollAwareDividers = document.querySelectorAll(
    '.section-divider[data-scroll-aware="true"]'
  );

  if (scrollAwareDividers.length > 0) {
    const STROKE_LENGTH = 3000; // Matches stroke-dasharray in CSS

    // Calculate scroll progress for an element (0 = not visible, 1 = fully revealed)
    const getScrollProgress = (element: HTMLElement): number => {
      const rect = element.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // Start animating when element enters viewport (bottom of element at bottom of viewport)
      // Complete when element is ~30% up from the bottom of the viewport
      const startPoint = viewportHeight; // element just entering
      const endPoint = viewportHeight * 0.3; // element 30% up from bottom

      // Use the top of the element for calculation
      const elementTop = rect.top;

      if (elementTop >= startPoint) {
        return 0; // Not yet visible
      }
      if (elementTop <= endPoint) {
        return 1; // Fully revealed
      }

      // Linear interpolation between start and end
      return (startPoint - elementTop) / (startPoint - endPoint);
    };

    // Apply animation based on progress
    const applyScrollProgress = (divider: HTMLElement, progress: number) => {
      const revealType = divider.dataset.revealAnimation || 'none';
      const visibleType = divider.dataset.visibleAnimation || 'none';
      const path = divider.querySelector('.divider-path') as SVGPathElement | null;
      const svg = divider.querySelector('.divider-svg') as SVGElement | null;

      // Apply reveal animation based on type
      if (revealType === 'draw' && path) {
        // Draw: stroke-dashoffset goes from 3000 (hidden) to 0 (visible)
        const offset = STROKE_LENGTH * (1 - progress);
        path.style.strokeDashoffset = `${offset}`;
      } else if (revealType === 'fade' && svg) {
        // Fade: opacity goes from 0 to 1
        svg.style.opacity = `${progress}`;
      } else if (revealType === 'scale' && svg) {
        // Scale: scaleX goes from 0 to 1
        svg.style.transform = `scaleX(${progress})`;
      }

      // Handle visible animation (wave/pulse) - only when fully revealed
      if (progress >= 1 && visibleType !== 'none') {
        divider.classList.add('is-visible', 'is-revealed');
      } else {
        divider.classList.remove('is-visible', 'is-revealed');
      }
    };

    // Update all scroll-aware dividers
    let ticking = false;
    const updateScrollAwareDividers = () => {
      scrollAwareDividers.forEach((divider) => {
        const element = divider as HTMLElement;
        const progress = getScrollProgress(element);
        applyScrollProgress(element, progress);
      });
      ticking = false;
    };

    // Throttle with RAF
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateScrollAwareDividers);
        ticking = true;
      }
    }, { passive: true });

    // Initial calculation on load
    updateScrollAwareDividers();
  }
</script>
