---
import { Image } from 'astro:assets';
import type { ShopProduct } from '@/lib/types';

interface Props {
  product: ShopProduct;
}

const { product } = Astro.props;
const hasMultipleImages = product.images.length > 1;
const hasVariants = product.variants && product.variants.length > 0;

const allVariantsSoldOut = hasVariants && product.variants!.every((v) => v.soldOut);
const isSoldOut = product.soldOut || allVariantsSoldOut;

const Tag = isSoldOut ? 'div' : 'a';
const linkProps = isSoldOut
  ? { 'aria-disabled': 'true' }
  : { href: product.purchaseUrl, target: '_blank', rel: 'noopener noreferrer' };
---

<Tag
  {...linkProps}
  aria-label={isSoldOut ? `${product.name} — sold out` : `Buy ${product.name}`}
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-lg bg-[var(--pyre-creme)]/5',
    isSoldOut
      ? 'cursor-default'
      : 'transition-colors hover:bg-[var(--pyre-creme)]/8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-red)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--pyre-black)]',
  ]}
  data-product-card
>
  {/* Badge */}
  {product.badge && (
    <span
      class:list={[
        'absolute top-3 left-3 z-10 rounded-full px-3 py-1 font-mono text-xs font-bold uppercase tracking-wide',
        isSoldOut
          ? 'bg-[var(--pyre-creme)]/20 text-[var(--pyre-creme)]/50'
          : 'bg-[var(--pyre-red)] text-[var(--pyre-creme)]',
      ]}
    >
      {product.badge}
    </span>
  )}

  {/* Image gallery — stacked crossfade on hover */}
  <div class="relative aspect-square overflow-hidden" data-gallery>
    {product.images.map((image, i) => (
      <div
        class:list={[
          'absolute inset-0 transition-opacity duration-500 ease-in-out',
          i === 0 ? 'opacity-100' : 'opacity-0',
        ]}
        data-gallery-slide={i}
      >
        <Image
          src={image.src}
          alt={image.alt}
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          loading="lazy"
          decoding="async"
          class:list={[
            'h-full w-full object-cover',
            isSoldOut && 'opacity-50 grayscale',
          ]}
        />
      </div>
    ))}

    {/* Dot indicators */}
    {hasMultipleImages && (
      <div class="absolute bottom-2 left-1/2 z-10 flex -translate-x-1/2 gap-1.5" data-gallery-dots>
        {product.images.map((_, i) => (
          <span
            data-gallery-dot={i}
            class:list={[
              'h-1.5 rounded-full transition-all duration-300',
              i === 0
                ? 'w-3 bg-[var(--pyre-creme)]'
                : 'w-1.5 bg-[var(--pyre-creme)]/40',
            ]}
          />
        ))}
      </div>
    )}
  </div>

  {/* Details */}
  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex items-start justify-between gap-2">
      <h2 class="font-primary-semibold text-lg leading-tight text-[var(--pyre-creme)]">
        {product.name}
      </h2>
      <span class="shrink-0 font-mono text-sm font-bold text-[var(--pyre-creme)]/70">
        ${product.price}
      </span>
    </div>

    <p class="text-sm leading-relaxed text-[var(--pyre-creme)]/60">
      {product.description}
    </p>

    {/* Variants */}
    {hasVariants && (
      <div class="flex flex-wrap gap-1.5 pt-1">
        {product.variants!.map((variant) => (
          <span
            class:list={[
              'rounded-full border px-2.5 py-0.5 font-mono text-[0.65rem] font-bold uppercase tracking-wide transition-colors',
              variant.soldOut
                ? 'border-[var(--pyre-creme)]/10 text-[var(--pyre-creme)]/25 line-through'
                : 'border-[var(--pyre-creme)]/20 text-[var(--pyre-creme)]/70',
            ]}
          >
            {variant.name}
          </span>
        ))}
      </div>
    )}

    <div class="mt-auto pt-4">
      {isSoldOut ? (
        <span class="inline-block w-full rounded-full border border-[var(--pyre-creme)]/20 px-4 py-2.5 text-center font-mono text-xs font-bold uppercase tracking-wide text-[var(--pyre-creme)]/30">
          Sold Out
        </span>
      ) : (
        <span class="inline-block w-full rounded-full bg-[var(--pyre-red)] px-4 py-2.5 text-center font-mono text-xs font-bold uppercase tracking-wide text-[var(--pyre-creme)] transition-colors group-hover:bg-[var(--pyre-red)]/85">
          Buy Now
        </span>
      )}
    </div>
  </div>
</Tag>

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
      const slides = gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]');
      const dots = gallery.querySelectorAll<HTMLElement>('[data-gallery-dot]');
      if (slides.length < 2) return;

      const count = slides.length;
      let current = 0;

      function show(index: number) {
        current = ((index % count) + count) % count;
        slides.forEach((s, i) => {
          s.classList.toggle('opacity-100', i === current);
          s.classList.toggle('opacity-0', i !== current);
        });
        dots.forEach((d, i) => {
          d.classList.toggle('bg-[var(--pyre-creme)]', i === current);
          d.classList.toggle('w-3', i === current);
          d.classList.toggle('bg-[var(--pyre-creme)]/40', i !== current);
          d.classList.toggle('w-1.5', i !== current);
        });
      }

      gallery.addEventListener('mouseenter', () => show(current + 1));
      gallery.addEventListener('mouseleave', () => show(0));
    });
  }

  initGalleries();
  document.addEventListener('astro:after-swap', initGalleries);
</script>
