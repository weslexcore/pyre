---
import { Image } from 'astro:assets';
import type { ShopProduct } from '@/lib/types';

interface Props {
  product: ShopProduct;
}

const { product } = Astro.props;
const hasMultipleImages = product.images.length > 1;
const needsStockCheck = !!product.momenceId;
---

<a
  href={product.purchaseUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Buy ${product.name}`}
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-lg bg-[var(--pyre-creme)]/5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--pyre-red)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--pyre-black)]',
    needsStockCheck ? 'pointer-events-none' : 'hover:bg-[var(--pyre-creme)]/8',
  ]}
  data-product-card
  data-momence-id={product.momenceId}
  data-purchase-url={product.purchaseUrl}
>
  {/* Badge */}
  {product.badge && (
    <span
      class="absolute top-3 left-3 z-10 rounded-full px-3 py-1 font-mono text-xs font-bold uppercase tracking-wide bg-[var(--pyre-red)] text-[var(--pyre-creme)]"
      data-product-badge
    >
      {product.badge}
    </span>
  )}

  {/* Image gallery — stacked crossfade on hover */}
  <div class="relative aspect-square overflow-hidden" data-gallery data-product-images>
    {product.images.map((image, i) => (
      <div
        class:list={[
          'absolute inset-0 transition-opacity duration-500 ease-in-out',
          i === 0 ? 'opacity-100' : 'opacity-0',
        ]}
        data-gallery-slide={i}
      >
        <Image
          src={image.src}
          alt={image.alt}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
          data-product-img
        />
      </div>
    ))}

    {/* Dot indicators */}
    {hasMultipleImages && (
      <div class="absolute bottom-2 left-1/2 z-10 flex -translate-x-1/2 gap-1.5" data-gallery-dots>
        {product.images.map((_, i) => (
          <span
            data-gallery-dot={i}
            class:list={[
              'h-1.5 rounded-full transition-all duration-300',
              i === 0
                ? 'w-3 bg-[var(--pyre-creme)]'
                : 'w-1.5 bg-[var(--pyre-creme)]/40',
            ]}
          />
        ))}
      </div>
    )}
  </div>

  {/* Details */}
  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex items-start justify-between gap-2">
      <h2 class="font-primary-semibold text-lg leading-tight text-[var(--pyre-creme)]">
        {product.name}
      </h2>
      <span
        class="shrink-0 font-mono text-sm font-bold text-[var(--pyre-creme)]/70"
        data-product-price
      >
        ${product.price}
      </span>
    </div>

    {product.description && (
      <p class="text-sm leading-relaxed text-[var(--pyre-creme)]/60">
        {product.description}
      </p>
    )}

    {/* Variants — populated client-side from stock data */}
    <div class="flex flex-wrap gap-1.5 pt-1 empty:hidden" data-product-variants></div>

    <div class="mt-auto pt-4" data-product-cta>
      {needsStockCheck ? (
        <span class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-[var(--pyre-creme)]/20 px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-wide text-[var(--pyre-creme)]/40">
          <span class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-current border-t-transparent" />
          Checking stock
        </span>
      ) : (
        <span class="inline-block w-full rounded-full bg-[var(--pyre-red)] px-4 py-2.5 text-center font-mono text-xs font-bold uppercase tracking-wide text-[var(--pyre-creme)] transition-colors group-hover:bg-[var(--pyre-red)]/85">
          Buy Now
        </span>
      )}
    </div>
  </div>
</a>

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
      const slides = gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]');
      const dots = gallery.querySelectorAll<HTMLElement>('[data-gallery-dot]');
      if (slides.length < 2) return;

      const count = slides.length;
      let current = 0;

      function show(index: number) {
        current = ((index % count) + count) % count;
        slides.forEach((s, i) => {
          s.classList.toggle('opacity-100', i === current);
          s.classList.toggle('opacity-0', i !== current);
        });
        dots.forEach((d, i) => {
          d.classList.toggle('bg-[var(--pyre-creme)]', i === current);
          d.classList.toggle('w-3', i === current);
          d.classList.toggle('bg-[var(--pyre-creme)]/40', i !== current);
          d.classList.toggle('w-1.5', i !== current);
        });
      }

      // Desktop: hover to cycle
      gallery.addEventListener('mouseenter', () => show(current + 1));
      gallery.addEventListener('mouseleave', () => show(0));

      // Mobile: tap image to cycle (distinguish taps from scrolls)
      let touchStartY = 0;
      let touchStartX = 0;
      gallery.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }, { passive: true });

      gallery.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) < 15 && Math.abs(dy) < 15) {
          e.preventDefault();
          show(current + 1);
        }
      });
    });
  }

  initGalleries();
  document.addEventListener('astro:after-swap', initGalleries);
</script>
