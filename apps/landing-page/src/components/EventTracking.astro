---
// Client-side script to track Event link clicks with PostHog
---

<script>
  (function() {
    function setupEventTracking() {
      const eventLinks = document.querySelectorAll('a[href^="/event/"]');

      eventLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          const element = event.currentTarget as HTMLAnchorElement;
          const href = element.getAttribute('href');

          if (!href) return;

          // Parse the URL to extract event metadata
          const url = new URL(href, window.location.origin);
          const pathSegments = url.pathname.split('/').filter(Boolean); // Remove empty strings

          // Extract slug, date, and time from path segments
          // Expected pattern: /event/{slug}/{date}/{time}
          const eventSlug = pathSegments[1] || ''; // Index 0 is "event"
          const eventDate = pathSegments[2] || undefined;
          const eventTime = pathSegments[3] || undefined;

          // Track the event with PostHog
          if ((window as any).posthog) {
            try {
              (window as any).posthog.capture('event_link_clicked', {
                event_slug: eventSlug,
                event_date: eventDate,
                event_time: eventTime,
                page_path: window.location.pathname,
                final_url: href,
                referrer: document.referrer,
                timestamp: new Date().toISOString(),
              });
            } catch (error) {
              console.error('Error tracking event link click:', error);
            }
          }
        });
      });
    }

    // Initialize tracking when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupEventTracking, { once: true });
    } else {
      setupEventTracking();
    }

    // Re-initialize on page navigation (for SPAs)
    document.addEventListener('astro:page-load', setupEventTracking);
  })();
</script>
