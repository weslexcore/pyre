---
import pyreLogoRaw from '../assets/logos/pyre_logo.svg?raw';
import footerConfig from '../lib/footer';
import location from '../lib/location';
import { withBase } from '../lib/paths';
import { footerGrainGradient } from '../lib/shader-configs';
import RepeatingLogoBackground from './RepeatingLogoBackground.astro';
import ShaderCanvas from './ShaderCanvas.astro';
import SectionDivider from './SectionDivider.astro';
import InstagramIcon from './icons/InstagramIcon.astro';

function isExternalLink(href: string): boolean {
  return href.startsWith('http://') || href.startsWith('https://');
}

function isMailto(href: string): boolean {
  return href.startsWith('mailto:');
}

const pyreLogo = pyreLogoRaw.replace('<svg', '<svg class="h-full w-auto"');
---

<footer role="contentinfo" class="relative z-10 w-full mt-auto bg-[var(--pyre-black)] text-[var(--pyre-creme)] overflow-hidden">
  <!-- Repeating logo background pattern -->
  <RepeatingLogoBackground class="absolute inset-0 " />

  <!-- Grain Gradient shader overlay -->
  <ShaderCanvas
    shader="grain-gradient"
    config={footerGrainGradient}
    class="absolute inset-0 z-[1]"
    opacity={0.15}
    blendMode="screen"
    mobileEnabled={true}
  />

  <!-- Content layer (above background) -->
  <div class="relative z-10">
  <!-- Tagline Section -->
  {location.tagline && (
    <div class="py-10 md:py-16 px-4 text-center">
      <p class="font-primary-semibold text-[clamp(2rem,5vw,4rem)] tracking-[-0.02em] uppercase">
        {location.tagline}
      </p>
    </div>
  )}

  <SectionDivider variant="wave" flip revealAnimation="draw" visibleAnimation="wave" scrollAware={true} />

  <div class="mx-auto w-full px-4 py-12 sm:py-16 md:py-20 max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <!-- Brand & Contact -->
      <div class="lg:col-span-1">
        <a href={withBase('/')} class="inline-block mb-6" aria-label="Go to homepage">
          <span class="inline-block h-20 w-auto text-[var(--pyre-creme)]" role="img" aria-label="Pyre Sauna logo" set:html={pyreLogo} />
        </a>
        <div class="space-y-3 text-sm">
          <a href={location.mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4">{location.address}</a>
          <p>
            <a href={`tel:${location.phone.replace(/[^0-9+]/g, '')}`} class="hover:underline underline-offset-4">
              {location.phone}
            </a>
          </p>
          <p>
            <a href={location.instagramUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:underline underline-offset-4">
              <InstagramIcon class="size-4 shrink-0" />
              {location.instagram}
            </a>
          </p>
        </div>
      </div>

      <!-- Hours -->
      <div class="lg:col-span-1">
        <h3 class="font-mono-bold uppercase tracking-wide text-sm mb-4">Soft Opening Hours</h3>
        <div class="space-y-1 text-sm">
          {location.hours.map((h) => (
            <div class="flex justify-between max-w-[200px]">
              <span class="opacity-70">{h.day}</span>
              <span>{h.open} - {h.close}</span>
            </div>
          ))}
          <p class="text-xs opacity-60 mt-2">Last entry is 1 hour before closing</p>
        </div>
      </div>

      <!-- Navigation Groups -->
      {footerConfig.groups && footerConfig.groups.length > 0 && (
        footerConfig.groups.slice(0, 2).map((group) => (
          <nav aria-label={`Footer - ${group.title}`}>
            <h3 class="font-mono-bold uppercase tracking-wide text-sm mb-4">{group.title}</h3>
            <ul class="space-y-2 text-sm">
              {group.links.map((link) => {
                const href = link.href;
                const ariaLabel = link.ariaLabel ?? (isMailto(href) ? `Email ${href.replace('mailto:', '')}` : undefined);
                const isExternal = isExternalLink(href);
                const isBookLink = link.label.includes('Book') || link.href.includes('/book');

                return (
                  <li>
                    <a
                      href={href}
                      aria-label={ariaLabel}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                      class={`hover:underline underline-offset-4 opacity-80 hover:opacity-100 ${isBookLink ? 'book-cta' : ''}`}
                      data-placement={isBookLink ? 'footer' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        ))
      )}
    </div>

    <!-- Certification & Legal -->
    <div class="mt-12 pt-8 border-t border-[var(--pyre-creme)]/10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex flex-wrap items-center gap-6">
        {footerConfig.certifications && footerConfig.certifications.map((cert) => (
          <a
            href={cert.link}
            aria-label={cert.ariaLabel}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block hover:opacity-80 transition-opacity"
          >
            <img
              src={cert.image.src}
              alt={cert.image.alt || cert.title}
              width="60"
              height="60"
              class="h-14 w-auto"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}

        <!-- Legal links -->
        {footerConfig.groups && footerConfig.groups.find(g => g.title === 'Legal') && (
          <div class="flex flex-wrap items-center gap-4 text-xs opacity-60">
            {footerConfig.groups.find(g => g.title === 'Legal')?.links.map((link, index) => (
              <>
                {index > 0 && <span>|</span>}
                <a href={link.href} class="hover:opacity-100 hover:underline underline-offset-2">
                  {link.label}
                </a>
              </>
            ))}
          </div>
        )}
      </div>

      <div class="text-xs opacity-60">
        {footerConfig.elements.copyright}
      </div>
    </div>
  </div>
  </div>
</footer>
