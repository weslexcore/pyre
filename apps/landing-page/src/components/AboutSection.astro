---
import { Image } from 'astro:assets';
import about from '../lib/about';
import Button from './Button.astro';
import SectionDivider from './SectionDivider.astro';
import warmSauna from '../assets/images/warm_sauna.jpg';
---

<section id="about" aria-labelledby="about-heading" class="py-12 md:py-16 lg:py-0 px-4 lg:px-0">
  <div class="max-w-3xl mx-auto lg:max-w-none grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-6 lg:gap-8 items-start">
    <!-- Image column -->
    <div class="aspect-[3/4] overflow-hidden rounded-lg">
      <Image
        src={warmSauna}
        alt="People enjoying a social sauna session"
        class="w-full h-full object-cover object-center"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Text column -->
    <div>
      <h2
        id="about-heading"
        class="font-primary-semibold text-[clamp(1.25rem,3vw,2rem)] lg:text-[clamp(1.75rem,3vw,2.5rem)] tracking-[-0.02em] uppercase mb-4"
      >
        {about.title}
      </h2>

      <SectionDivider variant="wave" revealAnimation="draw" visibleAnimation="pulse" class="hidden lg:block w-48 my-4 mx-auto" scrollAware={true}/>

      <div class="space-y-3 lg:space-y-4 text-sm lg:text-base leading-relaxed">
        {about.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        {about.expandedBody && about.expandedBody.length > 0 && (
          <div
            id="about-expanded"
            class="about-expanded space-y-3 lg:space-y-4 overflow-hidden transition-all duration-500 ease-out"
            style="max-height: 0; opacity: 0;"
          >
            {about.expandedBody.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}
      </div>

      {about.expandedBody && about.expandedBody.length > 0 && (
        <button
          type="button"
          id="about-toggle"
          class="mt-4 font-mono-bold text-xs lg:text-sm uppercase tracking-wide underline underline-offset-4 hover:no-underline focus:no-underline transition-colors"
          aria-expanded="false"
          aria-controls="about-expanded"
        >
          Read more
        </button>
      )}

      {about.cta && (
        <div class="mt-4 lg:mt-6">
          <Button
            href={about.cta.href}
            variant="outline"
            size="sm"
            class="lg:!py-2 lg:!px-4"
            ariaLabel={about.cta.ariaLabel}
          >
            {about.cta.label}
          </Button>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  (function() {
    let cleanup: (() => void) | null = null;

    function initAboutToggle() {
      if (cleanup) {
        cleanup();
      }

      const toggle = document.getElementById('about-toggle');
      const expanded = document.getElementById('about-expanded');

      if (!toggle || !expanded) {
        cleanup = () => {};
        return;
      }

      const handleClick = () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          expanded.style.maxHeight = '0';
          expanded.style.opacity = '0';
          toggle.setAttribute('aria-expanded', 'false');
          toggle.textContent = 'Read more';
        } else {
          expanded.style.maxHeight = expanded.scrollHeight + 'px';
          expanded.style.opacity = '1';
          toggle.setAttribute('aria-expanded', 'true');
          toggle.textContent = 'Read less';
        }
      };

      toggle.addEventListener('click', handleClick);
      cleanup = () => {
        toggle.removeEventListener('click', handleClick);
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAboutToggle, { once: true });
    } else {
      initAboutToggle();
    }

    // Re-initialize after view transitions
    document.addEventListener('astro:page-load', initAboutToggle);
  })();
</script>
