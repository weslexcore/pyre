---
import { getImage } from 'astro:assets';
import community1 from '../assets/images/community_1.webp';
import community2 from '../assets/images/community_2.webp';
import community3 from '../assets/images/community_3.webp';
import testimonials from '../lib/testimonials';
import Button from './Button.astro';
import SectionDivider from './SectionDivider.astro';

const photoSources = [
  { src: community1, alt: 'Community gathering at Pyre' },
  { src: community2, alt: 'Pyre member sharing a moment of connection' },
  { src: community3, alt: 'Friends after a contrast therapy session' },
];

const photos = await Promise.all(
  photoSources.map(async ({ src, alt }) => {
    const optimized = await getImage({ src, width: 600, height: 750, fit: 'cover' });
    return { src: optimized.src, alt };
  })
);

const entries = [];
const maxEntries = Math.max(testimonials.items.length, photos.length);
for (let index = 0; index < maxEntries; index += 1) {
  if (index < testimonials.items.length) {
    entries.push({ kind: 'testimonial', item: testimonials.items[index] });
  }
  if (index < photos.length) {
    entries.push({ kind: 'photo', item: photos[index] });
  }
}
---

<section id="testimonials" aria-labelledby="testimonials-heading" class="py-12 md:py-16 lg:py-0 px-4 lg:px-0 bg-[var(--pyre-black)]/5 lg:bg-transparent">

  <div class="max-w-5xl mx-auto lg:max-w-none">
     <div class="text-center mb-8">
      <h2
        id="testimonials-heading"
        class="font-primary-semibold text-[clamp(1.25rem,3vw,2rem)] tracking-[-0.02em] uppercase mb-3"
      >
        {testimonials.title}
      </h2>
      {testimonials.subtitle && (
        <p class="text-sm opacity-80">{testimonials.subtitle}</p>
      )}
      <SectionDivider variant="blob" revealAnimation="draw" visibleAnimation="pulse" class="mx-auto w-72 my-4" scrollAware={true}/>

      <div class="testimonials-container -mx-4 px-4 md:-mx-6 md:px-6">
        <div class="testimonials-scroll flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4">
          {entries.map((entry) => (
            entry.kind === 'testimonial' ? (
              <article
                class:list={[
                  'testimonial-card flex-shrink-0 w-[280px] md:w-[300px] min-h-[430px] md:min-h-0 md:aspect-[4/5] snap-start rounded-lg overflow-hidden p-6 flex flex-col transition-all duration-300',
                  entry.item.highlight
                    ? 'border border-[var(--pyre-gold)] bg-[var(--pyre-gold)]/5'
                    : 'border border-current/10',
                ]}
              >
                <div
                  class="flex justify-center gap-0.5 mb-3 text-[var(--pyre-gold)]"
                  aria-label="5 out of 5 stars"
                >
                  {Array.from({ length: 5 }).map(() => (
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <blockquote class="mb-4 flex-1">
                  <p class="italic leading-relaxed opacity-90">"{entry.item.quote}"</p>
                </blockquote>
                <footer>
                  <cite class="not-italic">
                    <span class="font-mono-bold text-sm block">{entry.item.name}</span>
                    {entry.item.sessionType && (
                      <span class="font-mono-bold text-xs uppercase tracking-wide opacity-60 block mt-1">
                        {entry.item.sessionType}
                      </span>
                    )}
                  </cite>
                </footer>
              </article>
            ) : (
              <div class="testimonial-photo flex-shrink-0 w-[280px] md:w-[300px] h-[430px] md:h-auto md:aspect-[4/5] snap-start rounded-lg overflow-hidden border border-current/10">
                <img
                  src={entry.item.src}
                  alt={entry.item.alt}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )
          ))}
        </div>
      </div>

      {testimonials.closing && (
        <p class="mt-6 text-base opacity-80 text-center">{testimonials.closing}</p>
      )}

      {testimonials.cta && (
        <div class="mt-8 text-center">
          <Button
            href={testimonials.cta.href}
            variant="cta"
            size="lg"
            ariaLabel={testimonials.cta.ariaLabel}
          >
            {testimonials.cta.label}
          </Button>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .testimonials-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .testimonials-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
