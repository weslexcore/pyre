---
import about from '../lib/about';
import Button from './Button.astro';
---

<div id="about" aria-labelledby="about-heading">
  <h2
    id="about-heading"
    class="font-primary-semibold text-[clamp(1.75rem,3vw,2.5rem)] tracking-[-0.02em] uppercase mb-6"
  >
    {about.title}
  </h2>

  <div class="space-y-4 text-base leading-relaxed">
    {about.body.map((paragraph) => (
      <p>{paragraph}</p>
    ))}

    {about.expandedBody && about.expandedBody.length > 0 && (
      <div
        id="about-expanded-desktop"
        class="about-expanded space-y-4 overflow-hidden transition-all duration-500 ease-out"
        style="max-height: 0; opacity: 0;"
      >
        {about.expandedBody.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    )}
  </div>

  {about.expandedBody && about.expandedBody.length > 0 && (
    <button
      type="button"
      id="about-toggle-desktop"
      class="mt-4 font-mono-bold text-sm uppercase tracking-wide underline underline-offset-4 hover:no-underline focus:no-underline transition-colors"
      aria-expanded="false"
      aria-controls="about-expanded-desktop"
    >
      Read more
    </button>
  )}

  {about.cta && (
    <div class="mt-6">
      <Button
        href={about.cta.href}
        variant="outline"
        size="md"
        ariaLabel={about.cta.ariaLabel}
      >
        {about.cta.label}
      </Button>
    </div>
  )}
</div>

<script>
  function initAboutToggleDesktop() {
    const toggle = document.getElementById('about-toggle-desktop');
    const expanded = document.getElementById('about-expanded-desktop');

    if (!toggle || !expanded) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        expanded.style.maxHeight = '0';
        expanded.style.opacity = '0';
        toggle.setAttribute('aria-expanded', 'false');
        toggle.textContent = 'Read more';
      } else {
        expanded.style.maxHeight = expanded.scrollHeight + 'px';
        expanded.style.opacity = '1';
        toggle.setAttribute('aria-expanded', 'true');
        toggle.textContent = 'Read less';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutToggleDesktop, { once: true });
  } else {
    initAboutToggleDesktop();
  }
</script>
