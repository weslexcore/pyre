---
import { Image } from "astro:assets";
import logo from "../assets/logos/creme/logo_with_text.png";
import navbar from "../lib/navbar";
import { withBase } from "../lib/paths";
import Button from "./Button.astro";

const basePath = import.meta.env.PUBLIC_ASTRO_BASE || "/";
---

<header
  data-component="navbar"
  class="fixed inset-x-0 top-0 z-50 bg-transparent transition-colors duration-300 motion-reduce:transition-none"
>
  <div class="w-full px-4 flex items-center justify-between gap-4 py-4">
    <a href={withBase('')} aria-label={navbar.elements.ariaLabel} class="inline-flex">
      <Image
        src={logo}
        alt={"Pyre Sauna logo"}
        width="512"
        height="128"
        class="h-8 md:h-12 w-auto"
        loading="eager"
        decoding="sync"
      />
    </a>
    
    <!-- Desktop navigation -->
    <div class="hidden md:flex items-center gap-3">
      <Button href={navbar.actions?.secondary?.href} variant="primary" size="sm" ariaLabel={navbar.actions?.secondary?.ariaLabel} class="book-cta" data-placement="header">{navbar.actions?.secondary?.label}</Button>
      <Button href={navbar.actions?.primary?.href} variant="outline" size="sm" ariaLabel={navbar.actions?.primary?.ariaLabel}>{navbar.actions?.primary?.label}</Button>
    </div>
    <div class="md:hidden flex items-center gap-3">
    <Button href={navbar.actions?.secondary?.href} variant="primary" size="sm" ariaLabel={navbar.actions?.secondary?.ariaLabel} class="book-cta" data-placement="mobile_nav">Book</Button>
    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      aria-label="Toggle mobile menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden inline-flex items-center justify-center p-2 text-[var(--primary-foreground)] hover:bg-[var(--accent)] rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] relative"
    >
      <!-- Hamburger icon -->
      <svg id="hamburger-icon" class="w-6 h-6 transition-all duration-300 ease-in-out opacity-100 scale-100 rotate-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <!-- Close icon -->
      <svg id="close-icon" class="w-6 h-6 absolute transition-all duration-300 ease-in-out opacity-0 scale-0 rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="md:hidden bg-black border-t border-[var(--border)] overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0"
  >
    <div class="px-4 py-4 flex flex-col gap-3">
      <Button href={navbar.actions?.secondary?.href} variant="primary" size="sm" ariaLabel={navbar.actions?.secondary?.ariaLabel} class="w-full book-cta" data-placement="mobile_nav">{navbar.actions?.secondary?.label}</Button>
      <Button href={navbar.actions?.primary?.href} variant="outline" size="sm" ariaLabel={navbar.actions?.primary?.ariaLabel} class="w-full">{navbar.actions?.primary?.label}</Button>
    </div>
  </nav>
</header>

<script is:inline define:vars={{ basePath }}>
  (function () {
    const SCROLLED_CLASSES = ['bg-black', 'backdrop-blur', 'shadow'];

    function applyScrolledState(navbar, isScrolled) {
      if (!navbar) return;
      if (isScrolled) {
        navbar.classList.remove('bg-transparent');
        navbar.classList.add(...SCROLLED_CLASSES);
      } else {
        navbar.classList.remove(...SCROLLED_CLASSES);
        navbar.classList.add('bg-transparent');
      }
    }

    function setupMobileMenu() {
      const menuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const navbar = document.querySelector('[data-component="navbar"]');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');
      
      if (!menuButton || !mobileMenu || !navbar || !hamburgerIcon || !closeIcon) return;

      function toggleMenu(shouldOpen) {
        menuButton.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
        
        if (shouldOpen) {
          // Force black background when menu is open
          navbar.classList.remove('bg-transparent');
          navbar.classList.add('bg-black');
          // Slide menu down
          mobileMenu.classList.remove('max-h-0', 'opacity-0');
          mobileMenu.classList.add('max-h-96', 'opacity-100');
          // Animate icon transition - hide hamburger, show close
          hamburgerIcon.classList.remove('opacity-100', 'scale-100', 'rotate-0');
          hamburgerIcon.classList.add('opacity-0', 'scale-0', '-rotate-90');
          closeIcon.classList.remove('opacity-0', 'scale-0', 'rotate-90');
          closeIcon.classList.add('opacity-100', 'scale-100', 'rotate-0');
        } else {
          // Slide menu up
          mobileMenu.classList.remove('max-h-96', 'opacity-100');
          mobileMenu.classList.add('max-h-0', 'opacity-0');
          // Restore appropriate background based on scroll position
          const isScrolled = window.scrollY > 0;
          applyScrolledState(navbar, isScrolled);
          // Animate icon transition - show hamburger, hide close
          hamburgerIcon.classList.remove('opacity-0', 'scale-0', '-rotate-90');
          hamburgerIcon.classList.add('opacity-100', 'scale-100', 'rotate-0');
          closeIcon.classList.remove('opacity-100', 'scale-100', 'rotate-0');
          closeIcon.classList.add('opacity-0', 'scale-0', 'rotate-90');
        }
      }

      menuButton.addEventListener('click', () => {
        const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
        toggleMenu(!isExpanded);
      });

      // Close menu when clicking outside
      document.addEventListener('click', (event) => {
        if (!menuButton.contains(event.target) && !mobileMenu.contains(event.target)) {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            toggleMenu(false);
          }
        }
      });
    }

    function setup() {
      const navbar = document.querySelector('[data-component="navbar"]');
      const isLandingPage = window.location.pathname === basePath;
      if (!navbar) return;
      if (!isLandingPage) {
        applyScrolledState(navbar, true);
        return;
      }
      const sentinel = document.getElementById('nav-sentinel');

      if (!navbar) return;

      if (sentinel) {
        const observer = new IntersectionObserver((entries) => {
          const entry = entries[0];
          applyScrolledState(navbar, !entry.isIntersecting);
        }, { root: null, threshold: 0 });
        observer.observe(sentinel);
        // Initialize state synchronously in case the observer callback hasn't fired yet
        // If sentinel is outside the viewport at load, reflect scrolled state
        applyScrolledState(navbar, window.scrollY > 0);
      } else {
        // Fallback: scroll listener
        let ticking = false;
        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              applyScrolledState(navbar, window.scrollY > 0);
              ticking = false;
            });
            ticking = true;
          }
        }
        applyScrolledState(navbar, window.scrollY > 0);
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // Setup mobile menu
      setupMobileMenu();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup, { once: true });
    } else {
      setup();
    }
  })();
</script>
