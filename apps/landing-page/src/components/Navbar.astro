---
import { Image } from 'astro:assets';
import logo from '../assets/logos/red/logo.png';
import navbar from '../lib/navbar';
import { withBase } from '../lib/paths';
import Button from './Button.astro';

interface Props {
  isHomePage?: boolean;
  transparentNav?: boolean;
  darkLogoText?: boolean;
}

const { isHomePage = false, transparentNav = false, darkLogoText = false } = Astro.props;
---

<header
  data-component="navbar"
  data-at-top="true"
  data-transparent-nav={transparentNav ? 'true' : 'false'}
  class:list={[
    "fixed inset-x-0 top-0 z-50 transition-colors duration-300 motion-reduce:transition-none",
    transparentNav
      ? "bg-transparent data-[at-top=false]:max-lg:bg-[var(--pyre-black)]"
      : "bg-[var(--pyre-black)]"
  ]}
>
  <!-- Mobile gradient overlay - visible when navbar has dark background (mobile only) -->
  <div
    class="navbar-gradient absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
    data-navbar-gradient="mobile"
  ></div>

  <div class="w-full px-4 md:px-6 flex items-center justify-between gap-4 py-3 md:py-4">
    <!-- Logo -->
    <a href={withBase('')} aria-label={navbar.elements.ariaLabel} class="inline-flex items-center gap-3 flex-shrink-0">
      <Image
        src={logo}
        alt="Pyre Sauna logo"
        width="128"
        height="128"
        class="h-8 md:h-10 w-auto"
        loading="eager"
        decoding="sync"
      />
      {!isHomePage && (
        <p class:list={[
          "font-logo text-5xl",
          darkLogoText ? "text-[var(--pyre-black)]" : "text-[var(--pyre-creme)]"
        ]}>PYRE</p>
      )}
    </a>

    <!-- Desktop navigation links -->
    <nav class="hidden md:flex items-center gap-6 bg-[var(--pyre-black)] px-8 py-4 relative overflow-hidden rounded-xl" aria-label="Main navigation">
      <!-- Desktop gradient overlay - always visible on desktop nav -->
      <div
        class="navbar-gradient absolute inset-0 pointer-events-none opacity-50"
        aria-hidden="true"
        data-navbar-gradient="desktop"
      ></div>
      {navbar.elements.links && navbar.elements.links.map((link) => (
        <a
          href={link.href}
          aria-label={link.ariaLabel}
          class="font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] hover:opacity-70 transition-opacity relative z-10"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTAs -->
    <div class="hidden md:flex items-center gap-3">
      <Button
        href={navbar.actions?.login?.href}
        variant="secondary"
        size="lg"
        ariaLabel={navbar.actions?.login?.ariaLabel}
      >
        {navbar.actions?.login?.label}
      </Button>
      <Button
        href={navbar.actions?.secondary?.href}
        variant="cta"
        size="lg"
        ariaLabel={navbar.actions?.secondary?.ariaLabel}
        class="book-cta"
        data-placement="header"
      >
        {navbar.actions?.secondary?.label}
      </Button>
    </div>

    <!-- Mobile CTA + menu button -->
    <div class="flex md:hidden items-center gap-2">
      <!-- <Button
        href={navbar.actions?.login?.href}
        variant="secondary"
        size="sm"
        ariaLabel={navbar.actions?.login?.ariaLabel}
      >
        {navbar.actions?.login?.label}
      </Button> -->
      <Button
        href={navbar.actions?.secondary?.href}
        variant="cta"
        size="sm"
        ariaLabel={navbar.actions?.secondary?.ariaLabel}
        class="book-cta"
        data-placement="header_mobile"
      >
        {navbar.actions?.secondary?.label}
      </Button>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden inline-flex items-center justify-center p-2 text-[var(--pyre-creme)] hover:opacity-70 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] relative"
    >
      <!-- Hamburger icon -->
      <svg id="hamburger-icon" class="w-6 h-6 transition-all duration-300 ease-in-out opacity-100 scale-100 rotate-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <!-- Close icon -->
      <svg id="close-icon" class="w-6 h-6 absolute transition-all duration-300 ease-in-out opacity-0 scale-0 rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="md:hidden bg-[var(--pyre-black)] border-t border-[var(--pyre-creme)]/10 overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0"
  >
    <div class="px-4 py-4 flex flex-col gap-3">
      {navbar.elements.links && navbar.elements.links.map((link) => (
        <a
          href={link.href}
          aria-label={link.ariaLabel}
          class="font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] py-2 hover:opacity-70 transition-opacity"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 border-t border-[var(--pyre-creme)]/10 flex flex-row gap-3">
        <Button
          href={navbar.actions?.login?.href}
          variant="secondary"
          size="lg"
          ariaLabel={navbar.actions?.login?.ariaLabel}
          class="w-full"
        >
          {navbar.actions?.login?.label}
        </Button>
        <Button
          href={navbar.actions?.secondary?.href}
          variant="cta"
          size="lg"
          ariaLabel={navbar.actions?.secondary?.ariaLabel}
          class="w-full book-cta"
          data-placement="mobile_nav"
        >
          {navbar.actions?.secondary?.label}
        </Button>
      </div>
    </div>
  </nav>
</header>

<style>
  @keyframes gradient-drift {
    0%, 100% {
      --anim-progress: 0;
    }
    50% {
      --anim-progress: 1;
    }
  }

  @property --anim-progress {
    syntax: '<number>';
    initial-value: 0;
    inherits: false;
  }

  .navbar-gradient {
    animation: gradient-drift 15s ease-in-out infinite;

    /* Multiple layered gradients for depth - matching ScrollGradientOverlay */
    background:
      /* Pyre Red - warm glow moving right and down */
      radial-gradient(
        ellipse 100% 80% at calc(10% + var(--anim-progress) * 70%) calc(20% + var(--anim-progress) * 30%),
        oklch(0.65 0.18 25 / 0.4) 0%,
        transparent 55%
      ),
      /* Pyre Blue (deep) - moves from right to left */
      radial-gradient(
        ellipse 90% 70% at calc(95% - var(--anim-progress) * 60%) calc(60% + var(--anim-progress) * 20%),
        oklch(0.35 0.15 220 / 0.6) 0%,
        transparent 55%
      ),
      /* Pyre Sky (lighter blue) - drifts up from bottom left */
      radial-gradient(
        ellipse 85% 65% at calc(15% + var(--anim-progress) * 35%) calc(90% - var(--anim-progress) * 50%),
        oklch(0.62 0.12 230 / 0.55) 0%,
        transparent 55%
      ),
      /* Pyre Gold - sweeps diagonally across */
      radial-gradient(
        ellipse 90% 70% at calc(5% + var(--anim-progress) * 90%) calc(50% - var(--anim-progress) * 20%),
        oklch(0.78 0.15 85 / 0.55) 0%,
        transparent 55%
      ),
      /* Secondary Gold - moves opposite direction */
      radial-gradient(
        ellipse 75% 60% at calc(80% - var(--anim-progress) * 50%) calc(25% + var(--anim-progress) * 45%),
        oklch(0.78 0.15 85 / 0.5) 0%,
        transparent 50%
      ),
      /* Secondary Blue - subtle accent moving vertically */
      radial-gradient(
        ellipse 70% 55% at calc(50% + var(--anim-progress) * 25%) calc(10% + var(--anim-progress) * 60%),
        oklch(0.45 0.16 220 / 0.5) 0%,
        transparent 50%
      ),
      /* Pyre Sage - organic undertone drifting */
      radial-gradient(
        ellipse 75% 50% at calc(30% + var(--anim-progress) * 40%) calc(70% - var(--anim-progress) * 25%),
        oklch(0.65 0.06 130 / 0.25) 0%,
        transparent 50%
      );

    /* Screen blend mode works well over dark backgrounds */
    mix-blend-mode: screen;

    /* Smooth fade for visibility changes */
    transition: opacity 0.3s ease-out;
  }

  /* Accessibility: Pause animation for reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .navbar-gradient {
      animation: none;
      --anim-progress: 0.5;
    }
  }
</style>

<script>
  (function () {
    function setupMobileMenu() {
      const menuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (!menuButton || !mobileMenu || !hamburgerIcon || !closeIcon) return;

      function toggleMenu(shouldOpen: boolean) {
        menuButton.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');

        if (shouldOpen) {
          mobileMenu.classList.remove('max-h-0', 'opacity-0');
          mobileMenu.classList.add('max-h-[80vh]', 'opacity-100');
          hamburgerIcon.classList.remove('opacity-100', 'scale-100', 'rotate-0');
          hamburgerIcon.classList.add('opacity-0', 'scale-0', '-rotate-90');
          closeIcon.classList.remove('opacity-0', 'scale-0', 'rotate-90');
          closeIcon.classList.add('opacity-100', 'scale-100', 'rotate-0');
        } else {
          mobileMenu.classList.remove('max-h-[80vh]', 'opacity-100');
          mobileMenu.classList.add('max-h-0', 'opacity-0');
          hamburgerIcon.classList.remove('opacity-0', 'scale-0', '-rotate-90');
          hamburgerIcon.classList.add('opacity-100', 'scale-100', 'rotate-0');
          closeIcon.classList.remove('opacity-100', 'scale-100', 'rotate-0');
          closeIcon.classList.add('opacity-0', 'scale-0', 'rotate-90');
        }
      }

      menuButton.addEventListener('click', () => {
        const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
        toggleMenu(!isExpanded);
      });

      // Close menu when clicking outside
      document.addEventListener('click', (event) => {
        if (!menuButton.contains(event.target as Node) && !mobileMenu.contains(event.target as Node)) {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            toggleMenu(false);
          }
        }
      });

      // Close menu when clicking a link
      const menuLinks = mobileMenu.querySelectorAll('a');
      menuLinks.forEach((link) => {
        link.addEventListener('click', () => {
          toggleMenu(false);
        });
      });
    }

    function setupScrollBehavior() {
      const header = document.querySelector('[data-component="navbar"]') as HTMLElement;
      const mobileGradient = document.querySelector('[data-navbar-gradient="mobile"]') as HTMLElement;
      if (!header) return;

      const transparentNav = header.dataset.transparentNav === 'true';
      let ticking = false;

      function updateNavbar() {
        const atTop = window.scrollY <= 10;
        header.setAttribute('data-at-top', atTop ? 'true' : 'false');

        // Update mobile gradient visibility
        if (mobileGradient) {
          // On transparent nav pages: show gradient only when scrolled (when dark bg is visible)
          // On other pages: always show gradient (dark bg is always present)
          const showGradient = !transparentNav || !atTop;
          mobileGradient.style.opacity = showGradient ? '0.2' : '0';
        }

        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(updateNavbar);
          ticking = true;
        }
      }, { passive: true });

      // Set initial state
      updateNavbar();
    }

    function init() {
      setupMobileMenu();
      setupScrollBehavior();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
