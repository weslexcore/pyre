---
import { Image } from 'astro:assets';
import logo from '../assets/logos/creme/logo_with_text.png';
import navbar from '../lib/navbar';
import { withBase } from '../lib/paths';
import Button from './Button.astro';

interface Props {
  isHomePage?: boolean;
}

const { isHomePage = false } = Astro.props;
---

<header
  data-component="navbar"
  data-at-top="true"
  data-is-home={isHomePage ? 'true' : 'false'}
  class:list={[
    "fixed inset-x-0 top-0 z-50 transition-colors duration-300 motion-reduce:transition-none",
    isHomePage
      ? "bg-transparent data-[at-top=false]:max-lg:bg-[var(--pyre-black)]"
      : "bg-[var(--pyre-black)]"
  ]}
>
  <div class="w-full px-4 md:px-6 flex items-center justify-between gap-4 py-3 md:py-4">
    <!-- Logo -->
    <a href={withBase('')} aria-label={navbar.elements.ariaLabel} class="inline-flex flex-shrink-0">
      <Image
        src={logo}
        alt="Pyre Sauna logo"
        width="512"
        height="128"
        class="h-8 md:h-10 w-auto"
        loading="eager"
        decoding="sync"
      />
    </a>

    <!-- Desktop navigation links -->
    <nav class="hidden lg:flex items-center gap-6 bg-[var(--pyre-black)] px-8 py-4" aria-label="Main navigation">
      {navbar.elements.links && navbar.elements.links.map((link) => (
        <a
          href={link.href}
          aria-label={link.ariaLabel}
          class="font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] hover:opacity-70 transition-opacity"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTAs -->
    <div class="hidden md:flex items-center gap-3">
      <Button
        href={navbar.actions?.secondary?.href}
        variant="cta"
        size="sm"
        ariaLabel={navbar.actions?.secondary?.ariaLabel}
        class="book-cta"
        data-placement="header"
      >
        {navbar.actions?.secondary?.label}
      </Button>
    </div>

    <!-- Mobile CTA + menu button -->
    <div class="flex md:hidden items-center gap-2">
      <Button
        href={navbar.actions?.secondary?.href}
        variant="cta"
        size="sm"
        ariaLabel={navbar.actions?.secondary?.ariaLabel}
        class="book-cta"
        data-placement="header_mobile"
      >
        {navbar.actions?.secondary?.label}
      </Button>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden inline-flex items-center justify-center p-2 text-[var(--pyre-creme)] hover:opacity-70 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] relative"
    >
      <!-- Hamburger icon -->
      <svg id="hamburger-icon" class="w-6 h-6 transition-all duration-300 ease-in-out opacity-100 scale-100 rotate-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <!-- Close icon -->
      <svg id="close-icon" class="w-6 h-6 absolute transition-all duration-300 ease-in-out opacity-0 scale-0 rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="md:hidden bg-[var(--pyre-black)] border-t border-[var(--pyre-creme)]/10 overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0"
  >
    <div class="px-4 py-4 flex flex-col gap-3">
      {navbar.elements.links && navbar.elements.links.map((link) => (
        <a
          href={link.href}
          aria-label={link.ariaLabel}
          class="font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] py-2 hover:opacity-70 transition-opacity"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 border-t border-[var(--pyre-creme)]/10">
        <Button
          href={navbar.actions?.secondary?.href}
          variant="cta"
          size="sm"
          ariaLabel={navbar.actions?.secondary?.ariaLabel}
          class="w-full book-cta"
          data-placement="mobile_nav"
        >
          {navbar.actions?.secondary?.label}
        </Button>
      </div>
    </div>
  </nav>
</header>

<script>
  (function () {
    function setupMobileMenu() {
      const menuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (!menuButton || !mobileMenu || !hamburgerIcon || !closeIcon) return;

      function toggleMenu(shouldOpen: boolean) {
        menuButton.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');

        if (shouldOpen) {
          mobileMenu.classList.remove('max-h-0', 'opacity-0');
          mobileMenu.classList.add('max-h-[80vh]', 'opacity-100');
          hamburgerIcon.classList.remove('opacity-100', 'scale-100', 'rotate-0');
          hamburgerIcon.classList.add('opacity-0', 'scale-0', '-rotate-90');
          closeIcon.classList.remove('opacity-0', 'scale-0', 'rotate-90');
          closeIcon.classList.add('opacity-100', 'scale-100', 'rotate-0');
        } else {
          mobileMenu.classList.remove('max-h-[80vh]', 'opacity-100');
          mobileMenu.classList.add('max-h-0', 'opacity-0');
          hamburgerIcon.classList.remove('opacity-0', 'scale-0', '-rotate-90');
          hamburgerIcon.classList.add('opacity-100', 'scale-100', 'rotate-0');
          closeIcon.classList.remove('opacity-100', 'scale-100', 'rotate-0');
          closeIcon.classList.add('opacity-0', 'scale-0', 'rotate-90');
        }
      }

      menuButton.addEventListener('click', () => {
        const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
        toggleMenu(!isExpanded);
      });

      // Close menu when clicking outside
      document.addEventListener('click', (event) => {
        if (!menuButton.contains(event.target as Node) && !mobileMenu.contains(event.target as Node)) {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            toggleMenu(false);
          }
        }
      });

      // Close menu when clicking a link
      const menuLinks = mobileMenu.querySelectorAll('a');
      menuLinks.forEach((link) => {
        link.addEventListener('click', () => {
          toggleMenu(false);
        });
      });
    }

    function setupScrollBehavior() {
      const header = document.querySelector('[data-component="navbar"]');
      if (!header) return;

      let ticking = false;

      function updateNavbar() {
        const atTop = window.scrollY <= 10;
        header.setAttribute('data-at-top', atTop ? 'true' : 'false');
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(updateNavbar);
          ticking = true;
        }
      }, { passive: true });

      // Set initial state
      updateNavbar();
    }

    function init() {
      setupMobileMenu();
      setupScrollBehavior();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
