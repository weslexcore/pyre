---
import pyreLogoRaw from '../assets/logos/pyre_logo.svg?raw';
import location from '../lib/location';
import navbar from '../lib/navbar';
import { withBase } from '../lib/paths';
import Button from './Button.astro';
import GradientOverlay from './GradientOverlay.astro';
import InstagramIcon from './icons/InstagramIcon.astro';

interface Props {
  isHomePage?: boolean;
  transparentNav?: boolean;
  darkLogoText?: boolean;
  minimal?: boolean;
}

const { isHomePage = false, transparentNav = false, darkLogoText = false, minimal = false } = Astro.props;

const pyreLogo = pyreLogoRaw.replace('<svg', '<svg class="h-full w-auto"');
---

<header
  data-component="navbar"
  data-at-top="true"
  data-menu-open="false"
  data-transparent-nav={transparentNav ? 'true' : 'false'}
  style="top: var(--banner-height, 0px);"
  class:list={[
    "fixed inset-x-0 z-50 transition-[colors,top] duration-300 motion-reduce:transition-none",
    transparentNav
      ? "bg-transparent data-[at-top=false]:max-lg:bg-[var(--pyre-black)] data-[menu-open=true]:max-lg:bg-[var(--pyre-black)]"
      : "bg-[var(--pyre-black)]"
  ]}
>
  <!-- Mobile gradient overlay - visible when navbar has dark background (mobile only) -->
  <div class="lg:hidden">
    <GradientOverlay variant="navbar-mobile" />
  </div>

  <div class="w-full px-4 md:px-6 flex items-center justify-between gap-4 py-3 md:py-4">
    <!-- Logo -->
    <a href={withBase('')} aria-label={navbar.elements.ariaLabel} class="inline-flex items-center gap-3 flex-shrink-0">
      <span class="inline-block h-8 md:h-10 w-auto text-[var(--pyre-red)]" role="img" aria-label="Pyre Sauna logo" set:html={pyreLogo} />
      {!isHomePage && (
        <p class:list={[
          "font-logo text-5xl",
          darkLogoText ? "text-[var(--pyre-black)]" : "text-[var(--pyre-creme)]"
        ]}>PYRE</p>
      )}
    </a>

    {!minimal && (
    <!-- Desktop navigation links -->
    <nav class="hidden md:flex items-center gap-6 bg-[var(--pyre-black)] px-8 py-4 relative overflow-hidden rounded-xl" aria-label="Main navigation">
      <!-- Desktop gradient overlay - always visible on desktop nav -->
      <GradientOverlay variant="navbar-desktop" />
      {navbar.elements.links && navbar.elements.links.map((link) => (
        <a
          href={link.href}
          aria-label={link.ariaLabel}
          class="font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] hover:opacity-70 transition-opacity relative z-10"
        >
          {link.label}
        </a>
      ))}
    </nav>
    )}

    {!minimal && (
    <!-- Desktop CTAs -->
    <div class="hidden md:flex items-center gap-3">
      <!-- <AuthButtons
        client:load
        loginHref={navbar.actions?.login?.href || '/api/auth/login'}
        loginLabel={navbar.actions?.login?.label}
        loginAriaLabel={navbar.actions?.login?.ariaLabel}
        variant="desktop"
      /> -->
      <Button
        href={navbar.actions?.secondary?.href}
        variant="cta"
        size="lg"
        ariaLabel={navbar.actions?.secondary?.ariaLabel}
        class="book-cta"
        data-placement="header"
      >
        {navbar.actions?.secondary?.label}
      </Button>
    </div>
    )}

    {!minimal && (
    <!-- Mobile CTA + menu button -->
    <div class="flex md:hidden items-center gap-2">
      <!-- <Button
        href={navbar.actions?.login?.href}
        variant="secondary"
        size="sm"
        ariaLabel={navbar.actions?.login?.ariaLabel}
      >
        {navbar.actions?.login?.label}
      </Button> -->
      <Button
        href={navbar.actions?.secondary?.href}
        variant="cta"
        size="sm"
        ariaLabel={navbar.actions?.secondary?.ariaLabel}
        class="book-cta"
        data-placement="header_mobile"
      >
        {navbar.actions?.secondary?.label}
      </Button>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden inline-flex items-center justify-center p-2 text-[var(--pyre-creme)] hover:opacity-70 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] relative"
    >
      <!-- Hamburger icon -->
      <svg id="hamburger-icon" class="w-6 h-6 transition-all duration-300 ease-in-out opacity-100 scale-100 rotate-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <!-- Close icon -->
      <svg id="close-icon" class="w-6 h-6 absolute transition-all duration-300 ease-in-out opacity-0 scale-0 rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    </div>
    )}
  </div>

  {!minimal && (
  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="md:hidden bg-[var(--pyre-black)] border-t border-[var(--pyre-creme)]/10 overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0"
  >
    <div class="px-4 py-4 flex flex-col gap-3">
      {navbar.elements.links && navbar.elements.links.map((link) => (
        <a
          href={link.href}
          aria-label={link.ariaLabel}
          class="font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] py-2 hover:opacity-70 transition-opacity"
        >
          {link.label}
        </a>
      ))}
      <a
        href={location.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow us on Instagram"
        class="inline-flex items-center gap-1.5 font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-creme)] py-2 hover:opacity-70 transition-opacity"
      >
        <InstagramIcon class="size-[1.1em] shrink-0" />
        Instagram
      </a>
      <a
        href="#signup"
        aria-label="Join our mailing list"
        class="font-mono-bold text-sm uppercase tracking-wide text-[var(--pyre-red)] py-2 hover:opacity-70 transition-opacity"
      >
        Join Mailing List
      </a>
      <div class="pt-3 border-t border-[var(--pyre-creme)]/10 flex flex-row items-start gap-3">
        <!-- <div class="w-full">
          <AuthButtons
            client:load
            loginHref={navbar.actions?.login?.href || '/api/auth/login'}
            loginLabel={navbar.actions?.login?.label}
            loginAriaLabel={navbar.actions?.login?.ariaLabel}
            variant="mobile"
          />
        </div> -->
        <Button
          href={navbar.actions?.secondary?.href}
          variant="cta"
          size="lg"
          ariaLabel={navbar.actions?.secondary?.ariaLabel}
          class="w-full book-cta"
          data-placement="mobile_nav"
        >
          {navbar.actions?.secondary?.label}
        </Button>
      </div>
    </div>
  </nav>
  )}
</header>

<script>
  import { onScroll, getScrollData } from '../lib/scroll-coordinator';

  (function () {
    // Track cleanup functions for event listeners
    let cleanup: (() => void) | null = null;

    function setGradientVisibility(el: HTMLElement, visible: boolean) {
      el.style.opacity = visible ? '0.2' : '0';
      el.style.animationPlayState = visible ? 'running' : 'paused';
    }

    function setupMobileMenu() {
      const menuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (!menuButton || !mobileMenu || !hamburgerIcon || !closeIcon) return () => {};

      function toggleMenu(shouldOpen: boolean) {
        const header = document.querySelector('[data-component="navbar"]') as HTMLElement;
        const mobileGradient = header?.querySelector('[data-variant="navbar-mobile"]') as HTMLElement;

        menuButton.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
        header?.setAttribute('data-menu-open', shouldOpen ? 'true' : 'false');

        if (mobileGradient) {
          if (shouldOpen) {
            setGradientVisibility(mobileGradient, true);
          } else {
            const transparentNav = header?.dataset.transparentNav === 'true';
            const atTop = window.scrollY <= 10;
            setGradientVisibility(mobileGradient, !transparentNav || !atTop);
          }
        }

        if (shouldOpen) {
          mobileMenu.classList.remove('max-h-0', 'opacity-0');
          mobileMenu.classList.add('max-h-[80vh]', 'opacity-100');
          hamburgerIcon.classList.remove('opacity-100', 'scale-100', 'rotate-0');
          hamburgerIcon.classList.add('opacity-0', 'scale-0', '-rotate-90');
          closeIcon.classList.remove('opacity-0', 'scale-0', 'rotate-90');
          closeIcon.classList.add('opacity-100', 'scale-100', 'rotate-0');
        } else {
          mobileMenu.classList.remove('max-h-[80vh]', 'opacity-100');
          mobileMenu.classList.add('max-h-0', 'opacity-0');
          hamburgerIcon.classList.remove('opacity-0', 'scale-0', '-rotate-90');
          hamburgerIcon.classList.add('opacity-100', 'scale-100', 'rotate-0');
          closeIcon.classList.remove('opacity-100', 'scale-100', 'rotate-0');
          closeIcon.classList.add('opacity-0', 'scale-0', 'rotate-90');
        }
      }

      const handleMenuClick = () => {
        const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
        toggleMenu(!isExpanded);
      };

      const handleOutsideClick = (event: MouseEvent) => {
        if (!menuButton.contains(event.target as Node) && !mobileMenu.contains(event.target as Node)) {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            toggleMenu(false);
          }
        }
      };

      const handleLinkClick = () => {
        toggleMenu(false);
      };

      menuButton.addEventListener('click', handleMenuClick);
      document.addEventListener('click', handleOutsideClick);

      const menuLinks = mobileMenu.querySelectorAll('a');
      menuLinks.forEach((link) => {
        link.addEventListener('click', handleLinkClick);
      });

      // Return cleanup function
      return () => {
        menuButton.removeEventListener('click', handleMenuClick);
        document.removeEventListener('click', handleOutsideClick);
        menuLinks.forEach((link) => {
          link.removeEventListener('click', handleLinkClick);
        });
      };
    }

    function setupScrollBehavior() {
      const header = document.querySelector('[data-component="navbar"]') as HTMLElement;
      const mobileGradient = header?.querySelector('[data-variant="navbar-mobile"]') as HTMLElement;
      if (!header) return () => {};

      const transparentNav = header.dataset.transparentNav === 'true';

      function updateNavbar(data: { scrollY: number }) {
        const atTop = data.scrollY <= 10;
        header.setAttribute('data-at-top', atTop ? 'true' : 'false');

        if (mobileGradient) {
          const showGradient = !transparentNav || !atTop;
          setGradientVisibility(mobileGradient, showGradient);
        }
      }

      // Run once with current values
      updateNavbar(getScrollData());

      // Return unsubscribe as cleanup
      return onScroll(updateNavbar);
    }

    function init() {
      // Clean up previous listeners before setting up new ones
      if (cleanup) {
        cleanup();
      }

      const cleanupMenu = setupMobileMenu();
      const cleanupScroll = setupScrollBehavior();

      cleanup = () => {
        cleanupMenu();
        cleanupScroll();
      };
    }

    // Run on initial page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }

    // Re-initialize after view transitions
    document.addEventListener('astro:page-load', init);
  })();
</script>
