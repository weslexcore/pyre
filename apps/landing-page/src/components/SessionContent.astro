---
import sessions from '../lib/sessions';
import Button from './Button.astro';
---

<div id="sessions" aria-labelledby="sessions-heading">
  <div class="mb-6">
    <h2
      id="sessions-heading"
      class="font-primary-semibold text-[clamp(1.75rem,3vw,2.5rem)] tracking-[-0.02em] uppercase mb-3"
    >
      {sessions.title}
    </h2>
    {sessions.subtitle && (
      <p class="text-base opacity-80">{sessions.subtitle}</p>
    )}
  </div>

  <div class="space-y-3">
    {sessions.items.map((item) => (
      <div
        class={`session-item flex items-center justify-between p-4 border rounded-lg transition-all duration-300 ${
          item.highlighted
            ? 'border-[var(--pyre-muted-gold)] bg-[var(--pyre-muted-gold)]/10'
            : 'border-current/20 hover:border-current/40'
        }`}
      >
        <div>
          <h3 class={`font-mono-bold text-base uppercase tracking-wide ${item.highlighted ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
            {item.name}
          </h3>
          <p class="text-sm opacity-70 mt-0.5">{item.description}</p>
        </div>
        <div class={`font-primary-semibold text-2xl ${item.highlighted ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
          ${item.price}
        </div>
      </div>
    ))}
  </div>

  {sessions.cta && (
    <div class="mt-6">
      <Button
        href={sessions.cta.href}
        variant="primary"
        size="md"
        ariaLabel={sessions.cta.ariaLabel}
      >
        {sessions.cta.label}
      </Button>
    </div>
  )}
</div>
