---
import location from '../lib/location';
import HeroCarousel from './HeroCarousel.astro';
---

<section class="relative min-h-[100dvh] bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
  <div id="nav-sentinel" class="absolute top-0 left-0 w-full h-1" aria-hidden="true"></div>

  <div class="min-h-[100dvh] grid grid-cols-1 lg:grid-cols-[40%_60%]">
    <!-- Left: Location Info -->
    <div class="flex flex-col justify-between p-6 md:p-10 lg:p-12 order-2 lg:order-1">
      <!-- Location Name -->
      <div class="pt-16 lg:pt-20">
        <h1 class="font-primary-semibold text-[clamp(4rem,10vw,8rem)] tracking-[-0.03em] leading-[0.85] uppercase">
          {location.name}
        </h1>
        <!-- <p class="font-mono-bold text-lg md:text-xl uppercase tracking-wider mt-2 opacity-80"> -->
          <!-- {location.neighborhood} SAUNA + COLD PLUNGE IN COMMUNITY -->
        <!-- </p> -->
      </div>

              <!-- Phone -->
              <div>
                <!-- <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-1">Phone</h2> -->
                <a
                  href={`tel:${location.phone.replace(/[^0-9+]/g, '')}`}
                  class="text-3xl hover:underline underline-offset-4"
                >
                  SAUNA + COLD PLUNGE
                </a>
              </div>

      <!-- Contact Info -->
      <div class="space-y-6 my-8 lg:my-0">
        <!-- Address -->
        <div>
          <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-1">Address</h2>
          <p class="text-base md:text-lg">{location.address}</p>
        </div>



        <!-- Instagram -->
        <div>
          <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-1">Instagram</h2>
          <a
            href={location.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-base md:text-lg hover:underline underline-offset-4"
          >
            {location.instagram}
          </a>
        </div>
      </div>

      <!-- Hours -->
      <div class="pb-6 lg:pb-0">
        <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-3">Hours</h2>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm md:text-base">
          {location.hours.map((h) => (
            <div class="flex justify-between">
              <span class="font-mono-bold opacity-80">{h.day}</span>
              <span>{h.open} - {h.close}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right: Image Carousel -->
    <div class="relative h-[50vh] lg:h-auto order-1 lg:order-2">
      <HeroCarousel />
    </div>
  </div>
</section>
