---
import location from '../lib/location';
import HeroCarousel from './HeroCarousel.astro';
---

<!-- Mobile: Fixed text layer (z-0) - stays in place while scrolling -->
<!-- Extended above viewport to prevent white showing during overscroll bounce -->
<div class="fixed inset-x-0 -top-[20dvh] z-0 min-h-[100dvh] pt-[20dvh] bg-[var(--pyre-black)] text-[var(--pyre-creme)] lg:hidden">
  <div id="nav-sentinel" class="absolute top-[20dvh] left-0 w-full h-1 lg:hidden" aria-hidden="true"></div>
  <div class="flex flex-col justify-between p-6 md:p-10 min-h-[80dvh]">
    <!-- Location Name -->
    <div class="pt-16">
      <h1 class="font-logo text-[clamp(4rem,20vw,8rem)] tracking-[-0.03em] leading-[0.85] uppercase text-[var(--pyre-creme)]">
        {location.name}
      </h1>
      <!-- <p class="text-base md:text-lg text-[var(--pyre-gold)]">{location.neighborhood}</p> -->
    </div>

    <!-- Tagline -->
    <div>
      <a
        href={`tel:${location.phone.replace(/[^0-9+]/g, '')}`}
        class="text-3xl hover:underline underline-offset-4"
      >
        SAUNA + COLD PLUNGE
      </a>
    </div>
    

    <!-- Contact Info -->
    <div class="space-y-6 my-8">
      <div>
        <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-1">Address</h2>
        <p class="text-base md:text-lg">{location.address}</p>
      </div>
      <div>
        <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-1">Instagram</h2>
        <a
          href={location.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-base md:text-lg hover:underline underline-offset-4"
        >
          {location.instagram}
        </a>
      </div>
    </div>

    <!-- Hours -->
    <div class="pb-6">
      <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-3">Hours</h2>
      <div class="grid grid-rows-3 grid-flow-col gap-x-8 gap-y-1 text-sm md:text-base">
        {location.hours.map((h) => (
          <div class="flex justify-between gap-4">
            <span class="font-mono-bold opacity-80">{h.day}</span>
            <span>{h.open} - {h.close}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<!-- Mobile: Spacer for fixed text positioning -->
<div class="h-[80dvh] lg:hidden" aria-hidden="true"></div>

<!-- Desktop: Original Hero layout -->
<section class="relative min-h-[100dvh] bg-[var(--pyre-black)] text-[var(--pyre-creme)] hidden lg:block">
  <div id="nav-sentinel" class="absolute top-0 left-0 w-full h-1" aria-hidden="true"></div>
  <div class="min-h-[100dvh] grid grid-cols-[40%_60%]">
    <!-- Left: Location Info -->
    <div class="flex flex-col justify-between p-12">
      <div class="pt-20">
        <h1 class="font-logo text-[clamp(4rem,20vw,9rem)] tracking-[-0.03em] leading-[0.85] uppercase text-[var(--pyre-creme)]">
          {location.name}
        </h1>
        <!-- <p class="text-base md:text-lg text-[var(--pyre-gold)]">{location.neighborhood}</p> -->
      </div>

      <div>
        <a
          href={`tel:${location.phone.replace(/[^0-9+]/g, '')}`}
          class="text-3xl hover:underline underline-offset-4"
        >
          SAUNA + COLD PLUNGE
        </a>
      </div>

      <div class="space-y-6">
        <div>
          <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-1">Address</h2>
          <p class="text-lg">{location.address}</p>
        </div>
        <div>
          <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-1">Instagram</h2>
          <a
            href={location.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg hover:underline underline-offset-4"
          >
            {location.instagram}
          </a>
        </div>
      </div>

      <div>
        <h2 class="font-mono-bold text-xs uppercase tracking-wider opacity-60 mb-3">Hours</h2>
        <div class="columns-2 gap-x-8 text-base">
          {location.hours.map((h) => (
            <div class="flex justify-between gap-4 mb-1">
              <span class="font-mono-bold opacity-80">{h.day}</span>
              <span>{h.open} - {h.close}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right: Image Carousel -->
    <div class="relative h-auto">
      <HeroCarousel />
    </div>
  </div>
</section>
