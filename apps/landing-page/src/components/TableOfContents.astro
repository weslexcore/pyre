---
/**
 * Table of Contents component with responsive layout
 * Displays as sticky sidebar on desktop and expandable panel on mobile
 */

import type { TOCConfig } from '../lib/toc-types';

export interface Props {
  /** Configuration options for the TOC */
  config?: Partial<TOCConfig>;
  /** Additional CSS classes */
  class?: string;
  /** Whether to show the component (can be used to conditionally render) */
  show?: boolean;
}

const { config = {}, class: className = '', show = true } = Astro.props;

// Don't render if explicitly hidden
if (!show) {
  return null;
}
---

<div class={`toc-container ${className}`} data-toc-config={JSON.stringify(config)}>
  <!-- Mobile Accordion - Hidden for now -->
  <aside class="hidden lg:hidden" data-toc-mobile-accordion>
    <button
      class="w-full flex items-center justify-between px-4 py-3 bg-background/95 backdrop-blur-[10px] border border-foreground/10 rounded-lg transition-colors hover:bg-secondary/5 hover:border-secondary/30 shadow-[0_2px_8px_color-mix(in_srgb,var(--foreground)_10%,transparent)] text-foreground"
      aria-label="Toggle Table of Contents"
      aria-expanded="false"
      aria-controls="toc-mobile-content"
      type="button"
      data-toc-accordion-toggle
    >
      <h3 class="text-sm font-semibold uppercase tracking-wide font-sans">
        Contents
      </h3>
      <svg class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" data-toc-accordion-icon>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div
      id="toc-mobile-content"
      class="overflow-hidden transition-all duration-300 ease-in-out max-h-0"
      aria-hidden="true"
      data-toc-accordion-content
    >
      <div class="px-4 py-3 bg-background/98 backdrop-blur-[12px] border-x border-b border-foreground/10 rounded-b-lg max-h-[60vh] overflow-y-auto">
        <ul class="space-y-1" role="list" aria-label="Table of contents navigation" data-toc-list>
          <!-- TOC items will be populated by JavaScript -->
          <li class="text-sm text-gray-500 dark:text-gray-400 animate-pulse" aria-live="polite">
            Loading table of contents...
          </li>
        </ul>
      </div>
    </div>
  </aside>

  <!-- Desktop Sidebar -->
  <nav
    class="hidden lg:block fixed left-8 top-48 w-64 max-h-[60vh] overflow-y-auto bg-background/95 backdrop-blur-[10px] border border-foreground/10 rounded-xl shadow-[0_10px_25px_color-mix(in_srgb,var(--foreground)_10%,transparent)] p-4 z-[1000] [scrollbar-width:thin]"
    aria-label="Table of Contents"
  >
    <div class="mb-4">
      <h3 class="text-sm font-semibold text-foreground uppercase tracking-wide font-sans">
        Contents
      </h3>
    </div>

    <ul class="space-y-1" role="list" aria-label="Table of contents navigation" data-toc-list>
      <!-- TOC items will be populated by JavaScript -->
      <li class="text-sm text-gray-500 dark:text-gray-400 animate-pulse" aria-live="polite">
        Loading table of contents...
      </li>
    </ul>
    <!-- Progress Bar -->
    <div class="mt-2 hidden" data-show-progress>
      <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-1" role="progressbar" aria-labelledby="reading-progress-label">
        <div
          class="bg-gradient-to-r from-secondary to-primary h-1 rounded-full transition-all duration-300 ease-out"
          style="width: 0%"
          data-progress-bar
          aria-valuenow="0"
          aria-valuemin="0"
          aria-valuemax="100"
        ></div>
      </div>
      <div id="reading-progress-label" class="text-xs text-foreground/70 mt-1" data-progress-text>
        0% complete
      </div>
    </div>
  </nav>
</div>

<style>
  /* Custom scrollbar for desktop - can't be done purely with Tailwind */
  nav[aria-label="Table of Contents"]::-webkit-scrollbar {
    width: 6px;
  }

  nav[aria-label="Table of Contents"]::-webkit-scrollbar-track {
    background: #f3f4f6;
    border-radius: 3px;
  }

  nav[aria-label="Table of Contents"]::-webkit-scrollbar-thumb {
    background: #9ca3af;
    border-radius: 3px;
  }

  nav[aria-label="Table of Contents"]::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
  }

  /* Dark mode scrollbar */
  @media (prefers-color-scheme: dark) {
    nav[aria-label="Table of Contents"]::-webkit-scrollbar-track {
      background: #1f2937;
    }

    nav[aria-label="Table of Contents"]::-webkit-scrollbar-thumb {
      background: #4b5563;
    }

    nav[aria-label="Table of Contents"]::-webkit-scrollbar-thumb:hover {
      background: #6b7280;
    }
  }

  /* TOC item styles - handled by JavaScript-added Tailwind classes */

  /* Mobile accordion states */
  #toc-mobile-content.open {
    max-height: 70vh;
  }

  button[data-toc-accordion-toggle][aria-expanded="true"] svg[data-toc-accordion-icon] {
    transform: rotate(180deg);
  }

  /* Smooth scroll behavior */
  html.smooth-scroll {
    scroll-behavior: smooth;
  }

  /* Focus styles for accessibility */
  button[data-toc-accordion-toggle]:focus-visible,
  .toc-item a:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 2px;
  }
</style>

<script>
  // Initialize the TOC when the component loads
  document.addEventListener('DOMContentLoaded', async () => {
    const tocContainer = document.querySelector('[data-toc-config]') as HTMLElement;
    if (!tocContainer) return;

    // Get configuration from data attribute
    const configAttr = tocContainer.getAttribute('data-toc-config');
    const config = configAttr ? JSON.parse(configAttr) : {};

    // Dynamically import the scroll tracker
    const { default: TOCScrollTracker } = await import('./TOCScrollTracker');

    // Initialize the scroll tracking
    const scrollTracker = new TOCScrollTracker(tocContainer, config);
    scrollTracker.init();
  });
</script>