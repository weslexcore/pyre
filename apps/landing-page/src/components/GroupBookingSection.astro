---
import { Image } from 'astro:assets';
import warmSauna3 from '../assets/images/warm_sauna_3.webp';
import groupBooking from '../lib/group-booking';
import Button from './Button.astro';
import SectionDivider from './SectionDivider.astro';
---

<section id="group-booking" aria-labelledby="group-booking-heading" class="py-12 md:py-16 lg:py-0 px-4 lg:px-0">
  <div class="max-w-3xl mx-auto lg:max-w-none grid grid-cols-1 gap-6 lg:gap-8 items-start text-center">
    <!-- Text column -->
    <div>
      <h2
        id="group-booking-heading"
        class="font-primary-semibold text-[clamp(1.25rem,3vw,2rem)] lg:text-[clamp(1.75rem,3vw,2.5rem)] tracking-[-0.02em] uppercase mb-2"
      >
        {groupBooking.title}
      </h2>

      {groupBooking.subtitle && (
        <p class="font-mono text-sm lg:text-base opacity-80 mb-4">
          {groupBooking.subtitle}
        </p>
      )}

      <SectionDivider variant="wave" revealAnimation="draw" visibleAnimation="pulse" class="lg:block w-48 my-4 mx-auto" flip={true} scrollAware={true}/>

      <!-- Capacity badge -->
      <div class="inline-flex items-center gap-2 bg-[var(--pyre-muted-gold)]/10 border border-[var(--pyre-muted-gold)]/30 rounded-full px-4 py-2 mb-6">
        <svg class="w-5 h-5 text-[var(--pyre-muted-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span class="font-mono-bold text-sm text-[var(--pyre-muted-gold)]">
          {groupBooking.capacity.label}
        </span>
      </div>

      <!-- Description -->
      <div class="space-y-3 lg:space-y-4 text-sm lg:text-base leading-relaxed mb-6">
        {groupBooking.description.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <!-- Occasions grid -->
      {groupBooking.occasions && groupBooking.occasions.length > 0 && (
        <div class="grid grid-cols-2 gap-2 mb-6">
          {groupBooking.occasions.map((occasion) => (
            <div class="flex items-center gap-2 text-sm">
              <span class="text-[var(--pyre-muted-gold)]" aria-hidden="true">&#10003;</span>
              <span>{occasion.label}</span>
            </div>
          ))}
        </div>
      )}

      <!-- Features list (desktop only) -->
      {groupBooking.features && groupBooking.features.length > 0 && (
        <ul class="hidden lg:block space-y-2 mb-8 text-sm opacity-80">
          {groupBooking.features.map((feature) => (
            <li class="flex items-center gap-2">
              <span class="text-[var(--pyre-muted-gold)]" aria-hidden="true">&#8226;</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      )}

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row justify-center gap-3 mt-6 lg:mt-8">
        <Button
          href={groupBooking.cta.href}
          variant="cta"
          size="md"
          ariaLabel={groupBooking.cta.ariaLabel}
          class="btn-cta-animated"
        >
          {groupBooking.cta.label}
        </Button>

        {groupBooking.secondaryCta && (
          <Button
            href={groupBooking.secondaryCta.href}
            variant="outline"
            size="md"
            ariaLabel={groupBooking.secondaryCta.ariaLabel}
          >
            {groupBooking.secondaryCta.label}
          </Button>
        )}
      </div>
    </div>

    <!-- Image column -->
    <!-- <div class="aspect-[3/4] overflow-hidden rounded-lg order-first md:order-last">
      <Image
        src={warmSauna3}
        alt="Group of friends enjoying a private sauna session together"
        class="w-full h-full object-cover object-center"
        loading="lazy"
        decoding="async"
      />
    </div> -->
  </div>
</section>
