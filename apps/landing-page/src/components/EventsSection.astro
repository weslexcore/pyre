---
import EventsCarousel from './events/EventsCarousel';
import Button from './Button.astro';
import SectionDivider from './SectionDivider.astro';
import fallbackEvents from '../lib/events';
---

<section aria-labelledby="events-heading" class="py-16 md:py-24 px-4 bg-[var(--pyre-black)]/5">
  <div class="max-w-6xl mx-auto">
    <div class="text-center">
      <h2
        id="events-heading"
        class="font-primary-semibold text-[clamp(2rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-4"
      >
        {fallbackEvents.title}
      </h2>
      {fallbackEvents.subtitle && (
        <p class="text-lg opacity-80">{fallbackEvents.subtitle}</p>
      )}
    </div>

    <SectionDivider variant="squiggle" revealAnimation="draw" visibleAnimation="pulse" class="mx-auto w-72 my-4" scrollAware={true}/>

    <!-- Dynamic events carousel (React island) -->
    <EventsCarousel client:load fallback={fallbackEvents.items} />

    {fallbackEvents.viewAllCta && (
      <div class="mt-10 text-center">
        <Button
          href={fallbackEvents.viewAllCta.href}
          variant="outline"
          size="md"
          ariaLabel={fallbackEvents.viewAllCta.ariaLabel}
        >
          {fallbackEvents.viewAllCta.label}
        </Button>
      </div>
    )}
  </div>
</section>
