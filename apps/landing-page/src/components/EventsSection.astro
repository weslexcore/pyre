---
import { getEventsContent } from "../lib/events";
import Button from "./Button.astro";
import SectionDivider from "./SectionDivider.astro";

const events = await getEventsContent();
---

<section aria-labelledby="events-heading" class="py-16 md:py-24 px-4 bg-[var(--pyre-black)]/5">
  <div class="max-w-6xl mx-auto">
    <div class="text-center">
      <h2
        id="events-heading"
        class="font-primary-semibold text-[clamp(2rem,4vw,3rem)] tracking-[-0.02em] uppercase mb-4"
      >
        {events.title}
      </h2>
      {events.subtitle && (
        <p class="text-lg opacity-80">{events.subtitle}</p>
      )}
    </div>

    <SectionDivider variant="squiggle" revealAnimation="draw" visibleAnimation="pulse" class="mx-auto w-72 my-4" scrollAware={true}/>
    <!-- Horizontal scrolling events carousel -->
    <div class="events-wrapper relative"> 
      <!-- Left scroll arrow -->
      <button
        type="button"
        class="scroll-arrow scroll-arrow-left absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center bg-[var(--background)] border border-current/20 rounded-full shadow-lg opacity-0 pointer-events-none transition-all duration-300 hover:border-current/40 hover:scale-110"
        aria-label="Scroll left"
      >
        <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Right scroll arrow -->
      <button
        type="button"
        class="scroll-arrow scroll-arrow-right absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center bg-[var(--background)] border border-current/20 rounded-full shadow-lg opacity-0 pointer-events-none transition-all duration-300 hover:border-current/40 hover:scale-110"
        aria-label="Scroll right"
      >
        <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <div class="events-container -mx-4 px-4 md:-mx-8 md:px-8">
        <div class="events-scroll flex gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory pb-4 scrollbar-hide">
          {events.items.map((event) => (
            <article
              class="event-card flex-shrink-0 w-[280px] md:w-[320px] snap-start border border-current/20 rounded-lg overflow-hidden bg-[var(--background)] transition-all duration-300 hover:border-current/40 hover:shadow-lg"
            >
              <div class="p-5">
                <div class="mb-4">
                  <span class="inline-block px-2 py-1 text-xs font-mono-bold uppercase tracking-wide bg-[var(--pyre-burnt-orange)]/10 text-[var(--pyre-burnt-orange)] rounded">
                    {event.date}
                  </span>
                </div>

                <h3 class="font-mono-bold text-lg uppercase tracking-wide mb-2">
                  {event.title}
                </h3>

                <p class="text-sm opacity-70 mb-4 line-clamp-2">
                  {event.description}
                </p>

                <div class="space-y-1 text-sm opacity-70 mb-4">
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>{event.time}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>{event.location}</span>
                  </div>
                </div>

                {event.cta && (
                  <Button
                    href={event.cta.href}
                    variant="outline"
                    size="sm"
                    ariaLabel={event.cta.ariaLabel}
                    class="w-full"
                  >
                    {event.cta.label}
                  </Button>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    {events.viewAllCta && (
      <div class="mt-10 text-center">
        <Button
          href={events.viewAllCta.href}
          variant="outline"
          size="md"
          ariaLabel={events.viewAllCta.ariaLabel}
        >
          {events.viewAllCta.label}
        </Button>
      </div>
    )}
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .events-wrapper {
    position: relative;
  }

  .scroll-arrow {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.2s ease;
  }

  .scroll-arrow.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .scroll-arrow-left {
    left: -0.5rem;
  }

  .scroll-arrow-right {
    right: -0.5rem;
  }

  @media (min-width: 768px) {
    .scroll-arrow-left {
      left: -1.5rem;
    }

    .scroll-arrow-right {
      right: -1.5rem;
    }
  }
</style>

<script>
  function initEventsCarousel() {
    const wrapper = document.querySelector('.events-wrapper');
    if (!wrapper) return;

    const scrollContainer = wrapper.querySelector('.events-scroll');
    const leftArrow = wrapper.querySelector('.scroll-arrow-left');
    const rightArrow = wrapper.querySelector('.scroll-arrow-right');

    if (!scrollContainer || !leftArrow || !rightArrow) return;

    function updateArrows() {
      const { scrollLeft, scrollWidth, clientWidth } = scrollContainer;
      const isAtStart = scrollLeft <= 10;
      const isAtEnd = scrollLeft + clientWidth >= scrollWidth - 10;

      leftArrow.classList.toggle('visible', !isAtStart);
      rightArrow.classList.toggle('visible', !isAtEnd);
    }

    function scrollBy(direction: number) {
      const cardWidth = 320 + 24; // card width + gap
      scrollContainer.scrollBy({
        left: direction * cardWidth,
        behavior: 'smooth'
      });
    }

    leftArrow.addEventListener('click', () => scrollBy(-1));
    rightArrow.addEventListener('click', () => scrollBy(1));
    scrollContainer.addEventListener('scroll', updateArrows, { passive: true });

    // Initial check
    updateArrows();

    // Recheck on resize
    window.addEventListener('resize', updateArrows, { passive: true });
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEventsCarousel);
  } else {
    initEventsCarousel();
  }

  // Support Astro view transitions
  document.addEventListener('astro:page-load', initEventsCarousel);
</script>
