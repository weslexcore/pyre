---
interface Props {
  title: string;
  description: string;
  url: string;
}

const { title, description, url } = Astro.props;

// Encode for URL sharing
const encodedTitle = encodeURIComponent(title);
const encodedDescription = encodeURIComponent(description);
const encodedUrl = encodeURIComponent(url);

// Social share URLs
const twitterUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;

const buttonClasses =
  'inline-flex items-center justify-center gap-2 rounded-md border-2 border-foreground/20 bg-background px-4 py-2 font-mono text-sm font-bold uppercase tracking-wide text-foreground transition-colors hover:border-secondary hover:bg-secondary hover:text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2';
---

<div class="flex flex-col space-y-4">
  <h3 class="font-sans text-lg font-semibold text-foreground">
    Share this post
  </h3>

  <div class="flex flex-wrap gap-3">
    <!-- Twitter -->
    <a
      href={twitterUrl}
      target="_blank"
      rel="noopener noreferrer"
      class={buttonClasses}
      aria-label="Share on Twitter"
    >
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
      </svg>
      Twitter
    </a>

    <!-- LinkedIn -->
    <a
      href={linkedinUrl}
      target="_blank"
      rel="noopener noreferrer"
      class={buttonClasses}
      aria-label="Share on LinkedIn"
    >
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      LinkedIn
    </a>

    <!-- Facebook -->
    <a
      href={facebookUrl}
      target="_blank"
      rel="noopener noreferrer"
      class={buttonClasses}
      aria-label="Share on Facebook"
    >
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
      </svg>
      Facebook
    </a>

    <!-- Copy Link -->
    <button
      type="button"
      id="copy-link-btn"
      class={buttonClasses}
      aria-label="Copy link to clipboard"
      data-url={url}
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <span id="copy-link-text">Copy Link</span>
    </button>
  </div>

  <!-- Success message (hidden by default) -->
  <div id="copy-success" class="hidden font-mono text-sm text-secondary" role="status">
    ✓ Link copied to clipboard!
  </div>
</div>

<script>
  // Copy link button
  const copyButton = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-link-text');
  const copySuccess = document.getElementById('copy-success');

  copyButton?.addEventListener('click', async () => {
    const url = copyButton.getAttribute('data-url');
    if (!url) return;

    try {
      await navigator.clipboard.writeText(url);
      
      // Show success message
      if (copyText && copySuccess) {
        copyText.textContent = 'Copied!';
        copySuccess.innerHTML = '✓ Link copied to clipboard!';
        copySuccess.classList.remove('hidden');

        // Reset after 2 seconds
        setTimeout(() => {
          copyText.textContent = 'Copy Link';
          copySuccess.classList.add('hidden');
        }, 2000);
      }
    } catch (err) {
      console.error('Failed to copy link:', err);
      if (copyText) {
        copyText.textContent = 'Failed';
        setTimeout(() => {
          copyText.textContent = 'Copy Link';
        }, 2000);
      }
    }
  });
</script>

