---
import { Image } from 'astro:assets';
import type { BlogPostCard } from '@/lib/types';
import { formatReadingTime } from '@/lib/reading-time';
import SectionDivider from '../SectionDivider.astro';

interface Props {
  post: BlogPostCard;
}

const { post } = Astro.props;
const formattedDate = post.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="group relative flex flex-col md:flex-row overflow-hidden rounded-[var(--radius)] bg-[var(--pyre-black)] text-[var(--pyre-creme)] transition-all duration-300 shadow-2xl hover:shadow-[0_8px_30px_rgb(0,0,0,0.12)]">
  <!-- Featured Image -->
  {post.image ? (
    <a href={`/blog/${post.slug}`} class="relative aspect-[16/9] md:aspect-auto md:w-2/5 overflow-hidden shrink-0">
      {typeof post.image === 'string' ? (
        <img
          src={post.image}
          alt={post.title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <Image
          src={post.image}
          alt={post.title}
          width={800}
          height={450}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      )}
    </a>
  ) : (
    <div class="relative aspect-[16/9] md:aspect-auto md:w-2/5 bg-gradient-to-br from-[rgb(36,90,130)] to-[rgb(241,88,54)] shrink-0">
      <div class="flex h-full items-center justify-center p-6">
        <span class="font-sans text-2xl md:text-3xl font-semibold tracking-[-0.02em] text-[var(--pyre-creme)] text-center">
          {post.title}
        </span>
      </div>
    </div>
  )}

  <!-- Content -->
  <div class="flex flex-1 flex-col p-6 md:p-8">
    <!-- Title -->
    <h3 class="mb-3">
      <a
        href={`/blog/${post.slug}`}
        class="font-sans text-xl md:text-3xl font-semibold leading-tight tracking-[-0.02em] text-[var(--pyre-creme)] transition-colors group-hover:text-[var(--pyre-red))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(36,90,130)] focus-visible:ring-offset-2"
      >
        {post.title}
      </a>
    </h3>
    <SectionDivider variant="wave" revealAnimation="draw" visibleAnimation="pulse" class="mx-auto w-full my-1 h-0.5" scrollAware={true}/>

    <!-- Description -->
    <p class="mb-4 flex-1 font-sans text-base md:text-lg leading-relaxed text-[var(--pyre-creme)]">
      {post.description}
    </p>


    <!-- Meta info -->
    <div class="flex flex-wrap items-center gap-4 pt-4 font-mono text-sm text-[var(--pyre-creme)]/70">
      <span class="font-bold">{post.author}</span>
      <!-- <span aria-hidden="true">•</span> -->
      <!-- <time datetime={post.date.toISOString()}>{formattedDate}</time> -->
      <span aria-hidden="true">•</span>
      <span>{formatReadingTime(post.readingTime)}</span>
    </div>

    <!-- Tags -->
    <div class="mt-4 flex flex-wrap gap-2">
      {post.tags.map((tag) => (
        <a
          href={`/blog?tag=${encodeURIComponent(tag)}`}
          class="rounded-md bg-[rgb(36,90,130)] px-3 py-1 font-mono text-xs font-bold uppercase tracking-wide text-[rgb(250,248,236)] transition-colors hover:bg-[rgb(241,88,54)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(36,90,130)] focus-visible:ring-offset-2"
        >
          {tag}
        </a>
      ))}
    </div>
  </div>
</article>

