---
import type { TagWithCount } from '@/lib/types';

interface Props {
  tags: TagWithCount[];
}

const { tags } = Astro.props;
---

<div class="space-y-4 rounded-[var(--radius)] border border-[rgb(38,37,37)]/10 bg-[rgb(250,248,236)] pt-4 pl-4">
  <!-- Filter header -->
  <div class="flex items-center justify-between">
    <button
      id="toggle-tag-filters"
      type="button"
      class="flex items-center gap-2 font-sans text-lg font-semibold text-[rgb(38,37,37)] transition-colors hover:text-[rgb(36,90,130)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(36,90,130)] focus-visible:ring-offset-2"
      aria-expanded="false"
      aria-controls="tag-filters-content"
    >
      <svg 
        id="toggle-icon" 
        class="h-5 w-5 transition-transform duration-200" 
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
      Filter by Tag
      <span id="active-count" class="hidden rounded-full bg-[rgb(36,90,130)] px-2 py-0.5 font-mono text-xs font-bold text-[rgb(250,248,236)]"></span>
    </button>
    <button
      id="clear-all-filters"
      class="hidden font-mono text-sm font-bold text-[rgb(241,88,54)] transition-colors hover:text-[rgb(36,90,130)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(36,90,130)] focus-visible:ring-offset-2"
      aria-label="Clear all tag filters"
    >
      Clear All
    </button>
  </div>

  <!-- Tag buttons (collapsed by default) -->
  <div id="tag-filters-content" class="hidden space-y-4">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Tag filters">
      {tags.map((tag) => (
        <button
          type="button"
          data-tag={tag.name}
          class="tag-filter-btn rounded-md border-2 border-[rgb(36,90,130)]/20 bg-white px-4 py-2 font-mono text-sm font-bold uppercase tracking-wide text-[rgb(38,37,37)] transition-colors hover:border-[rgb(36,90,130)] hover:bg-[rgb(36,90,130)] hover:text-[rgb(250,248,236)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(36,90,130)] focus-visible:ring-offset-2 aria-pressed:border-[rgb(36,90,130)] aria-pressed:bg-[rgb(36,90,130)] aria-pressed:text-[rgb(250,248,236)]"
          aria-pressed="false"
          aria-label={`Filter by ${tag.name} tag (${tag.count} posts)`}
        >
          {tag.name}
          <span class="ml-1.5 opacity-70">({tag.count})</span>
        </button>
      ))}
    </div>

    <!-- Active filters display -->
    <div id="active-filters" class="hidden space-y-2">
      <p class="font-mono text-sm font-bold text-[rgb(38,37,37)]/70">
        Active Filters:
      </p>
      <div id="active-filters-list" class="flex flex-wrap gap-2">
        <!-- Active filter tags will be dynamically inserted here -->
      </div>
    </div>
  </div>
</div>

<script>
  // Track active tags
  const activeTags = new Set<string>();

  // Get elements
  const toggleButton = document.getElementById('toggle-tag-filters');
  const toggleIcon = document.getElementById('toggle-icon');
  const filtersContent = document.getElementById('tag-filters-content');
  const activeCountBadge = document.getElementById('active-count');
  const tagButtons = document.querySelectorAll('.tag-filter-btn');
  const clearAllBtn = document.getElementById('clear-all-filters');
  const activeFiltersContainer = document.getElementById('active-filters');
  const activeFiltersList = document.getElementById('active-filters-list');

  // Handle toggle button
  toggleButton?.addEventListener('click', () => {
    const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
    
    if (isExpanded) {
      // Collapse
      toggleButton.setAttribute('aria-expanded', 'false');
      filtersContent?.classList.add('hidden');
      toggleIcon?.classList.remove('rotate-180');
    } else {
      // Expand
      toggleButton.setAttribute('aria-expanded', 'true');
      filtersContent?.classList.remove('hidden');
      toggleIcon?.classList.add('rotate-180');
    }
  });

  // Handle tag button clicks
  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag');
      if (!tag) return;

      const isPressed = button.getAttribute('aria-pressed') === 'true';
      
      if (isPressed) {
        // Remove tag from active filters
        button.setAttribute('aria-pressed', 'false');
        activeTags.delete(tag);
      } else {
        // Add tag to active filters
        button.setAttribute('aria-pressed', 'true');
        activeTags.add(tag);
      }

      updateActiveFiltersDisplay();
      dispatchFilterEvent();
    });
  });

  // Handle clear all button
  clearAllBtn?.addEventListener('click', () => {
    clearAllFilters();
  });

  // Clear all filters
  function clearAllFilters() {
    activeTags.clear();
    tagButtons.forEach((button) => {
      button.setAttribute('aria-pressed', 'false');
    });
    updateActiveFiltersDisplay();
    dispatchFilterEvent();
  }

  // Update active filters display
  function updateActiveFiltersDisplay() {
    if (!activeFiltersContainer || !activeFiltersList) return;

    // Update active count badge
    if (activeTags.size === 0) {
      activeCountBadge?.classList.add('hidden');
      activeFiltersContainer.classList.add('hidden');
      clearAllBtn?.classList.add('hidden');
      activeFiltersList.innerHTML = '';
      return;
    }

    // Show count badge
    if (activeCountBadge) {
      activeCountBadge.textContent = activeTags.size.toString();
      activeCountBadge.classList.remove('hidden');
    }

    activeFiltersContainer.classList.remove('hidden');
    clearAllBtn?.classList.remove('hidden');

    // Build active filter tags
    const filterTags = Array.from(activeTags).map((tag) => {
      return `
        <span class="inline-flex items-center gap-2 rounded-md bg-[rgb(36,90,130)] px-3 py-1 font-mono text-xs font-bold uppercase tracking-wide text-[rgb(250,248,236)]">
          ${tag}
          <button
            type="button"
            class="remove-filter-btn hover:text-[rgb(241,88,54)] focus-visible:outline-none focus-visible:text-[rgb(241,88,54)]"
            data-tag="${tag}"
            aria-label="Remove ${tag} filter"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </span>
      `;
    }).join('');

    activeFiltersList.innerHTML = filterTags;

    // Add event listeners to remove buttons
    document.querySelectorAll('.remove-filter-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const tag = target.getAttribute('data-tag');
        if (!tag) return;

        // Find and update the corresponding filter button
        const filterButton = document.querySelector(`.tag-filter-btn[data-tag="${tag}"]`);
        if (filterButton) {
          filterButton.setAttribute('aria-pressed', 'false');
          activeTags.delete(tag);
          updateActiveFiltersDisplay();
          dispatchFilterEvent();
        }
      });
    });
  }

  // Dispatch filter change event
  function dispatchFilterEvent() {
    window.dispatchEvent(
      new CustomEvent('blog-tag-filter', {
        detail: { tags: Array.from(activeTags) },
      })
    );
  }

  // Listen for external clear filters event
  window.addEventListener('clear-tag-filters', () => {
    clearAllFilters();
  });

  // Initialize from URL params
  const urlParams = new URLSearchParams(window.location.search);
  const urlTag = urlParams.get('tag');
  if (urlTag) {
    const button = document.querySelector(`.tag-filter-btn[data-tag="${urlTag}"]`);
    if (button) {
      button.setAttribute('aria-pressed', 'true');
      activeTags.add(urlTag);
      updateActiveFiltersDisplay();
      dispatchFilterEvent();
      
      // Auto-expand filters if a tag is selected from URL
      toggleButton?.setAttribute('aria-expanded', 'true');
      filtersContent?.classList.remove('hidden');
      toggleIcon?.classList.add('rotate-180');
    }
  }
</script>

