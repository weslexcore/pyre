---
import sessions from '../lib/sessions';
import Button from './Button.astro';
import SectionDivider from './SectionDivider.astro';
---

<section id="sessions" aria-labelledby="sessions-heading" class="py-16 md:py-24 lg:py-0 px-4 lg:px-0">
  <div class="max-w-3xl mx-auto lg:max-w-none">
    <div class="text-center mb-6 lg:mb-6">
      <h2
        id="sessions-heading"
        class="font-primary-semibold text-[clamp(2rem,4vw,3rem)] lg:text-[clamp(1.75rem,3vw,2.5rem)] tracking-[-0.02em] uppercase mb-3 lg:mb-3"
      >
        {sessions.title}
      </h2>
      {sessions.subtitle && (
        <p class="text-lg lg:text-base opacity-80">{sessions.subtitle}</p>
      )}
      {sessions.note && (
        <p class="text-xs md:text-sm opacity-60 mt-2 italic">{sessions.note}</p>
      )}
    </div>
    <SectionDivider variant="wave" revealAnimation="draw" visibleAnimation="pulse" class="mx-auto w-72 my-4" flip={true} scrollAware={true}/>

    <div class="space-y-4 lg:space-y-3">
      {sessions.items.map((item) => (
        <div
          class={`session-item flex flex-col gap-3 p-5 lg:p-4 border ${item.subscription ? '' : 'lg:flex-row lg:items-center lg:justify-between'} rounded-lg transition-all duration-300 ${
            item.highlighted
              ? 'border-[var(--pyre-muted-gold)] bg-[var(--pyre-muted-gold)]/10'
              : 'border-current/20 hover:border-current/40'
          }`}
        >
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class={`font-mono-bold text-lg lg:text-base uppercase tracking-wide ${item.highlighted ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
                {item.name}
              </h3>
              {item.savings && !item.subscription && (
                <span class={`text-xs font-mono-bold uppercase tracking-wide px-2 py-0.5 rounded-full ${
                  item.highlighted
                    ? 'bg-[var(--pyre-muted-gold)]/20 text-[var(--pyre-muted-gold)]'
                    : 'bg-current/10 opacity-70'
                }`}>
                  Save ${item.savings}
                </span>
              )}
            </div>
            <p class="text-sm opacity-70 mt-1 lg:mt-0.5">{item.description}</p>
          </div>
          {item.subscription ? (
            <div class="flex flex-col gap-2">
              {[
                {
                  label: 'One-time',
                  price: item.price,
                  originalPrice: item.originalPrice,
                  savings: item.savings,
                  period: '',
                  caption: item.caption,
                  href: item.href,
                  featured: false,
                },
                { ...item.subscription, label: item.subscription.name, featured: true },
              ].map((option) => (
                <div
                  class={`flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3 p-3 rounded-md border ${
                    option.featured
                      ? 'border-[var(--pyre-muted-gold)] bg-[var(--pyre-muted-gold)]/10'
                      : 'border-current/20'
                  }`}
                >
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <p class={`font-mono-bold text-xs uppercase tracking-wide ${option.featured ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
                        {option.label}
                      </p>
                      {option.savings && (
                        <span class={`text-[10px] font-mono-bold uppercase tracking-wide px-2 py-0.5 rounded-full ${
                          option.featured
                            ? 'bg-[var(--pyre-muted-gold)]/20 text-[var(--pyre-muted-gold)]'
                            : 'bg-current/10 opacity-70'
                        }`}>
                          Save ${option.savings}{option.period}
                        </span>
                      )}
                    </div>
                    {option.caption && <p class="text-xs opacity-60 mt-0.5">{option.caption}</p>}
                  </div>
                  <div class="flex items-center justify-between sm:justify-end gap-3 shrink-0">
                    <div class={`flex items-baseline gap-1.5 font-primary-semibold text-2xl lg:text-xl ${option.featured ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
                      {option.originalPrice && (
                        <span class="text-sm opacity-50 line-through">${option.originalPrice}</span>
                      )}
                      <span>${option.price}{option.period && <span class="text-sm opacity-70">{option.period}</span>}</span>
                    </div>
                    <a
                      href={option.href}
                      data-track-placement="home_credit_packs"
                      class={`px-3 py-2 text-xs font-mono-bold uppercase tracking-wide rounded transition-all duration-300 ${
                        option.featured
                          ? 'bg-[var(--pyre-muted-gold)] text-[var(--pyre-black)] hover:bg-[var(--pyre-muted-gold)]/80'
                          : 'bg-current/10 hover:bg-current/20 border border-current/30'
                      }`}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Buy ${item.name} — ${option.label}`}
                    >
                      {option.featured ? 'Subscribe' : 'Buy'}
                    </a>
                  </div>
                </div>
              ))}
            </div>
          ) : (
          <div class="flex items-center justify-between lg:justify-end gap-4">
            <div class={`flex items-baseline gap-2 font-primary-semibold text-3xl lg:text-2xl ${item.highlighted ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
              {item.originalPrice && (
                <span class="text-lg lg:text-base opacity-50 line-through">${item.originalPrice}</span>
              )}
              <span>${item.price}</span>
            </div>
            {item.href && (
              <a
                href={item.href}
                data-track-placement="home_credit_packs"
                class={`px-4 py-2 text-sm font-mono-bold uppercase tracking-wide rounded transition-all duration-300 ${
                  item.highlighted
                    ? 'bg-[var(--pyre-muted-gold)] text-[var(--pyre-black)] hover:bg-[var(--pyre-muted-gold)]/80'
                    : 'bg-current/10 hover:bg-current/20 border border-current/30'
                }`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Buy
              </a>
            )}
          </div>
          )}
        </div>
      ))}
    </div>

    <!-- {sessions.cta && (
      <div class="mt-8 lg:mt-6 text-center lg:text-left">
        <Button
          href={sessions.cta.href}
          variant="primary"
          size="lg"
          class="lg:!py-2.5 lg:!px-5 lg:!text-sm"
          ariaLabel={sessions.cta.ariaLabel}
        >
          {sessions.cta.label}
        </Button>
      </div>
    )} -->
  </div>
</section>
