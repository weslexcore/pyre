---
import membership from '../lib/membership';
import Button from './Button.astro';
---

<div aria-labelledby="membership-heading">
  <div class="mb-4">
    <h2
      id="membership-heading"
      class="font-primary-semibold text-[clamp(1.5rem,2.5vw,2rem)] tracking-[-0.02em] uppercase mb-2"
    >
      {membership.title}
    </h2>
    {membership.subtitle && (
      <p class="text-sm opacity-80">{membership.subtitle}</p>
    )}
  </div>

  <div class="space-y-3">
    {membership.tiers.map((tier) => (
      <div
        class={`pricing-card relative p-3 border rounded-lg transition-all duration-300 ${
          tier.popular
            ? 'border-[var(--pyre-muted-gold)] bg-[var(--pyre-muted-gold)]/5'
            : 'border-current/20 hover:border-current/40'
        }`}
      >
        {tier.popular && (
          <div class="absolute -top-2.5 left-3 px-2 py-0.5 bg-[var(--pyre-muted-gold)] text-[var(--pyre-black)] text-[10px] font-mono-bold uppercase tracking-wide rounded-full">
            Popular
          </div>
        )}

        <div class="flex items-center justify-between mb-2">
          <div>
            <h3 class="font-mono-bold text-base uppercase tracking-wide">
              {tier.name}
            </h3>
          </div>
          <div class="text-right">
            <span class={`font-primary-semibold text-xl leading-none ${tier.popular ? 'text-[var(--pyre-muted-gold)]' : ''}`}>
              ${tier.price}
            </span>
            <span class="text-xs opacity-70">{tier.period}</span>
          </div>
        </div>

        <ul class="flex flex-wrap gap-x-3 gap-y-1 mb-3">
          {tier.features.slice(0, 3).map((feature) => (
            <li class={`flex items-center gap-1.5 text-xs ${feature.highlighted ? 'text-[var(--pyre-muted-gold)]' : 'opacity-80'}`}>
              <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{feature.text}</span>
            </li>
          ))}
        </ul>

        <Button
          href={tier.cta.href}
          variant={tier.popular ? 'primary' : 'outline'}
          size="sm"
          ariaLabel={tier.cta.ariaLabel}
          class="w-full"
        >
          {tier.cta.label}
        </Button>
      </div>
    ))}
  </div>
</div>
