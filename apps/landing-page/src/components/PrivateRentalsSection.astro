---
import { Image } from 'astro:assets';
import privateRentals from '../lib/private-rentals';
import saunaPlungeSingle from '../assets/images/rentals/SaunaPlunge-12.webp';
import saunaPlungeDouble from '../assets/images/rentals/SaunaPlungeMoonrise-12.webp';
import Button from './Button.astro';
import SectionDivider from './SectionDivider.astro';

const tierImages = [saunaPlungeSingle, saunaPlungeDouble] as const;
---

<section id="private-rentals" aria-labelledby="private-rentals-heading" class="py-12 md:py-16 lg:py-0 px-4 lg:px-0">
  <div class="max-w-3xl mx-auto lg:max-w-none text-center">
    <h2
      id="private-rentals-heading"
      class="font-primary-semibold text-[clamp(1.25rem,3vw,2rem)] lg:text-[clamp(1.75rem,3vw,2.5rem)] tracking-[-0.02em] uppercase mb-2"
    >
      {privateRentals.title}
    </h2>

    {privateRentals.subtitle && (
      <p class="font-mono text-sm lg:text-base opacity-80 mb-4">
        {privateRentals.subtitle}
      </p>
    )}

    <SectionDivider
      variant="wave"
      revealAnimation="draw"
      visibleAnimation="pulse"
      class="lg:block w-48 my-4 mx-auto"
      flip={true}
      scrollAware={true}
    />

    <p class="text-sm lg:text-base opacity-90 mb-4 max-w-2xl mx-auto">{privateRentals.unitSummary}</p>

    <div class="space-y-3 lg:space-y-4 text-sm lg:text-base leading-relaxed mb-6 max-w-2xl mx-auto">
      {privateRentals.description.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 max-w-3xl mx-auto lg:max-w-none mb-8 text-left">
      {privateRentals.tiers.map((tier, index) => (
        <div class="flex flex-col p-4 md:p-6 border border-current/20 rounded-lg hover:border-current/40 transition-colors duration-300">
          <div class="aspect-[4/3] w-full overflow-hidden rounded-md mb-4 shrink-0">
            <Image
              src={tierImages[index]}
              alt={tier.imageAlt}
              class="h-full w-full object-cover object-center"
              loading="lazy"
              decoding="async"
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 28vw, (min-width: 768px) 45vw, 100vw"
            />
          </div>
          <h3 class="font-mono-bold text-sm md:text-base uppercase tracking-wide text-center md:text-left mb-3">
            {tier.name}
          </h3>
          <div class="flex flex-col items-center md:items-start mb-3">
            <span class="font-primary-semibold text-3xl md:text-[clamp(2rem,4vw,2.75rem)] leading-none text-[var(--pyre-muted-gold)]">
              ${tier.price}
            </span>
            <span class="text-xs md:text-sm opacity-70 mt-1">{privateRentals.periodLabel}</span>
            <span class="font-mono text-xs md:text-sm opacity-90 mt-2">
              +${tier.extraDayPrice} per extra day
            </span>
          </div>
          <ul class="space-y-2 flex-grow text-xs md:text-sm">
            {tier.features.map((feature) => (
              <li class="flex items-start gap-2">
                <span class="text-[var(--pyre-muted-gold)] shrink-0 mt-0.5" aria-hidden="true">
                  &#10003;
                </span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="space-y-2 text-sm lg:text-base opacity-80 mb-6 max-w-2xl mx-auto">
      {privateRentals.logistics.map((line) => (
        <p>{line}</p>
      ))}
      <p class="font-mono text-xs md:text-sm opacity-90">{privateRentals.addonSummary}</p>
    </div>

    <div class="flex justify-center mt-6 lg:mt-8">
      <Button
        href={privateRentals.cta.href}
        variant="cta"
        size="md"
        ariaLabel={privateRentals.cta.ariaLabel}
        class="btn-cta-animated"
      >
        {privateRentals.cta.label}
      </Button>
    </div>

    {privateRentals.email && (
      <p class="mt-3 text-xs lg:text-sm opacity-60">
        or email us directly at{' '}
        <a
          href={`mailto:${privateRentals.email}?subject=Private%20Rental%20Inquiry`}
          class="underline underline-offset-2 hover:opacity-100 transition-opacity"
        >
          {privateRentals.email}
        </a>
      </p>
    )}
  </div>
</section>
