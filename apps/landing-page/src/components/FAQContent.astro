---
import faqs from '../lib/faqs';
import SectionDivider from './SectionDivider.astro';
---

<div aria-labelledby="faq-heading">
  <h2
    id="faq-heading"
    class="font-primary-semibold text-[clamp(1.75rem,3vw,2.5rem)] tracking-[-0.02em] uppercase mb-4 text-center"
  >
    {faqs.title}
  </h2>

  <SectionDivider variant="torn" revealAnimation="draw" visibleAnimation="pulse" class="mx-auto w-72 my-4" scrollAware={true}/>

  <div class="faq-list-desktop space-y-3 max-w-3xl mx-auto">
    {faqs.items.map((faq, index) => (
      <div class="faq-item-desktop border-b border-current/20">
        <button
          type="button"
          class="faq-trigger-desktop w-full py-4 flex items-center justify-between text-left gap-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring)] focus-visible:ring-offset-2"
          aria-expanded="false"
          aria-controls={`faq-content-desktop-${index}`}
          id={`faq-trigger-desktop-${index}`}
        >
          <span class="font-mono-bold text-base pr-4">
            {faq.question}
          </span>
          <span class="faq-icon-desktop flex-shrink-0 w-5 h-5 relative" aria-hidden="true">
            <span class="absolute inset-0 flex items-center justify-center transition-transform duration-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12M6 12h12" />
              </svg>
            </span>
          </span>
        </button>
        <div
          id={`faq-content-desktop-${index}`}
          class="faq-content-desktop overflow-hidden transition-all duration-300 ease-out"
          style="max-height: 0;"
          role="region"
          aria-labelledby={`faq-trigger-desktop-${index}`}
        >
          <div class="pb-4 pr-10">
            <p class="text-sm leading-relaxed opacity-80">
              {faq.answer}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .faq-trigger-desktop[aria-expanded="true"] .faq-icon-desktop svg {
    transform: rotate(45deg);
  }
</style>

<script>
  function initFAQAccordionDesktop() {
    const faqItems = document.querySelectorAll('.faq-item-desktop');

    faqItems.forEach((item) => {
      const trigger = item.querySelector('.faq-trigger-desktop') as HTMLButtonElement;
      const content = item.querySelector('.faq-content-desktop') as HTMLElement;

      if (!trigger || !content) return;

      trigger.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

        // Close all other items
        faqItems.forEach((otherItem) => {
          const otherTrigger = otherItem.querySelector('.faq-trigger-desktop') as HTMLButtonElement;
          const otherContent = otherItem.querySelector('.faq-content-desktop') as HTMLElement;

          if (otherTrigger && otherContent && otherItem !== item) {
            otherTrigger.setAttribute('aria-expanded', 'false');
            otherContent.style.maxHeight = '0';
          }
        });

        // Toggle current item
        if (isExpanded) {
          trigger.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '0';
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + 'px';
        }
      });

      // Keyboard navigation
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          trigger.click();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQAccordionDesktop, { once: true });
  } else {
    initFAQAccordionDesktop();
  }
</script>
