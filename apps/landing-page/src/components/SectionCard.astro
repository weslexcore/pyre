---
interface Props {
  id?: string;
  class?: string;
  ariaLabel?: string;
  stackIndex?: number;
}

const { id, class: className, ariaLabel, stackIndex } = Astro.props;

// Calculate sticky positioning for stacking effect
// Each card sticks 20px lower than the previous, creating a stacked appearance
const isSticky = typeof stackIndex === 'number';
const topOffset = isSticky ? 20 + stackIndex * 20 : 0;
const zIndex = isSticky ? 10 + stackIndex : undefined;
---

<div
  id={id}
  class:list={[
    'section-card',
    'bg-[var(--pyre-black)] text-[var(--pyre-creme)]',
    'lg:rounded-lg',
    'py-12 px-6 md:px-8 lg:px-12',
    isSticky && 'lg:sticky',
    className,
  ]}
  aria-label={ariaLabel}
>
  <slot />
</div>
