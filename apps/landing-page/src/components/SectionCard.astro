---
interface Props {
  id?: string;
  class?: string;
  ariaLabel?: string;
}

const { id, class: className, ariaLabel } = Astro.props;
---

<div
  id={id}
  class:list={[
    'section-card',
    'bg-[var(--pyre-black)] text-[var(--pyre-creme)]',
    'lg:rounded-lg',
    'py-12 px-6 md:px-8 lg:px-12',
    className,
  ]}
  aria-label={ariaLabel}
>
  <slot />
</div>
