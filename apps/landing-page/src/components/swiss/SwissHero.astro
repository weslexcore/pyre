---
/**
 * Cover hero, modeled on the brand guidelines cover: black field, creme ink,
 * mono spec rows, hairline rules, and an edge-justified giant PYRE wordmark
 * set in Neue Montreal.
 */
import pyreLogoRaw from '../../assets/logos/pyre_logo.svg?raw';
import location from '../../lib/location';
import { withBase } from '../../lib/paths';

const letters = ['P', 'Y', 'R', 'E'];
const markSm = pyreLogoRaw.replace('<svg', '<svg class="h-9 w-auto md:h-12"');
---

<div class="bg-[var(--pyre-black)] text-[var(--pyre-creme)]">
  <div
    class="mx-auto flex min-h-[100svh] max-w-[1440px] flex-col px-4 md:px-8"
    style="padding-top: calc(6rem + var(--banner-height, 0px));"
  >
    <!-- Running header: spec sheet meta row -->
    <div class="flex items-start justify-between gap-4 font-mono-bold text-[0.65rem] md:text-xs uppercase tracking-[0.14em]">
      <span>
        Pyre<br />
        Sauna + Cold Bathing
      </span>
      <span class="hidden md:block text-center">
        Richmond, Virginia<br />
        <span class="opacity-60">{location.neighborhood}</span>
      </span>
      <span class="hidden sm:block text-right">Estd. '24</span>
      <span class="text-[var(--pyre-creme)]" role="img" aria-label="Pyre logo mark" set:html={markSm} />
    </div>

    <div class="mt-4 border-t border-[var(--pyre-creme)]/40"></div>

    <!-- Giant edge-justified wordmark -->
    <div class="flex flex-1 flex-col justify-center py-10">
      <h1
        aria-label="PYRE"
        class="flex select-none items-baseline justify-between font-primary-semibold uppercase leading-[0.8] tracking-[-0.02em]"
        style="font-size: clamp(5.5rem, 24.5vw, 22rem);"
      >
        {letters.map((letter) => <span aria-hidden="true">{letter}</span>)}
      </h1>

      <div class="mt-6 flex flex-col gap-4 md:mt-10 md:flex-row md:items-end md:justify-between">
        <p class="font-primary-semibold text-[clamp(1.5rem,3.4vw,2.75rem)] uppercase leading-[0.95] tracking-[-0.02em]">
          Sauna + Cold Plunge<br />
          <span class="text-[var(--pyre-red)]">{location.tagline}</span>
        </p>
        <p class="max-w-xs text-sm leading-relaxed opacity-80 md:text-right">
          A social bathhouse built on traditional hot and cold therapies. From purge to plunge.
        </p>
      </div>
    </div>

    <!-- Spec grid: address / hours / contact / cta -->
    <div class="border-t border-[var(--pyre-creme)]/40"></div>
    <div class="grid grid-cols-1 gap-8 py-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      <div>
        <h2 class="mb-2 font-mono-bold text-[0.65rem] uppercase tracking-[0.14em] opacity-60">Address</h2>
        <a
          href={location.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm leading-relaxed underline-offset-4 hover:underline md:text-base"
        >
          {location.address}
        </a>
      </div>
      <div>
        <h2 class="mb-2 font-mono-bold text-[0.65rem] uppercase tracking-[0.14em] opacity-60">Hours</h2>
        <ul class="space-y-0.5 text-sm md:text-base">
          {location.hours.map((h) => (
            <li class="flex max-w-[14rem] justify-between gap-4">
              <span class="font-mono-bold text-xs leading-6 tracking-wide opacity-80">{h.day}</span>
              <span>{h.open}–{h.close}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="mb-2 font-mono-bold text-[0.65rem] uppercase tracking-[0.14em] opacity-60">Contact</h2>
        <ul class="space-y-0.5 text-sm md:text-base">
          <li>
            <a
              href={location.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="underline-offset-4 hover:underline"
            >
              {location.instagram}
            </a>
          </li>
          <li>
            <a href={`mailto:${location.email}`} class="underline-offset-4 hover:underline">{location.email}</a>
          </li>
          <li>
            <a href={`tel:${location.phone.replace(/[^+\d]/g, '')}`} class="underline-offset-4 hover:underline">
              {location.phone}
            </a>
          </li>
        </ul>
      </div>
      <div class="flex flex-col items-stretch justify-end gap-3">
        <a href={withBase('/events')} class="swiss-btn swiss-btn--red" aria-label="Book a sauna and cold plunge session">
          Book a Session
        </a>
        <a href="#signup" class="swiss-btn swiss-btn--outline-creme" aria-label="Join the Pyre mailing list">
          Join the Mailing List
        </a>
      </div>
    </div>

    <!-- Running footer: brand taglines -->
    <div class="border-t border-[var(--pyre-creme)]/40"></div>
    <div class="flex items-center justify-between gap-4 py-4 font-mono-bold text-[0.6rem] uppercase tracking-[0.14em] opacity-70 md:text-xs">
      <span>A Duality</span>
      <span class="hidden sm:inline">Something Social</span>
      <span>From Purge to Plunge</span>
    </div>
  </div>
</div>
