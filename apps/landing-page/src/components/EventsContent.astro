---
import { Image } from 'astro:assets';
import warmSauna2 from '../assets/images/warm_sauna_2.webp';
import fallbackEvents from '../lib/events';
import Button from './Button.astro';
import EventsCarousel from './events/EventsCarousel';
import SectionDivider from './SectionDivider.astro';
---

<div aria-labelledby="events-heading">
  <!-- Header -->
  <div class="text-center mb-6">
    <h2
      id="events-heading"
      class="font-primary-semibold text-[clamp(1.75rem,3vw,2.5rem)] tracking-[-0.02em] uppercase mb-3"
    >
      {fallbackEvents.title}
    </h2>
    {fallbackEvents.subtitle && (
      <p class="text-base opacity-80">{fallbackEvents.subtitle}</p>
    )}
    <SectionDivider variant="squiggle" revealAnimation="draw" visibleAnimation="pulse" class="mx-auto w-48 my-4" flip={true} scrollAware={true}/>
  </div>

  <!-- Image -->
  <div class="aspect-[16/9] overflow-hidden rounded-lg mb-6">
    <Image
      src={warmSauna2}
      alt="Friends enjoying a social sauna session together"
      class="w-full h-full object-cover object-center"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Dynamic events carousel (React island with compact variant) -->
  <EventsCarousel client:load fallback={fallbackEvents.items} variant="compact" />

  {fallbackEvents.viewAllCta && (
    <div class="mt-8 text-center">
      <Button
        href={fallbackEvents.viewAllCta.href}
        variant="outline"
        size="md"
        ariaLabel={fallbackEvents.viewAllCta.ariaLabel}
      >
        {fallbackEvents.viewAllCta.label}
      </Button>
    </div>
  )}
</div>
