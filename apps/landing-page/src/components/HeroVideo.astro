---
interface Props {
  class?: string;
  priority?: boolean;
  role: 'mobile' | 'desktop';
}

const { class: className = '', priority = false, role } = Astro.props;

const POSTER = '/videos/Softopen.f3592f908f756d08.poster.jpg';
const WEBM_720 = '/videos/Softopen.f3592f908f756d08.720p.webm';
const MP4_720 = '/videos/Softopen.f3592f908f756d08.720p.mp4';
const WEBM_1080 = '/videos/Softopen.f3592f908f756d08.1080p.webm';
const MP4_1080 = '/videos/Softopen.f3592f908f756d08.1080p.mp4';
---

<video
  class:list={['h-full w-full object-cover object-center motion-reduce:hidden', className]}
  autoplay
  muted
  loop
  playsinline
  preload={priority ? 'auto' : 'metadata'}
  poster={POSTER}
  aria-hidden="true"
  data-hero-video={role}
  data-playback-rate=".9"
>
  <source src={WEBM_1080} type="video/webm" media="(min-width: 1024px)" />
  <source src={MP4_1080} type="video/mp4" media="(min-width: 1024px)" />
  <source src={WEBM_720} type="video/webm" />
  <source src={MP4_720} type="video/mp4" />
</video>

<img
  src={POSTER}
  alt=""
  aria-hidden="true"
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
  class:list={['h-full w-full object-cover object-center hidden motion-reduce:block', className]}
/>
