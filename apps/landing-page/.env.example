# Landing Page Environment Variables

# Base URL configuration
PUBLIC_ASTRO_BASE="/"
# PUBLIC_ASTRO_SITE="https://example.com"

# Cloudflare Turnstile (spam protection)
PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Resend (email)
RESEND_API_KEY=your_resend_api_key

# Momence Events API
# Get these from your Momence account settings
MOMENCE_HOST_ID=your_host_id
MOMENCE_API_TOKEN=your_api_token

# Momence OAuth V2
# Get these from your Momence developer settings
MOMENCE_OAUTH_CLIENT_ID=your_oauth_client_id
MOMENCE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
