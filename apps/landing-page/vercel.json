{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && yarn turbo run build --filter=@pyre/landing-page",
  "ignoreCommand": "npx -y turbo@^2 query affected --base=$VERCEL_GIT_PREVIOUS_SHA --packages @pyre/landing-page --exit-code",
  "installCommand": "yarn install",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [{ "source": "/book", "destination": "/events", "permanent": true }]
}
