---
// Email template browser. Same server-side gate as /admin: the page never
// renders for non-admins, and the /api/admin/email-preview route it calls
// re-checks the session on every request (the page gate is UX; the API gate is
// the security boundary).
import { EmailTemplatePreview } from '@/components/admin/EmailTemplatePreview';
import { EMAIL_PREVIEW_PROPS } from '@/emails/preview-props';
import { EMAIL_TEMPLATES } from '@/emails/registry';
import type { EmailTemplateKey } from '@/emails/types';
import { isAdminEmail } from '@/lib/auth/admin';
import { validateSession } from '@/lib/auth/session';
import { CONFIRMATION_SESSION_TYPES } from '@/lib/email/confirmation-content';
import '@/styles/admin.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const { session } = await validateSession(Astro.cookies);
const user = session.isAuthenticated ? session.user : null;
const isAdmin = !!user?.email && isAdminEmail(user.email);

// Registry order; each entry pre-filled with the same sample props the React
// Email dev server (`yarn email`) uses.
const templates = (Object.keys(EMAIL_TEMPLATES) as EmailTemplateKey[]).map((key) => ({
  key,
  defaultProps: EMAIL_PREVIEW_PROPS[key] as unknown as Record<string, unknown>,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Pyre Email Templates</title>
  </head>
  <body class="min-h-screen bg-[var(--pyre-black)] font-sans text-[var(--pyre-creme)] antialiased">
    <main class="mx-auto max-w-7xl px-4 py-10">
      {
        !user ? (
          <div class="mx-auto max-w-md py-16 text-center">
            <h1 class="mb-4 text-2xl font-semibold">Pyre Email Templates</h1>
            <p class="mb-6 text-white/60">Sign in with your Momence account to continue.</p>
            <a
              href="/api/auth/login?returnUrl=/admin/email-templates"
              class="inline-block rounded-md bg-[var(--pyre-red)] px-6 py-3 font-mono text-sm font-bold uppercase tracking-wide text-[var(--pyre-creme)] transition-opacity hover:opacity-90"
            >
              Log In
            </a>
          </div>
        ) : !isAdmin ? (
          <div class="mx-auto max-w-md py-16 text-center">
            <h1 class="mb-4 text-2xl font-semibold">Unauthorized</h1>
            <p class="text-white/60">You do not have access to this page.</p>
            <p class="mt-4 font-mono text-xs text-white/40">
              Signed in as {user.email || '(no email)'} (id {user.id})
            </p>
            <a href="/api/auth/logout" class="mt-6 inline-block font-mono text-xs uppercase tracking-wide text-white/60 underline hover:text-white">
              Log out
            </a>
          </div>
        ) : (
          <>
            <header class="mb-8 flex items-start justify-between gap-4">
              <div>
                <h1 class="text-2xl font-semibold">Email Templates</h1>
                <p class="mt-1 font-mono text-xs text-white/40">
                  Every registered template, rendered with editable props — Pyre integrations
                  service.
                </p>
              </div>
              <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-wide">
                <a
                  href="/admin"
                  class="rounded-md border border-white/20 px-3 py-1.5 font-bold text-[var(--pyre-creme)] transition-colors hover:border-white/40 hover:bg-white/10"
                >
                  ← Email Admin
                </a>
                <span class="text-white/40">{user.email}</span>
                <a
                  href="/api/auth/logout"
                  class="rounded-md border border-white/20 px-3 py-1.5 font-bold text-[var(--pyre-creme)] transition-colors hover:border-white/40 hover:bg-white/10"
                >
                  Log Out
                </a>
              </div>
            </header>
            <EmailTemplatePreview
              client:load
              templates={templates}
              confirmationSessionTypes={CONFIRMATION_SESSION_TYPES}
            />
          </>
        )
      }
    </main>
  </body>
</html>
