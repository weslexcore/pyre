---
// Email template browser. Auth + header live in AdminLayout; the
// /api/admin/email-preview route it calls re-checks the session on every
// request (the page gate is UX; the API gate is the security boundary).
import { EmailTemplatePreview } from '@/components/admin/EmailTemplatePreview';
import { EMAIL_PREVIEW_PROPS } from '@/emails/preview-props';
import { CONFIRMATION_PREVIEWS } from '@/emails/preview-sessions';
import { EMAIL_TEMPLATES } from '@/emails/registry';
import type { EmailTemplateKey } from '@/emails/types';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getEmailGate } from '@/lib/email/dev-mode';
import { JOURNEYS } from '@/lib/email/journeys/registry';
import { getJourneySettings } from '@/lib/email/journeys/settings';

// Registry order; each entry pre-filled with the same sample props the React
// Email dev server (`yarn email`) uses. Live status is computed per-request
// from the effective gate (env baseline + dashboard overrides in Supabase).
const [gate, journeySettings] = await Promise.all([getEmailGate(), getJourneySettings()]);
const templates = (Object.keys(EMAIL_TEMPLATES) as EmailTemplateKey[]).map((key) => ({
  key,
  defaultProps: EMAIL_PREVIEW_PROPS[key] as unknown as Record<string, unknown>,
  live: gate.isLive(key),
  source: (key in gate.overrides ? 'db' : 'env') as 'db' | 'env',
}));

// Plain data only — the island never imports the server-side journey code.
// No settings row = enabled, matching the engine's own default.
const journeys = JOURNEYS.map((journey) => ({
  id: journey.id,
  kind: journey.kind,
  steps: journey.steps.length,
  enrollSource: journey.enroll.source,
  enabled: journeySettings[journey.id] ?? true,
}));

const liveTemplatesConfig =
  import.meta.env.EMAIL_LIVE_TEMPLATES ?? process.env.EMAIL_LIVE_TEMPLATES ?? '(unset)';
---

<AdminLayout
  title="Email Templates"
  subtitle="Every registered template, rendered with editable props — Pyre integrations service."
  wide
>
  <EmailTemplatePreview
    client:load
    templates={templates}
    journeys={journeys}
    confirmationPresets={CONFIRMATION_PREVIEWS as unknown as Record<string, Record<string, unknown>>}
    liveTemplatesConfig={liveTemplatesConfig}
    whitelist={gate.whitelist}
    dbAvailable={gate.dbAvailable}
  />
</AdminLayout>
