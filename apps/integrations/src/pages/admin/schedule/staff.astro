---
// The roster. Momence email links each person to their login (employee pages
// arrive in Phase 2); founders drive the hours report's % founders metric.
import { ScheduleRoster } from '@/components/admin/ScheduleRoster';
import ScheduleTabs from '@/components/admin/ScheduleTabs.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout
  title="Roster"
  subtitle="Set each person's Momence account email so their login finds their schedule."
>
  <ScheduleTabs current="/admin/schedule/staff" />
  <ScheduleRoster client:load />
</AdminLayout>
