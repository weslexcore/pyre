---
// Staffing insights: labor cost trends and payroll forecast, per-person
// consistency against their own weekly target, and unmet demand (denied
// requests, subbed-away shifts). Needs schedule:insights (or an admin holding
// the schedule page) — everyone else is bounced back to the board here (UX;
// the API route's gate is the security boundary).
import { hasScheduleInsights } from '@/components/admin/adminTools';
import { ScheduleInsights } from '@/components/admin/ScheduleInsights';
import ScheduleTabs from '@/components/admin/ScheduleTabs.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';

const access = Astro.locals.adminAccess;
if (!access || !hasScheduleInsights(access)) return Astro.redirect('/admin/schedule');
---

<AdminLayout
  title="Insights"
  subtitle="Labor cost, payroll forecast, and whether everyone is getting the hours they want."
>
  <ScheduleTabs current="/admin/schedule/insights" />
  <ScheduleInsights client:load />
</AdminLayout>
