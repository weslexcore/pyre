---
// Timesheet: per-person hours by week (the sheet's "Total Hours"), with CSV export.
// The manage side and schedule:timesheet see everyone; employees see only
// their own hours. Shift preferences moved to the Availability tab.
import { hasScheduleManage, hasScheduleTimesheet } from '@/components/admin/adminTools';
import { ScheduleHours } from '@/components/admin/ScheduleHours';
import ScheduleTabs from '@/components/admin/ScheduleTabs.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';

const access = Astro.locals.adminAccess ?? null;
const seesEveryone = !!access && (hasScheduleManage(access) || hasScheduleTimesheet(access));
---

<AdminLayout
  title="Timesheet"
  subtitle={seesEveryone
    ? 'Scheduled hours per person, Monday–Sunday weeks. ✦ = founder.'
    : 'Your scheduled hours, Monday–Sunday weeks.'}
>
  <ScheduleTabs current="/admin/schedule/timesheet" />
  <ScheduleHours client:load />
</AdminLayout>
