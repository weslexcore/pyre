---
// Schedule change log: who changed what (shifts, assignments, time off,
// draft proposals, Momence sync). Needs schedule:changes (or an admin holding
// the schedule page) — everyone else is bounced back to the board here (UX;
// the API route's gate is the security boundary).
import { hasScheduleChanges } from '@/components/admin/adminTools';
import { ScheduleChanges } from '@/components/admin/ScheduleChanges';
import ScheduleTabs from '@/components/admin/ScheduleTabs.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';

const access = Astro.locals.adminAccess;
if (!access || !hasScheduleChanges(access)) return Astro.redirect('/admin/schedule');
---

<AdminLayout
  title="Change Log"
  subtitle="Every schedule change and who made it. Sync and agent activity included."
>
  <ScheduleTabs current="/admin/schedule/changes" />
  <ScheduleChanges client:load />
</AdminLayout>
