import { CampaignsIndex } from '@/components/admin/campaigns/CampaignsIndex';
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout
  title="Campaigns"
  subtitle="Create a campaign, then generate a tagged link for every place you promote it"
>
  <CampaignsIndex client:load />
</AdminLayout>
