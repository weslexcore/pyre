---
// Checklist-run log. Everyone who can reach /admin/sops reads the log, with
// the same filters; a non-admin's is narrowed to runs of the SOPs they may
// view (the API enforces that scoping). The isAdmin prop decides one thing:
// whether a run can be deleted.
import { SopRunsBoard } from '@/components/admin/SopRunsBoard';
import AdminLayout from '@/layouts/AdminLayout.astro';

const isAdmin = Astro.locals.adminAccess?.isAdmin ?? false;
---

<AdminLayout title="Checklist Runs" subtitle="Who ran which SOP, what they checked, and when">
  <SopRunsBoard client:load isAdmin={isAdmin} />
</AdminLayout>
