---
// Ask the knowledge base: a natural-language question answered by the
// pyre-agents knowledge assistant from the SOP library, shift notes, water
// log, and incident reports — scoped to what this user may read, with links
// back to the documents. The island talks to /api/admin/knowledge-ask.
import { SopAsk } from '@/components/admin/SopAsk';
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout
  title="Ask the Knowledge Base"
  subtitle="Answers from the SOPs, shift notes, water log, and incident reports — with links to where they come from"
>
  <SopAsk client:load />
</AdminLayout>
