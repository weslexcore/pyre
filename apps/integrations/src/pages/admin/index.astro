---
// Admin home: directory of the tools this user may view, grouped by section,
// with a per-user Pinned section at the top (pinning and drag-reordering live
// in the AdminToolsIndex island). Auth + header live in AdminLayout; the
// island renders the same filtered tool list the nav uses.
import { AdminToolsIndex } from '@/components/admin/AdminToolsIndex';
import { toolsForAccess } from '@/components/admin/adminTools';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getToolPins } from '@/lib/admin/toolPins';

const access = Astro.locals.adminAccess ?? null;
const tools = access ? toolsForAccess(access) : [];
const email = Astro.locals.adminUser?.email ?? '';
const pins = email ? await getToolPins(email) : [];
// Memo for AdminLayout (its frontmatter runs after the page's), so the nav
// doesn't refetch the same list on this request.
Astro.locals.toolPins = pins;
---

<AdminLayout title="Admin" subtitle="Internal tools for the Pyre team.">
  <AdminToolsIndex client:load tools={tools} initialPins={pins} />
</AdminLayout>
