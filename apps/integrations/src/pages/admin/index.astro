---
// Email monitoring dashboard. Gated server-side: the page never renders data
// for non-admins, and the /api/admin/* routes it calls re-check the session on
// every request (the page gate is UX; the API gate is the security boundary).
import { EmailDashboard } from '@/components/admin/EmailDashboard';
import { isAdminEmail } from '@/lib/auth/admin';
import { validateSession } from '@/lib/auth/session';
import '@/styles/admin.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const { session } = await validateSession(Astro.cookies);
const user = session.isAuthenticated ? session.user : null;
const isAdmin = !!user?.email && isAdminEmail(user.email);

const authError = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Pyre Email Admin</title>
  </head>
  <body class="min-h-screen bg-[var(--pyre-black)] font-sans text-[var(--pyre-creme)] antialiased">
    <main class="mx-auto max-w-6xl px-4 py-10">
      {
        !user ? (
          <div class="mx-auto max-w-md py-16 text-center">
            <h1 class="mb-4 text-2xl font-semibold">Pyre Email Admin</h1>
            <p class="mb-6 text-white/60">Sign in with your Momence account to continue.</p>
            {authError && (
              <p class="mb-4 font-mono text-xs text-[var(--pyre-red)]">
                Sign-in failed ({authError}). Try again.
              </p>
            )}
            <a
              href="/api/auth/login?returnUrl=/admin"
              class="inline-block rounded-md bg-[var(--pyre-red)] px-6 py-3 font-mono text-sm font-bold uppercase tracking-wide text-[var(--pyre-creme)] transition-opacity hover:opacity-90"
            >
              Log In
            </a>
          </div>
        ) : !isAdmin ? (
          <div class="mx-auto max-w-md py-16 text-center">
            <h1 class="mb-4 text-2xl font-semibold">Unauthorized</h1>
            <p class="text-white/60">You do not have access to this page.</p>
            <p class="mt-4 font-mono text-xs text-white/40">
              Signed in as {user.email || '(no email)'} (id {user.id})
            </p>
            <a href="/api/auth/logout" class="mt-6 inline-block font-mono text-xs uppercase tracking-wide text-white/60 underline hover:text-white">
              Log out
            </a>
          </div>
        ) : (
          <>
            <header class="mb-8 flex items-start justify-between gap-4">
              <div>
                <h1 class="text-2xl font-semibold">Email</h1>
                <p class="mt-1 font-mono text-xs text-white/40">
                  Sends, errors, deliverability, and journeys — Pyre integrations service.
                </p>
              </div>
              <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-wide">
                <span class="text-white/40">{user.email}</span>
                <a
                  href="/api/auth/logout"
                  class="rounded-md border border-white/20 px-3 py-1.5 font-bold text-[var(--pyre-creme)] transition-colors hover:border-white/40 hover:bg-white/10"
                >
                  Log Out
                </a>
              </div>
            </header>
            <EmailDashboard client:load />
          </>
        )
      }
    </main>
  </body>
</html>
