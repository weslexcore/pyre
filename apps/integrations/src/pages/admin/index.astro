---
// Admin home: directory of the tools this user may view, grouped by section,
// with a per-user Pinned section at the top (pinning and drag-reordering live
// in the AdminToolsIndex island). Auth + header live in AdminLayout; the
// island renders the same filtered tool list the nav uses. Above the cards, a
// next-shift chip: staff see their own next upcoming shift, admins see the
// next one on the schedule overall. Under the chip come the SOPs for the
// duties this person holds on their own current-or-next shift, then every
// checklist run still open on an SOP they may view, their own first, so what
// they are on the hook to finish is the first thing they see.
import { AdminToolsIndex } from '@/components/admin/AdminToolsIndex';
import { canViewPage, toolsForAccess } from '@/components/admin/adminTools';
import { ShiftSopsPanel } from '@/components/admin/ShiftSops';
import { formatWhen } from '@/components/admin/SopRunsList';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getToolPins } from '@/lib/admin/toolPins';
import { listStaff } from '@/lib/auth/access';
import { getDb } from '@/lib/db';
import {
  formatChipDate,
  formatChipTime,
  getNextUpcomingShift,
  type NextShift,
} from '@/lib/schedule/next-shift';
import { normalizeEmail, type SopViewer } from '@/lib/sops/levels';
import { actorLabel, ownRunsFirst, type PeopleNames, sameActor } from '@/lib/sops/names';
import { getPeopleNames } from '@/lib/sops/people';
import { getSopRole } from '@/lib/sops/role';
import { type ActiveRun, loadActiveRuns } from '@/lib/sops/runs';
import { loadShiftSops, type ShiftSops } from '@/lib/sops/shift-sops';

const access = Astro.locals.adminAccess ?? null;
const tools = access ? toolsForAccess(access) : [];
const email = (Astro.locals.adminUser?.email ?? '').toLowerCase();
const pins = email ? await getToolPins(email) : [];
// Memo for AdminLayout (its frontmatter runs after the page's), so the nav
// doesn't refetch the same list on this request.
Astro.locals.toolPins = pins;

const db = getDb();
let nextShift: NextShift | null = null;
// Whether the chip is the viewer's own shift ("Your next shift") vs the
// admin's schedule-wide one ("Next shift", with who's on it).
let chipIsOwn = false;
let assignedNames: string[] = [];
if (db && access) {
  const staff = (await listStaff()) ?? [];
  const selfStaffId = email
    ? (staff.find((s) => (s.email ?? '').toLowerCase() === email)?.id ?? null)
    : null;
  if (access.isAdmin) {
    nextShift = await getNextUpcomingShift(db);
    if (nextShift) {
      const nameById = new Map(staff.map((s) => [s.id, s.display_name]));
      assignedNames = nextShift.assignments.map((a) => nameById.get(a.staff_id) ?? '?');
    }
  } else if (selfStaffId) {
    nextShift = await getNextUpcomingShift(db, selfStaffId);
    chipIsOwn = true;
  }
}

// Open checklist runs and shift duties, for anyone who can reach the SOP
// library. The runs are the same rows the library's own strip shows
// (loadActiveRuns scopes them to viewable documents); the shift SOPs are
// always the viewer's own duties, even for an admin whose chip above is the
// schedule-wide next shift. Either outage just drops its block, not the page.
let activeRuns: ActiveRun[] = [];
let runPeople: PeopleNames = {};
let shiftSops: ShiftSops | null = null;
if (db && access && canViewPage(access, '/admin/sops')) {
  const viewer: SopViewer = {
    role: await getSopRole(email, access),
    email: normalizeEmail(email),
  };
  const [{ runs }, shift] = await Promise.all([
    loadActiveRuns(db, viewer),
    loadShiftSops(db, viewer),
  ]);
  activeRuns = ownRunsFirst(runs, email);
  runPeople = await getPeopleNames(activeRuns.map((run) => run.started_by));
  shiftSops = shift;
}

// Deep-link into the schedule board's month view, same as the calendar's
// shift blocks — but only when this viewer may open the schedule page.
const chipHref =
  nextShift && access && canViewPage(access, '/admin/schedule')
    ? `/admin/schedule?view=month&date=${nextShift.shift.shift_date}&shift=${nextShift.shift.id}`
    : null;

const ChipTag = chipHref ? 'a' : 'span';
// A shift that's live right now reads "In session" in sage instead of the
// gold "Next shift" — the tone comes from the same accent var throughout.
const inSession = nextShift?.isInSession ?? false;
const chipLabel = inSession ? 'In session' : chipIsOwn ? 'Your next shift' : 'Next shift';
const chipAccent = inSession ? 'var(--pyre-sage)' : 'var(--pyre-gold)';
const chipWhen = nextShift
  ? nextShift.isToday
    ? 'Today'
    : formatChipDate(nextShift.shift.shift_date)
  : '';
const chipWindow = nextShift
  ? `${formatChipTime(nextShift.shift.starts_at)}–${formatChipTime(nextShift.shift.ends_at)} ${nextShift.shift.label}`
  : '';
---

<AdminLayout title="Admin" subtitle="Internal tools for the Pyre team.">
  <div class="space-y-8">
    {
      nextShift && (
        <div>
          <ChipTag
            href={chipHref ?? undefined}
            class={`inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-[var(--chip-accent)]/60 bg-[var(--chip-accent)]/10 px-4 py-2 font-mono text-xs ${
              chipHref
                ? 'transition-colors hover:border-[var(--chip-accent)] hover:bg-[var(--chip-accent)]/20'
                : ''
            }`}
            style={`--chip-accent: ${chipAccent}`}
          >
            <span class="font-bold uppercase tracking-wide text-[var(--chip-accent)]">
              {inSession && (
                <span
                  aria-hidden="true"
                  class="mr-1.5 inline-block h-2 w-2 rounded-full bg-[var(--chip-accent)] align-middle"
                />
              )}
              {chipLabel}
            </span>
            <span class="text-[var(--pyre-creme)]">
              {chipWhen} · {chipWindow}
            </span>
            {assignedNames.length > 0 && (
              <span class="text-white/60">· {assignedNames.join(', ')}</span>
            )}
          </ChipTag>
        </div>
      )
    }
    {shiftSops && <ShiftSopsPanel shift={shiftSops} />}
    {
      activeRuns.length > 0 && (
        <section>
          <h2 class="mb-3 font-mono text-xs uppercase tracking-wide text-[var(--pyre-gold)]">
            ☑ Checklists in progress
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {activeRuns.map((run) => {
              const pct =
                run.task_count > 0 ? Math.round((run.checked_count / run.task_count) * 100) : 0;
              const mine = sameActor(run.started_by, email);
              return (
                <a
                  href={`/admin/sops/${run.slug}`}
                  class={`block rounded border bg-[var(--pyre-gold)]/5 p-4 transition-colors hover:border-[var(--pyre-gold)] ${
                    mine ? 'border-[var(--pyre-gold)]' : 'border-[var(--pyre-gold)]/40'
                  }`}
                >
                  <div class="flex items-baseline justify-between gap-2">
                    <h3 class="flex flex-wrap items-baseline gap-x-2 font-semibold text-[var(--pyre-creme)]">
                      {run.title}
                      {mine && (
                        <span class="rounded border border-[var(--pyre-sage)]/40 bg-[var(--pyre-sage)]/10 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wide text-[var(--pyre-sage)]">
                          yours
                        </span>
                      )}
                    </h3>
                    <span class="font-mono text-[10px] uppercase tracking-wide text-[var(--pyre-gold)]">
                      resume →
                    </span>
                  </div>
                  <div class="mt-2 h-1 rounded-full bg-white/10">
                    <div
                      class="h-1 rounded-full bg-[var(--pyre-gold)]"
                      style={`width: ${pct}%`}
                    />
                  </div>
                  <p class="mt-2 font-mono text-[10px] text-white/40">
                    {run.checked_count}/{run.task_count} done · started by{' '}
                    {actorLabel(run.started_by, email, runPeople)} · {formatWhen(run.started_at)}
                  </p>
                </a>
              );
            })}
          </div>
        </section>
      )
    }
    <AdminToolsIndex client:load tools={tools} initialPins={pins} />
  </div>
</AdminLayout>
