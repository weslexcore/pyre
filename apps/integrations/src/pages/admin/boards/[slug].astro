---
// One board. AdminLayout's prefix rule lets anyone holding /admin/boards —
// which includes a single-board grantee — through to /admin/boards/*, so the
// slug is checked here as well. The API checks it again on every request;
// this is the half that keeps the page from rendering a shell for a board
// the viewer was never given.
import { BoardView } from '@/components/admin/boards/BoardView';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { canViewBoard } from '@/lib/boards/access';
import { isBoardSlug } from '@/lib/boards/types';

const { slug } = Astro.params;
const access = Astro.locals.adminAccess ?? null;
const allowed = !!slug && isBoardSlug(slug) && !!access && canViewBoard(access, slug);
---

<AdminLayout title="Board" subtitle="Move a card by changing its column; open one for everything else">
  {
    allowed && slug ? (
      <BoardView slug={slug} client:load />
    ) : (
      <p class="text-sm text-white/60">That board is not available to you.</p>
    )
  }
</AdminLayout>
