---
// The form builder for one board. A more specific route than
// /admin/boards/[slug], so it wins for /admin/boards/<slug>/form.
//
// Managers only: a form decides what a stranger can write onto a board,
// which is not a single-board grantee's call. AdminLayout's prefix rule
// lets a grantee through to /admin/boards/*, so the check is here, and the
// API makes it again on every request.
import { FormBuilder } from '@/components/admin/boards/FormBuilder';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { canManageBoards } from '@/lib/boards/access';
import { loadBoardBySlug } from '@/lib/boards/store';
import { isBoardSlug } from '@/lib/boards/types';
import { getDb } from '@/lib/db';

const { slug } = Astro.params;
const access = Astro.locals.adminAccess ?? null;
const allowed = !!slug && isBoardSlug(slug) && !!access && canManageBoards(access);

let title = 'Form';
let subtitle = '';
if (allowed && slug) {
  try {
    const db = getDb();
    const board = db ? await loadBoardBySlug(db, slug) : null;
    if (board) {
      title = `${board.name} form`;
      subtitle = `What the form asks, and who may fill it in to add a ${board.card_noun} to this board`;
    }
  } catch (error) {
    console.warn('[boards] form title lookup failed:', error);
  }
}
---

<AdminLayout title={title} subtitle={subtitle} wide>
  {
    allowed && slug ? (
      <FormBuilder slug={slug} client:load />
    ) : (
      <p class="text-sm text-white/60">The form builder is not part of a single-board grant.</p>
    )
  }
</AdminLayout>
