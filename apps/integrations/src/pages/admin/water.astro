---
// Cold-tub water testing log. Viewable by anyone granted the /admin/water
// page (admins included) — the /api/admin/water-tests route re-checks the
// session on every request; the AdminLayout gate is UX, the API gate is the
// security boundary.
import { WaterLog } from '@/components/admin/WaterLog';
import AdminLayout from '@/layouts/AdminLayout.astro';

// Lets the island show the delete button only on the viewer's own entries
// (the API re-checks ownership server-side).
const userEmail = Astro.locals.adminUser?.email ?? '';
---

<AdminLayout
  title="Cold Tub Water Log"
  subtitle="Test in order: TA → pH → free chlorine (FC) → salt. Dose in that order too; run pumps ~15 min after dosing and retest."
>
  <WaterLog client:load userEmail={userEmail} />
</AdminLayout>
