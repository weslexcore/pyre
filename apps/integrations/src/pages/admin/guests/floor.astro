---
// On the floor: who is checked in, when they came in, how much of their
// session is left, and which of the check-ins set on /admin/settings are due.
// Arrivals checked in here go through to Momence.
import { GuestFloor } from '@/components/admin/GuestFloor';
import GuestTabs from '@/components/admin/GuestTabs.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout
  title="On the Floor"
  subtitle="Who's checked in, how much of their session is left, and who's due a check-in"
>
  <GuestTabs current="/admin/guests/floor" />
  <GuestFloor client:load />
</AdminLayout>
