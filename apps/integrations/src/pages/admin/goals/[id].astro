---
// A goal's old page. Goals are read from the board that serves them now, so
// this sends the visitor there — inbox rows written before the merge still
// point here, and a bell that opens nothing is worse than a redirect.
// Whether they may open that board is the board page's decision.
import { boardsForGoal } from '@/lib/boards/store';
import { getDb } from '@/lib/db';
import { isUuid } from '@/lib/goals/validate';

const { id } = Astro.params;
let target = '/admin/boards';
if (id && isUuid(id)) {
  try {
    const db = getDb();
    const boards = db ? await boardsForGoal(db, id) : [];
    if (boards[0]) target = `/admin/boards/${boards[0].slug}`;
  } catch (error) {
    console.warn('[goals] redirect lookup failed:', error);
  }
}
return Astro.redirect(target, 302);
---
