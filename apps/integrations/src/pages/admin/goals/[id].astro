---
// A goal's old page. Goals are read from the board that serves them now, or
// from the goals overview when no board does, so this sends the visitor
// there — inbox rows written before the merge still point here, and a bell
// that opens nothing is worse than a redirect. Whether they may open that
// page is its own decision.
import { boardsForGoal } from '@/lib/boards/store';
import { getDb } from '@/lib/db';
import { goalOverviewHref } from '@/lib/goals/types';
import { isUuid } from '@/lib/goals/validate';

const { id } = Astro.params;
let target = '/admin/boards';
if (id && isUuid(id)) {
  try {
    const db = getDb();
    const boards = db ? await boardsForGoal(db, id) : [];
    target = boards[0] ? `/admin/boards/${boards[0].slug}` : goalOverviewHref(id);
  } catch (error) {
    console.warn('[goals] redirect lookup failed:', error);
  }
}
return Astro.redirect(target, 302);
---
