---
import { InventoryStock } from '@/components/admin/InventoryStock';
// Operational inventory: stock by storage area. Anyone granted
// /admin/inventory can log what they use, receive, waste, or move; the
// /api/admin/inventory* routes re-check the session on every request — the
// AdminLayout gate is UX, the API gate is the security boundary.
import InventoryTabs from '@/components/admin/InventoryTabs.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout
  title="Inventory"
  subtitle="Supplies by where they're kept. Tap an item to log what you used, received, wasted, or moved."
>
  <InventoryTabs current="/admin/inventory" />
  <InventoryStock client:load />
</AdminLayout>
