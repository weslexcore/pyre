---
import { InventoryList } from '@/components/admin/InventoryList';
// Inventory: one spreadsheet-style list of everything the studio stocks.
// Anyone granted /admin/inventory can count (set In stock); admins edit the
// rest. /api/admin/inventory re-checks the session on every request — the
// AdminLayout gate is UX, the API gate is the security boundary.
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout
  title="Inventory"
  subtitle="Everything we stock, how many we have, and when to count and re-order."
>
  <InventoryList client:load />
</AdminLayout>
