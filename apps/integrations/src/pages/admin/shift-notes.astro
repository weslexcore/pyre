---
// Shift-note log. Who may see it — admins, shift leads (implicit grant in
// lib/auth/access), and anyone granted the page — is decided by the
// middleware + AdminLayout gate; the island fetches everything it shows from
// /api/admin/shift-notes, which re-checks on every request.
import { ShiftNotes } from '@/components/admin/ShiftNotes';
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout
  title="Shift Notes"
  subtitle="How each shift went, from the person leading it — details, handoffs, and feedback"
>
  <ShiftNotes client:load />
</AdminLayout>
