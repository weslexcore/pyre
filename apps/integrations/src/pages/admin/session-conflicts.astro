---
// Special-event conflicts: the regular sessions (Open Hours, Social) sitting
// under a special event, found by the Monday cron and reviewed here. Admin
// only — cancelling sessions in Momence is not something to grant page by
// page. The redirect is UX; the API route's requireAdmin is the boundary.
import { SessionConflicts } from '@/components/admin/SessionConflicts';
import AdminLayout from '@/layouts/AdminLayout.astro';

if (!Astro.locals.adminAccess?.isAdmin) return Astro.redirect('/admin');
---

<AdminLayout
  title="Special Event Conflicts"
  subtitle="Open Hours and Social sessions sitting under a special event — review them and cancel them in Momence from here."
>
  <SessionConflicts client:load />
</AdminLayout>
