---
// People: pay, roles, and dashboard access in one list (shift preferences
// live on /admin/schedule/availability). Only for people granted this page —
// which is every grant there is, since whoever holds it sets everyone's
// access. The /api/admin/users routes re-check the grant on every request —
// this page gate is UX, the API gate is the security boundary.
import { UsersManager } from '@/components/admin/UsersManager';
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout
  title="People"
  subtitle="Pay, roles, and page access for everyone at Pyre. Emails must match the person's Momence login, since that's how they sign in. Shift preferences are on Schedule → Availability."
>
  <UsersManager client:load />
</AdminLayout>
