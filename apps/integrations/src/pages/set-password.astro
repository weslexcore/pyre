---
// Choose a password for the new (Supabase) staff login. Reached two ways:
// - the Momence cutover: just signed in through Momence, no password yet;
// - an emailed invite/reset link (mode=reset), which /api/auth/confirm has
//   already turned into a Supabase session.
// The email is never typed here — it's whichever account proved itself.
import AuthShell from '@/components/auth/AuthShell.astro';
import { AUTH_BUTTON, AUTH_INPUT, AUTH_LABEL, AUTH_LINK } from '@/components/auth/styles';
import { getAccess } from '@/lib/auth/access';
import { MIN_PASSWORD_LENGTH } from '@/lib/auth/provision';
import { safeReturnUrl, withReturnUrl } from '@/lib/auth/return-url';
import { validateSession } from '@/lib/auth/session';

const params = Astro.url.searchParams;
const returnUrl = safeReturnUrl(params.get('returnUrl'));
const typed = (params.get('typed') ?? '').trim().toLowerCase();
const errorCode = params.get('error');

const { session } = await validateSession(Astro.cookies);
if (!session.isAuthenticated || !session.user) {
  return Astro.redirect(withReturnUrl('/', returnUrl), 302);
}
const user = session.user;

// A Supabase session only lands here from an emailed link; otherwise the
// person already has a password and belongs on the dashboard.
const mode = session.source === 'supabase' ? 'reset' : 'cutover';
if (mode === 'reset' && params.get('mode') !== 'reset') {
  return Astro.redirect(returnUrl, 302);
}

const access = user.email ? await getAccess(user.email) : null;

const ERRORS: Record<string, string> = {
  too_short: `Use at least ${MIN_PASSWORD_LENGTH} characters.`,
  too_long: 'That password is too long. Use at most 72 characters.',
  mismatch: 'The passwords do not match.',
  same_password: 'Choose a password different from your current one.',
  save_failed: 'Could not save that password. Try again.',
  create_failed: 'Could not create your account. Try again, or ask an admin.',
  unavailable: 'Sign-in is not configured here. Ask an admin.',
};
const errorMessage = errorCode ? (ERRORS[errorCode] ?? 'Something went wrong. Try again.') : null;
const emailMismatch = mode === 'cutover' && typed && typed !== user.email;
---

<AuthShell title="Set your password · Pyre Admin">
  {
    !access ? (
      <>
        <h1 class="mb-4 text-2xl font-semibold">Unauthorized</h1>
        <p class="text-white/60">
          {user.email || 'This account'} does not have access to the admin tools.
        </p>
        <a href={withReturnUrl('/api/auth/logout', returnUrl)} class={AUTH_LINK}>
          Log out
        </a>
      </>
    ) : (
      <>
        <h1 class="mb-2 text-2xl font-semibold">
          {mode === 'cutover' ? 'Set a password' : 'Choose a new password'}
        </h1>
        <p class="mb-6 text-white/60">
          {mode === 'cutover'
            ? `The admin tools now have their own sign-in. Choose a password for ${user.email} — you'll use it instead of Momence from now on.`
            : `For ${user.email}.`}
        </p>
        {emailMismatch && (
          <p class="mb-4 text-sm text-white/70">
            You signed in to Momence as {user.email}, not {typed}. This password will be for{' '}
            {user.email}.
          </p>
        )}
        {errorMessage && (
          <p class="mb-4 font-mono text-xs text-[var(--pyre-red)]">{errorMessage}</p>
        )}
        <form method="post" action="/api/auth/set-password" class="space-y-4 text-left">
          <input type="hidden" name="returnUrl" value={returnUrl} />
          <input type="hidden" name="mode" value={mode} />
          <input
            type="email"
            value={user.email}
            autocomplete="username"
            class="hidden"
            aria-hidden="true"
            tabindex="-1"
            readonly
          />
          <label class="block">
            <span class={AUTH_LABEL}>New password</span>
            <input
              type="password"
              name="password"
              required
              autofocus
              minlength={MIN_PASSWORD_LENGTH}
              autocomplete="new-password"
              class={AUTH_INPUT}
            />
          </label>
          <label class="block">
            <span class={AUTH_LABEL}>Confirm password</span>
            <input
              type="password"
              name="confirm"
              required
              minlength={MIN_PASSWORD_LENGTH}
              autocomplete="new-password"
              class={AUTH_INPUT}
            />
          </label>
          <p class="text-xs text-white/40">At least {MIN_PASSWORD_LENGTH} characters.</p>
          <button type="submit" class={AUTH_BUTTON}>
            Save password
          </button>
        </form>
        <a href={withReturnUrl('/api/auth/logout', returnUrl)} class={AUTH_LINK}>
          Cancel
        </a>
      </>
    )
  }
</AuthShell>
