---
// Request an emailed set-password link (/api/auth/forgot-password). Also where
// a stale or reused link lands (/api/auth/confirm redirects here with error=).
import AuthShell from '@/components/auth/AuthShell.astro';
import { AUTH_BUTTON, AUTH_INPUT, AUTH_LABEL, AUTH_LINK } from '@/components/auth/styles';
import { safeReturnUrl, withReturnUrl } from '@/lib/auth/return-url';

const params = Astro.url.searchParams;
const returnUrl = safeReturnUrl(params.get('returnUrl'));
const email = (params.get('email') ?? '').trim().toLowerCase();
const sent = params.get('sent') === '1';
const errorCode = params.get('error');

const ERRORS: Record<string, string> = {
  invalid_email: 'Enter a valid email address.',
  invalid_link: 'That link is not valid. Request a new one below.',
  expired_link: 'That link has expired or was already used. Request a new one below.',
  unavailable: 'Sign-in is not configured here. Ask an admin.',
};
const errorMessage = errorCode ? (ERRORS[errorCode] ?? 'Something went wrong. Try again.') : null;
---

<AuthShell title="Reset password · Pyre Admin">
  {
    sent ? (
      <>
        <h1 class="mb-4 text-2xl font-semibold">Check your email</h1>
        <p class="text-white/60">
          If {email || 'that address'} has access to the admin tools, we sent it a link to set a
          new password. The link works once and expires in an hour.
        </p>
        <a href={withReturnUrl('/', returnUrl)} class={AUTH_LINK}>
          Back to sign in
        </a>
      </>
    ) : (
      <>
        <h1 class="mb-4 text-2xl font-semibold">Reset password</h1>
        <p class="mb-6 text-white/60">We'll email you a link to choose a new password.</p>
        {errorMessage && (
          <p class="mb-4 font-mono text-xs text-[var(--pyre-red)]">{errorMessage}</p>
        )}
        <form method="post" action="/api/auth/forgot-password" class="space-y-4 text-left">
          <input type="hidden" name="returnUrl" value={returnUrl} />
          <label class="block">
            <span class={AUTH_LABEL}>Email</span>
            <input
              type="email"
              name="email"
              value={email}
              required
              autofocus
              autocomplete="username"
              inputmode="email"
              class={AUTH_INPUT}
            />
          </label>
          <button type="submit" class={AUTH_BUTTON}>
            Send link
          </button>
        </form>
        <a href={withReturnUrl('/', returnUrl)} class={AUTH_LINK}>
          Back to sign in
        </a>
      </>
    )
  }
</AuthShell>
