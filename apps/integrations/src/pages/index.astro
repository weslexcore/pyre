---
// Staff sign-in for the Pyre integrations service. All /admin pages redirect
// unauthenticated visitors here; the emailed link (or the 6-digit code from
// the same email) returns them to returnUrl. Signed-in staff skip straight
// to the dashboard.
import { LoginForm } from '@/components/admin/LoginForm';
import Favicon from '@/components/Favicon.astro';
import PullToRefresh from '@/components/PullToRefresh.astro';
import { getAccess } from '@/lib/auth/access';
import { safeReturnUrl } from '@/lib/auth/login';
import { validateSession } from '@/lib/auth/session';
import '@/styles/admin.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');

// A sign-in link whose redirect was not on Supabase's allowlist lands on the
// project's Site URL — this page — with the token in the query. Hand it on.
if (Astro.url.searchParams.has('token_hash')) {
  return Astro.redirect(`/api/auth/callback?${Astro.url.searchParams.toString()}`, 302);
}

const returnUrl = safeReturnUrl(Astro.url.searchParams.get('returnUrl'));
const authError = Astro.url.searchParams.get('error');

const { session } = await validateSession(Astro.cookies);
const user = session.isAuthenticated ? session.user : null;

// Anyone with dashboard access (admin or page-granted) goes through; the
// middleware and per-route gates enforce which pages they can actually open.
if (user?.email && (await getAccess(user.email))) {
  return Astro.redirect(returnUrl, 302);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>Pyre Admin</title>
    <Favicon />
  </head>
  <body class="min-h-screen bg-[var(--pyre-black)] font-sans text-[var(--pyre-creme)] antialiased">
    <main class="mx-auto max-w-md px-4 py-16 text-center">
      {
        user ? (
          <>
            <h1 class="mb-4 text-2xl font-semibold">Unauthorized</h1>
            <p class="text-white/60">You do not have access to the admin tools.</p>
            <p class="mt-4 font-mono text-xs text-white/40">Signed in as {user.email}</p>
            <form method="post" action="/api/auth/logout" data-astro-reload class="mt-6">
              <button
                type="submit"
                class="font-mono text-xs uppercase tracking-wide text-white/60 underline hover:text-white"
              >
                Log out
              </button>
            </form>
          </>
        ) : (
          <>
            <h1 class="mb-4 text-2xl font-semibold">Pyre Admin</h1>
            <LoginForm client:load returnUrl={returnUrl} initialError={authError} />
          </>
        )
      }
    </main>
    <PullToRefresh />
  </body>
</html>
