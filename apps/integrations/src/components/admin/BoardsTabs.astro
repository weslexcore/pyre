---
// The row at the top of every cross-board page — the boards index, all
// goals, all tasks, and the calendar. On the left, view pills so any one of
// them is a click from the others; on the right, New task, New board, and
// New goal, each opening its form in a dialog over the page (CreateActions).
//
// The three cross-board views turn single-board grantees away, and boards
// and goals are made under the same manage grant, so those viewers get only
// New task: the form offers just the boards they hold.
import { CreateActions } from '@/components/admin/boards/CreateActions';
import { canManageBoards } from '@/lib/boards/access';
import { BOARDS_CALENDAR_HREF, BOARDS_HREF } from '@/lib/boards/types';
import { ALL_GOALS_HREF, ALL_TASKS_HREF } from '@/lib/goals/types';
import SubNav from './SubNav.astro';

interface Props {
  current: string;
}
const { current } = Astro.props;

const access = Astro.locals.adminAccess ?? null;
const canManage = !!access && canManageBoards(access);

const tabs = [
  { href: BOARDS_HREF, label: 'All boards' },
  { href: ALL_GOALS_HREF, label: 'All goals' },
  { href: ALL_TASKS_HREF, label: 'All tasks' },
  { href: BOARDS_CALENDAR_HREF, label: 'Calendar' },
];
---

<div class="mb-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
  {canManage ? <SubNav tabs={tabs} current={current} pill class="" /> : <span />}
  <CreateActions client:load canManage={canManage} />
</div>

