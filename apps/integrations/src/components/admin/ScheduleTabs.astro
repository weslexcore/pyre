---
// Sub-nav shared by the /admin/schedule pages. The roster itself lives on
// /admin/users (people, pay, access, founders, and who is available to
// schedule are all one list) — admin-only, so it isn't linked from here.
// Shift preferences (hours target, shifts per week) are on the Hours tab.
import { hasScheduleManage } from '@/components/admin/adminTools';
import SubNav from './SubNav.astro';

interface Props {
  current: string;
}
const { current } = Astro.props;

const access = Astro.locals.adminAccess ?? null;
const isAdmin = access?.isAdmin ?? false;
const canManage = !!access && hasScheduleManage(access);

const tabs = [
  { href: '/admin/schedule', label: 'Week' },
  { href: '/admin/schedule/calendar', label: 'Calendar' },
  { href: '/admin/schedule/hours', label: 'Hours' },
  { href: '/admin/schedule/time-off', label: 'Time Off' },
  { href: '/admin/schedule/availability', label: 'Availability' },
  // The duty list is readable by anyone on the schedule, but only worth a tab
  // for the people who assign (and edit) duties.
  ...(canManage ? [{ href: '/admin/schedule/duties', label: 'Duties' }] : []),
  // Admin-only: insights aggregates everyone's pay, and the change log names
  // who did what across the whole team.
  ...(isAdmin
    ? [
        { href: '/admin/schedule/insights', label: 'Insights' },
        { href: '/admin/schedule/changes', label: 'Changes' },
      ]
    : []),
];
---

<SubNav tabs={tabs} current={current} />
