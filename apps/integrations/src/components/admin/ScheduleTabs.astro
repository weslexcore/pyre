---
// Sub-nav shared by the /admin/schedule pages. The roster itself lives on
// /admin/users (people, access, founders, and who is available to schedule
// are all one list) — admin-only, so it isn't linked from here.
interface Props {
  current: string;
}
const { current } = Astro.props;

const isAdmin = Astro.locals.adminAccess?.isAdmin ?? false;

const tabs = [
  { href: '/admin/schedule', label: 'Week' },
  { href: '/admin/schedule/calendar', label: 'Calendar' },
  { href: '/admin/schedule/hours', label: 'Hours' },
  { href: '/admin/schedule/time-off', label: 'Time Off' },
  // Admin-only: the change log names who did what across the whole team.
  ...(isAdmin ? [{ href: '/admin/schedule/changes', label: 'Changes' }] : []),
];
---

<nav class="mb-6 flex flex-wrap gap-2">
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        class={`px-3 py-1.5 rounded border text-xs font-mono uppercase tracking-wide transition-colors ${
          current === tab.href
            ? 'border-[var(--pyre-red)] bg-[var(--pyre-red)]/15 text-[var(--pyre-creme)]'
            : 'border-white/10 bg-white/5 text-white/50 hover:border-white/30 hover:text-white'
        }`}
      >
        {tab.label}
      </a>
    ))
  }
</nav>
