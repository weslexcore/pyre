---
// Sub-nav shared by the /admin/schedule pages. The Roster tab is manage-side
// only (staff emails live there); canViewPath blocks the page itself too.
import { hasScheduleManage } from '@/components/admin/adminTools';

interface Props {
  current: string;
}
const { current } = Astro.props;

const access = Astro.locals.adminAccess ?? null;
const canManage = !!access && hasScheduleManage(access);

const tabs = [
  { href: '/admin/schedule', label: 'Week' },
  { href: '/admin/schedule/calendar', label: 'Calendar' },
  { href: '/admin/schedule/hours', label: 'Hours' },
  { href: '/admin/schedule/time-off', label: 'Time Off' },
  ...(canManage ? [{ href: '/admin/schedule/staff', label: 'Roster' }] : []),
];
---

<nav class="mb-6 flex flex-wrap gap-2">
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        class={`px-3 py-1.5 rounded border text-xs font-mono uppercase tracking-wide transition-colors ${
          current === tab.href
            ? 'border-[var(--pyre-red)] bg-[var(--pyre-red)]/15 text-[var(--pyre-creme)]'
            : 'border-white/10 bg-white/5 text-white/50 hover:border-white/30 hover:text-white'
        }`}
      >
        {tab.label}
      </a>
    ))
  }
</nav>
