---
// Sub-nav shared by the /admin/guests pages. The fields page is the managed
// half (guests:manage), so it is only linked for people who can use it; the
// page itself bounces anyone else.
import { hasGuestsManage } from '@/components/admin/adminTools';
import SubNav from './SubNav.astro';

interface Props {
  current: string;
}
const { current } = Astro.props;

const access = Astro.locals.adminAccess ?? null;
const canManage = !!access && hasGuestsManage(access);

const tabs = [
  { href: '/admin/guests', label: 'Guests' },
  { href: '/admin/guests/sessions', label: "Who's coming" },
  ...(canManage ? [{ href: '/admin/guests/fields', label: 'Fields' }] : []),
];
---

<SubNav tabs={tabs} current={current} />
