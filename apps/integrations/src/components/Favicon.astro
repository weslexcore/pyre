---
// Icons and install metadata for every page: the Pyre wave mark in brand gold.
// The SVG uses currentColor, so it is recolored here and inlined as a data
// URI (no extra request). Every PNG under public/ is rendered from the same
// SVG by scripts/render-icons.mjs: favicon.png for browsers that ignore SVG
// favicons (Safari), apple-touch-icon.png for iOS home screens, and
// public/icons/* for the web app manifest, which is what Android and desktop
// Chrome/Edge read when someone installs the admin as an app. Home-screen and
// install icons set the mark smaller and centered on brand black (iOS would
// otherwise fill a transparent icon edge to edge); the maskable icons keep it
// inside Android's central safe zone.
//
// Deployments of the staging branch swap the browser-tab favicon to brand
// sage (favicon-staging.png is the same mark recolored) so a staging tab is
// easy to tell apart from production at a glance (lib/brandMark, shared with
// the header logo). Install icons stay gold.
import pyreLogo from '@/assets/pyre_logo.svg?raw';
import { isStagingDeploy, MARK_COLOR } from '@/lib/brandMark';

const black = '#23221c'; // --pyre-black in styles/admin.css
const pngHref = isStagingDeploy ? '/favicon-staging.png' : '/favicon.png';
const svgHref = `data:image/svg+xml,${encodeURIComponent(pyreLogo.replace(/currentColor/g, MARK_COLOR))}`;
---

<link rel="icon" type="image/png" sizes="32x32" href={pngHref} />
<link rel="icon" type="image/svg+xml" href={svgHref} />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content={black} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="Pyre Admin" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
