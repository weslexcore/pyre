---
// Shared shell for every /admin page: head boilerplate, the access check,
// and the sticky header with the tool nav (mobile hamburger included).
// Unauthenticated visitors never reach this layout — src/middleware.ts
// redirects them to the login page at the site root and stores the validated
// user + their staff-row access in locals. Which pages a user may view is
// decided per user on /admin/users — admins included, every page explicit;
// the current pathname is checked here.
// The /api/admin/* routes each page calls re-check the session on every
// request (this gate is UX; the API gate is the security boundary).
import { ClientRouter } from 'astro:transitions';
import { AdminNav } from '@/components/admin/AdminNav';
import {
  canViewPath,
  SHIFT_NOTES_HREF,
  SUGGESTIONS_HREF,
  searchablePages,
  toolsForAccess,
  visibleTools,
} from '@/components/admin/adminTools';
import { CardPeek } from '@/components/admin/boards/CardPeek';
import { GlobalSearch } from '@/components/admin/GlobalSearch';
import { NotificationBell } from '@/components/admin/NotificationBell';
import { QuickShiftNote } from '@/components/admin/QuickShiftNote';
import Favicon from '@/components/Favicon.astro';
import PullToRefresh from '@/components/PullToRefresh.astro';
import PyreMark from '@/components/PyreMark.astro';
import { getToolPins } from '@/lib/admin/toolPins';
import { getUnreadCount } from '@/lib/notifications/unread';
import { getSetting } from '@/lib/settings/store';
import { getPendingSuggestionCount } from '@/lib/suggestions/unread';
import '@/styles/admin.css';

interface Props {
  title?: string;
  subtitle?: string;
  /** Widens the content column (email templates preview needs the room). */
  wide?: boolean;
  /**
   * Pins the page to the viewport height and hands the slot the remaining
   * room (a flex column, min-height 0) instead of letting the document grow —
   * for chat-style pages that scroll inside themselves and keep a composer
   * at the bottom.
   */
  fill?: boolean;
}

const { title, subtitle, wide = false, fill = false } = Astro.props;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const user = Astro.locals.adminUser ?? null;
const access = Astro.locals.adminAccess ?? null;
const allowed = !!user && !!access && canViewPath(access, Astro.url.pathname);
// Everything the shell reads is independent, so it is read at once: these
// four queries used to run one after another on every admin page, and their
// round trips added up ahead of the first byte.
const grantedTools = access ? toolsForAccess(access) : [];
const [hiddenTools, pinnedHrefs, unreadCount, pendingCount] = await Promise.all([
  access ? getSetting('navigation.hiddenTools') : Promise.resolve([] as string[]),
  // The user's pin order for the nav's Pinned group — reuse the page's fetch
  // when it already made one (the /admin index memoizes into locals).
  Astro.locals.toolPins ??
    (allowed && user?.email ? getToolPins(user.email) : Promise.resolve([] as string[])),
  // The bell's badge, painted by the server so it is right on first paint; the
  // island keeps it fresh from there. Zero when storage is down — never blocks.
  allowed && user?.email ? getUnreadCount(user.email) : Promise.resolve(0),
  // Agent suggestions waiting for a decision, beside the Suggestions entry in
  // the menu — for whoever holds that page. Zero when storage is down.
  allowed && grantedTools.some((tool) => tool.href === SUGGESTIONS_HREF)
    ? getPendingSuggestionCount()
    : Promise.resolve(0),
]);
const tools = access ? visibleTools(grantedTools, hiddenTools) : [];
// Pages the global search (cmd+K, or the magnifier in the header) can open:
// the same tools plus their sub-pages, filtered the same way.
const searchPages = access ? searchablePages(tools, access) : [];
// The header's plus button writes a shift note from any page — offered to
// whoever may open the shift-notes page (everyone on the roster, by default).
const canAddShiftNote = !!access && canViewPath(access, SHIFT_NOTES_HREF);
// The count only shows beside a Suggestions entry that is actually in the menu.
const pendingSuggestions = tools.some((tool) => tool.href === SUGGESTIONS_HREF) ? pendingCount : 0;
const widthClass = wide ? 'max-w-7xl' : 'max-w-6xl';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Pyre Admin</title>
    <Favicon />
    {/* Client-side nav between admin pages: the router swaps the document
        instead of reloading it, which keeps the loaded JS realm alive so the
        lib/client/cachedJson cache survives and pages repaint instantly. */}
    <ClientRouter />
  </head>
  <body
    class={`bg-[var(--pyre-black)] font-sans text-[var(--pyre-creme)] antialiased ${
      fill ? 'flex h-dvh flex-col overflow-hidden' : 'min-h-screen'
    }`}
  >
    {
      !allowed || !user ? (
        <main class="mx-auto max-w-md px-4 py-16 text-center">
          <h1 class="mb-4 text-2xl font-semibold">Unauthorized</h1>
          <p class="text-white/60">You do not have access to this page.</p>
          <p class="mt-4 font-mono text-xs text-white/40">
            Signed in as {user?.email || '(no email)'} (id {user?.id ?? 'unknown'})
          </p>
          <a
            href="/api/auth/logout"
            data-astro-prefetch="false"
            data-astro-reload
            class="mt-6 inline-block font-mono text-xs uppercase tracking-wide text-white/60 underline hover:text-white"
          >
            Log out
          </a>
        </main>
      ) : (
        <>
          {/* The header gets its own view-transition snapshot and no animation,
              so it holds still while the page body crossfades underneath it
              (the crossfade itself is tuned in styles/admin.css). Without a
              name it would be part of the root snapshot and fade with the
              rest of the page on every navigation. */}
          <header
            transition:name="admin-header"
            transition:animate="none"
            class="sticky top-0 z-40 shrink-0 border-b border-white/10 bg-[var(--pyre-black)]"
          >
            <div
              class={`relative mx-auto flex ${widthClass} items-center justify-between gap-4 px-4 py-3`}
            >
              <a
                href="/admin"
                data-astro-prefetch
                aria-label="Pyre Admin home"
                class="shrink-0 opacity-90 transition-opacity hover:opacity-100"
              >
                <PyreMark class="h-7" />
              </a>
              <div class="flex items-center gap-2">
                {canAddShiftNote && <QuickShiftNote client:load />}
                <GlobalSearch client:load pages={searchPages} />
                <NotificationBell client:load initialCount={unreadCount} />
                <AdminNav
                  client:load
                  currentPath={Astro.url.pathname}
                  userEmail={user.email ?? ''}
                  tools={tools}
                  pinnedHrefs={pinnedHrefs}
                  badges={{ [SUGGESTIONS_HREF]: pendingSuggestions }}
                />
              </div>
            </div>
            {/* Slow-navigation indicator along the header's bottom edge. Hidden
                until the script below marks <html> with data-admin-loading,
                which only happens when a router fetch runs past its delay. */}
            <div
              class="admin-loading-bar absolute inset-x-0 bottom-0 h-0.5 overflow-hidden"
              aria-hidden="true"
            >
            </div>
          </header>
          <main
            class={`mx-auto w-full ${widthClass} px-4 ${
              fill ? 'flex min-h-0 flex-1 flex-col pt-4 pb-3' : 'py-6'
            }`}
          >
            <div class={fill ? 'mb-3 shrink-0' : 'mb-8'}>
              <h1 class="text-2xl font-semibold">{title}</h1>
              {subtitle && <p class="mt-1 font-mono text-xs text-white/40">{subtitle}</p>}
            </div>
            {
              fill ? (
                <div class="flex min-h-0 flex-1 flex-col">
                  <slot />
                </div>
              ) : (
                <slot />
              )
            }
          </main>
          {/* A card link opens its drawer over this page, not on its board. */}
          <CardPeek client:load />
        </>
      )
    }
    <script>
      import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';

      import { warmJson } from '@/lib/client/cachedJson';
      import { holdLoadingBar } from '@/lib/client/loadingBar';
      import { isWarmableHref, jsonUrlsFor } from '@/lib/client/pageData';

      // Data warming. The ClientRouter prefetches the next *document* on
      // hover/tap; this fetches the next page's *JSON* on the same signals
      // (and again when a navigation starts, for links that got neither),
      // so the island finds its first read already in the cache and paints
      // at once. warmJson is a no-op while a request is in flight or the
      // entry is fresh, so the pointer crossing a link's children many times
      // costs a Map lookup each. The logout link is excluded by its path
      // (not under /admin) — it never gets warmed or prefetched.
      function warmLink(href: string | null | undefined) {
        if (!href) return;
        const url = isWarmableHref(href, window.location.origin);
        if (!url) return;
        for (const target of jsonUrlsFor(url.pathname, url.searchParams)) void warmJson(target);
      }
      function onIntent(event: Event) {
        const link = (event.target as Element | null)?.closest?.('a[href]');
        if (link && !link.hasAttribute('data-astro-reload')) {
          warmLink(link.getAttribute('href'));
        }
      }
      document.addEventListener('pointerover', onIntent, { passive: true });
      document.addEventListener('touchstart', onIntent, { passive: true });
      document.addEventListener('focusin', onIntent);

      // Slow-navigation indicator for the ClientRouter. The router hands us
      // the function that fetches the next document (event.loader); wrapping
      // it holds the loading bar for as long as the fetch runs. The bar only
      // shows once a hold has outlasted its delay, so prefetched links never
      // flash it (lib/client/loadingBar). Runs once per JS realm: the router
      // keeps this module loaded across navigations, so the listener is
      // never registered twice.
      //
      // A navigation the router abandons (the user clicked again mid-load)
      // settles on its own; each wrapped loader releases only its own hold.
      document.addEventListener('astro:before-preparation', (event: TransitionBeforePreparationEvent) => {
        // The data request goes out beside the document request, not after it.
        warmLink(event.to.href);
        const load = event.loader;
        event.loader = async () => {
          const release = holdLoadingBar();
          try {
            await load();
          } finally {
            release();
          }
        };
      });
    </script>
    <PullToRefresh />
  </body>
</html>
