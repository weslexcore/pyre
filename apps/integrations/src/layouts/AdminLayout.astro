---
// Shared shell for every /admin page: head boilerplate, the access check,
// and the sticky header with the tool nav (mobile hamburger included).
// Unauthenticated visitors never reach this layout — src/middleware.ts
// redirects them to the login page at the site root and stores the validated
// user + their staff-row access in locals. Which pages a user may view
// is decided per user on /admin/users; the current pathname is checked here.
// The /api/admin/* routes each page calls re-check the session on every
// request (this gate is UX; the API gate is the security boundary).
import { ClientRouter } from 'astro:transitions';
import { AdminNav } from '@/components/admin/AdminNav';
import { canViewPath, toolsForAccess } from '@/components/admin/adminTools';
import { getToolPins } from '@/lib/admin/toolPins';
import '@/styles/admin.css';

interface Props {
  title: string;
  subtitle?: string;
  /** Widens the content column (email templates preview needs the room). */
  wide?: boolean;
  /**
   * Pins the page to the viewport height and hands the slot the remaining
   * room (a flex column, min-height 0) instead of letting the document grow —
   * for chat-style pages that scroll inside themselves and keep a composer
   * at the bottom.
   */
  fill?: boolean;
}

const { title, subtitle, wide = false, fill = false } = Astro.props;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const user = Astro.locals.adminUser ?? null;
const access = Astro.locals.adminAccess ?? null;
const allowed = !!user && !!access && canViewPath(access, Astro.url.pathname);
const tools = access ? toolsForAccess(access) : [];
// The user's pin order for the nav's Pinned group — reuse the page's fetch
// when it already made one (the /admin index memoizes into locals).
const pinnedHrefs =
  Astro.locals.toolPins ?? (allowed && user?.email ? await getToolPins(user.email) : []);
const widthClass = wide ? 'max-w-7xl' : 'max-w-6xl';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Pyre Admin</title>
    {/* Client-side nav between admin pages: the router swaps the document
        instead of reloading it, which keeps the loaded JS realm alive so the
        lib/client/cachedJson cache survives and pages repaint instantly. */}
    <ClientRouter />
  </head>
  <body
    class={`bg-[var(--pyre-black)] font-sans text-[var(--pyre-creme)] antialiased ${
      fill ? 'flex h-dvh flex-col overflow-hidden' : 'min-h-screen'
    }`}
  >
    {
      !allowed || !user ? (
        <main class="mx-auto max-w-md px-4 py-16 text-center">
          <h1 class="mb-4 text-2xl font-semibold">Unauthorized</h1>
          <p class="text-white/60">You do not have access to this page.</p>
          <p class="mt-4 font-mono text-xs text-white/40">
            Signed in as {user?.email || '(no email)'} (id {user?.id ?? 'unknown'})
          </p>
          <a
            href="/api/auth/logout"
            data-astro-prefetch="false"
            data-astro-reload
            class="mt-6 inline-block font-mono text-xs uppercase tracking-wide text-white/60 underline hover:text-white"
          >
            Log out
          </a>
        </main>
      ) : (
        <>
          <header class="sticky top-0 z-40 shrink-0 border-b border-white/10 bg-[var(--pyre-black)]">
            <div
              class={`relative mx-auto flex ${widthClass} items-center justify-between gap-4 px-4 py-3`}
            >
              <a
                href="/admin"
                data-astro-prefetch
                class="shrink-0 font-mono text-sm font-bold uppercase tracking-wide text-[var(--pyre-creme)] hover:text-white"
              >
                Pyre Admin
              </a>
              <AdminNav
                client:load
                currentPath={Astro.url.pathname}
                userEmail={user.email ?? ''}
                tools={tools}
                pinnedHrefs={pinnedHrefs}
              />
            </div>
          </header>
          <main
            class={`mx-auto w-full ${widthClass} px-4 ${
              fill ? 'flex min-h-0 flex-1 flex-col pt-4 pb-3' : 'py-6'
            }`}
          >
            <div class={fill ? 'mb-3 shrink-0' : 'mb-8'}>
              <h1 class="text-2xl font-semibold">{title}</h1>
              {subtitle && <p class="mt-1 font-mono text-xs text-white/40">{subtitle}</p>}
            </div>
            {
              fill ? (
                <div class="flex min-h-0 flex-1 flex-col">
                  <slot />
                </div>
              ) : (
                <slot />
              )
            }
          </main>
        </>
      )
    }
  </body>
</html>
