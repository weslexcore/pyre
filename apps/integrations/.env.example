# Integrations Service Environment Variables
# Dedicated backend: Momence webhook receiver + transactional email (Resend).

# --- Momence webhook verification ---
MOMENCE_WEBHOOK_SECRET=your_webhook_secret
MOMENCE_WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret
MOMENCE_BACKFILL_SECRET=your_backfill_bearer_secret

# --- Momence host API auth (password / refresh grant) ---
MOMENCE_HOST_EMAIL=your_host_email
MOMENCE_HOST_PASSWORD=your_host_password
MOMENCE_OAUTH_CLIENT_ID=your_oauth_client_id
MOMENCE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# --- Momence v1 Events API (used to resolve a session's tags / type) ---
MOMENCE_HOST_ID=your_host_id
MOMENCE_API_TOKEN=your_api_token

# --- Mailchimp (member/address sync) ---
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_AUDIENCE_ID=your_audience_id

# --- Upstash Redis (MUST be the SAME instance as landing-page so the admin
#     webhook-logs dashboard keeps reading these traces) ---
KV_REST_API_URL=your_upstash_rest_url
KV_REST_API_TOKEN=your_upstash_rest_token

# --- Resend (transactional email) ---
RESEND_API_KEY=your_resend_api_key
# Verified sender (domain must be verified in Resend)
RESEND_FROM="Pyre <hello@pyresauna.com>"

# --- Dev-mode email gate ---
# When EMAIL_DEV_MODE=true, emails are ONLY sent to addresses in the whitelist;
# everything else is suppressed (and traced). Leave unset/false in production.
EMAIL_DEV_WHITELIST=you@example.com,teammate@example.com
EMAIL_LIST_TEMPLATES=

# --- Public site URL of the landing site ---
# Used for links rendered into emails, and by the admin tools (short-link
# origins, event links, blog-posts/events feeds).
PUBLIC_SITE_URL=https://pyresauna.com

# --- Admin dashboard ---
# Comma-separated email allowlist (same contract as the landing page).
ADMIN_EMAILS=you@example.com

# --- PostHog querying for the campaign-performance admin tool ---
# Personal API key with the Query Read scope (the phc_ capture token cannot run
# queries) plus the numeric project id.
POSTHOG_PERSONAL_API_KEY=your_personal_api_key
POSTHOG_PROJECT_ID=your_numeric_project_id

# --- pyre-agents (Eve staff-scheduling drafter) ---
# Deployment URL + the bearer its channel auth expects on /eve/v1/session.
# Locally this is whatever port `yarn workspace pyre-agents dev` reports.
AGENTS_BASE_URL=http://localhost:PORT
EVE_CHANNEL_SECRET=your_eve_channel_secret
# Only when AGENTS_BASE_URL is a protected preview/staging deployment: the
# pyre-agents Protection Bypass for Automation secret (Vercel project →
# Settings → Deployment Protection). Leave unset locally and in production.
AGENTS_PROTECTION_BYPASS=
