# Meta / Instagram Graph API
META_APP_SECRET=
META_VERIFY_TOKEN=
IG_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Supabase — server-only. Do NOT prefix with NEXT_PUBLIC_ (would leak to the browser).
# URL: Supabase dashboard → Settings → API → "Project URL"
# Key: Supabase dashboard → Settings → API → "Service role secret" (the long eyJ... JWT).
#      Must be the service_role key, NOT the publishable/anon key — RLS blocks anon
#      from reading instagram_rules / writing instagram_events.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
