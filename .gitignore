# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Ignore ALL node_modules directories everywhere
node_modules/
**/node_modules/

# dependencies
/node_modules
node_modules/**
**/node_modules/**
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
*/.next/
apps/data-dashboard/.next/

# production
/build

# misc
.DS_Store
*.pem

**/.playwright-mcp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
**/.turbo/*

.yarn/install-state.gz

apps/supabase/.temp/**
apps/supabase/.branches

# design-sync (staged scripts, build output, machine state)
.ds-sync/
ds-bundle/
.design-sync/sb-reference/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
