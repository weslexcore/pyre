{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": true
  },
  "globalEnv": [
    "NEXT_PUBLIC_*",
    "PUBLIC_*",
    "VERCEL_*",
    "ENABLE_EXPERIMENTAL_COREPACK",
    "MOMENCE_*",
    "MAILCHIMP_*",
    "CLOUDFLARE_*",
    "ADMIN_EMAILS",
    "KV_*",
    "POSTHOG_*",
    "REDIS_URL",
    "RESEND_*",
    "EMAIL_*",
    "SUPABASE_*",
    "CRON_SECRET",
    "AGENT_API_SECRET",
    "AGENTS_*",
    "EVE_CHANNEL_SECRET",
    "AI_GATEWAY_*",
    "INTEGRATIONS_BASE_URL",
    "UNSUBSCRIBE_SECRET",
    "PARTNER_*",
    "REFERRAL_*",
    "STAFF_EMAILS",
    "SCHEDULE_LINK_SECRET",
    "GOOGLE_REVIEW_URL",
    "JOURNEY_FAST_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/booking-system/.env*",
        "apps/landing-page/.env*",
        "apps/data-dashboard/.env*",
        "apps/automations/.env*",
        "apps/integrations/.env*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".astro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/booking-system/.env*",
        "apps/landing-page/.env*",
        "apps/data-dashboard/.env*",
        "apps/automations/.env*",
        "apps/integrations/.env*"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^build"]
    },
    "format": {},
    "check": {
      "dependsOn": ["^build"]
    },
    "check:fix": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
